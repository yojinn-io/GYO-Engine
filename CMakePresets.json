{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 30,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "BUILD_TESTING": "ON",
        "GYO_APPS": "AUTO"
      }
    },
    {
      "name": "dev",
      "displayName": "CSV-selected applications and UI editor",
      "inherits": "base",
      "cacheVariables": {
        "GYO_BUILD_UI_EDITOR": "ON",
        "GYO_RENDER_DEVICE": "AUTO",
        "GYO_GPU_DRIVER": "AUTO",
        "GYO_SHADER_BUNDLE": "AUTO"
      }
    },
    {
      "name": "core",
      "displayName": "Backend-neutral modules and tests",
      "inherits": "base",
      "cacheVariables": {
        "GYO_BUILD_UI_EDITOR": "OFF",
        "GYO_BUILD_SDL_GPU_BACKEND": "OFF",
        "GYO_BUILD_SDL_IMAGE_LOADER": "OFF",
        "GYO_BUILD_SDL_TTF_ADAPTER": "OFF",
        "GYO_BUILD_UFBX_LOADER": "OFF",
        "GYO_RENDER_DEVICE": "NONE",
        "GYO_APPS": ""
      }
    },
    {
      "name": "ci-windows",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl"
      }
    },
    {
      "name": "ci-linux",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-14",
        "CMAKE_CXX_COMPILER": "g++-14"
      }
    },
    {
      "name": "ci-macos",
      "inherits": "dev",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Darwin"
      },
      "cacheVariables": {
        "CMAKE_C_COMPILER": "/usr/bin/clang",
        "CMAKE_CXX_COMPILER": "/usr/bin/clang++",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "CMAKE_OSX_DEPLOYMENT_TARGET": "13.3"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev",
      "configurePreset": "dev"
    },
    {
      "name": "core",
      "configurePreset": "core"
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux"
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos"
    }
  ],
  "testPresets": [
    {
      "name": "dev",
      "configurePreset": "dev",
      "output": {
        "outputOnFailure": true
      },
      "filter": {
        "include": {
          "label": "cpu|shader"
        }
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "core",
      "configurePreset": "core",
      "output": {
        "outputOnFailure": true
      },
      "execution": {
        "noTestsAction": "error"
      }
    },
    {
      "name": "ci-windows",
      "configurePreset": "ci-windows",
      "inherits": "dev"
    },
    {
      "name": "ci-linux",
      "configurePreset": "ci-linux",
      "inherits": "dev"
    },
    {
      "name": "ci-macos",
      "configurePreset": "ci-macos",
      "inherits": "dev"
    }
  ]
}
