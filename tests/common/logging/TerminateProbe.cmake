# Runs gyo_logging_terminate_probe in one mode and checks that the process aborted and that the JSON lines
# file holds exactly one Fatal record of category "terminate" with the expected text (LG-2). Usage:
#   cmake -DPROBE=<path> -DMODE=<std|other|none> [-DFILE=<path>] -P TerminateProbe.cmake
#   cmake -DMODE=<std|other|none> -P TerminateProbe.cmake -- <probe>
# The second form is the mutation runner's (its "{exe:NAME}" stands alone as an argument). FILE defaults to
# terminate-<MODE>.jsonl next to the probe.
if(NOT PROBE AND CMAKE_ARGC GREATER 0)
    math(EXPR last "${CMAKE_ARGC} - 1")
    set(PROBE "${CMAKE_ARGV${last}}")
endif()
if(NOT PROBE OR NOT MODE)
    message(FATAL_ERROR "PROBE and MODE are required")
endif()
if(NOT FILE)
    get_filename_component(probeDir "${PROBE}" DIRECTORY)
    set(FILE "${probeDir}/terminate-${MODE}.jsonl")
endif()
if(MODE STREQUAL "std")
    set(expected "terminate probe: a std::exception")
elseif(MODE STREQUAL "other")
    set(expected "an exception that is not a std::exception")
elseif(MODE STREQUAL "none")
    set(expected "std::terminate was called with no exception in flight")
else()
    message(FATAL_ERROR "unknown MODE ${MODE}")
endif()

file(REMOVE "${FILE}")
execute_process(COMMAND "${PROBE}" "${FILE}" "${MODE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
string(FIND "${error}" "GYO probe: setup failed" setupFailed)
if(result STREQUAL "0" OR NOT setupFailed EQUAL -1)
    message(FATAL_ERROR "probe (${MODE}) did not reach std::terminate (exit ${result}); stderr:\n${error}")
endif()
if(NOT EXISTS "${FILE}")
    message(FATAL_ERROR "probe (${MODE}) left no file")
endif()

file(STRINGS "${FILE}" lines)
# Counted apart, so that each way of being wrong has a message of its own:
# fatal = fatal lines, category = of them with category terminate, text = of those with the expected text.
set(fatal 0)
set(category 0)
set(text 0)
foreach(line IN LISTS lines)
    string(FIND "${line}" "\"level\":\"fatal\"" isFatal)
    if(isFatal EQUAL -1)
        continue()
    endif()
    math(EXPR fatal "${fatal} + 1")
    string(FIND "${line}" "\"category\":\"terminate\"" isTerminate)
    if(isTerminate EQUAL -1)
        continue()
    endif()
    math(EXPR category "${category} + 1")
    string(FIND "${line}" "\"text\":\"${expected}\"" hasText)
    if(NOT hasText EQUAL -1)
        math(EXPR text "${text} + 1")
    endif()
endforeach()
if(NOT fatal EQUAL 1)
    message(FATAL_ERROR "GYO_LOGGING_TERMINATE_RECORD: probe (${MODE}) fatal=${fatal} (expected 1); file:\n${lines}\nstderr:\n${error}")
endif()
if(NOT category EQUAL 1)
    message(FATAL_ERROR "GYO_LOGGING_TERMINATE_CATEGORY: probe (${MODE}) the fatal line is not of category terminate; file:\n${lines}")
endif()
if(NOT text EQUAL 1)
    message(FATAL_ERROR "GYO_LOGGING_TERMINATE_TEXT: probe (${MODE}) the terminate line lacks \"${expected}\"; file:\n${lines}")
endif()
# The fatal path's own console line, "[terminate] fatal: <text>" (the C++ runtime may print what() too).
string(FIND "${error}" "[terminate] fatal: ${expected}" onConsole)
if(onConsole EQUAL -1)
    message(FATAL_ERROR "GYO_LOGGING_TERMINATE_CONSOLE: probe (${MODE}) stderr lacks the fatal path's line:\n${error}")
endif()
string(FIND "${error}" "GYO probe: the earlier terminate handler ran" chained)
if(chained EQUAL -1)
    message(FATAL_ERROR "GYO_LOGGING_TERMINATE_CHAINED: probe (${MODE}) did not go on to the earlier handler:\n${error}")
endif()
message(STATUS "probe (${MODE}) wrote one terminate record and aborted (result: ${result})")
