# Runs gyo_logging_console_probe in one mode and checks what it wrote on standard error (LG-2, LG-8). Usage:
#   cmake -DMODE=<fatal|nologger|twice> -P ConsoleProbe.cmake -- <probe>
if(CMAKE_ARGC GREATER 0)
    math(EXPR last "${CMAKE_ARGC} - 1")
    set(PROBE "${CMAKE_ARGV${last}}")
endif()
if(NOT PROBE OR NOT MODE)
    message(FATAL_ERROR "PROBE and MODE are required")
endif()
execute_process(COMMAND "${PROBE}" "${MODE}" RESULT_VARIABLE result OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT result STREQUAL "0")
    message(FATAL_ERROR "probe (${MODE}) failed (exit ${result}); stderr:\n${error}")
endif()

function(count_of text needle out)
    set(count 0)
    set(rest "${text}")
    while(TRUE)
        string(FIND "${rest}" "${needle}" at)
        if(at EQUAL -1)
            break()
        endif()
        math(EXPR count "${count} + 1")
        string(LENGTH "${needle}" length)
        math(EXPR at "${at} + ${length}")
        string(SUBSTRING "${rest}" ${at} -1 rest)
    endwhile()
    set(${out} ${count} PARENT_SCOPE)
endfunction()

if(MODE STREQUAL "fatal")
    count_of("${error}" "outer-line" outer)
    count_of("${error}" "inner-line" inner)
    if(outer EQUAL 0)
        message(FATAL_ERROR "GYO_LOGGING_CONSOLE_FATAL: the fatal path wrote no line on standard error:\n${error}")
    endif()
    if(inner EQUAL 0)
        message(FATAL_ERROR "GYO_LOGGING_CONSOLE_REENTERED: a re-entered fatal path wrote nothing on standard error:\n${error}")
    endif()
elseif(MODE STREQUAL "nologger")
    count_of("${error}" "no-logger-line" lines)
    if(NOT lines EQUAL 1)
        message(FATAL_ERROR "GYO_LOGGING_CONSOLE_NOLOGGER: with no Logger the record is not one line on standard error (${lines}):\n${error}")
    endif()
elseif(MODE STREQUAL "twice")
    count_of("${error}" "once-only" lines)
    if(NOT lines EQUAL 1)
        message(FATAL_ERROR "GYO_LOGGING_CONSOLE_TWICE: the fatal line is on standard error ${lines} times, not once:\n${error}")
    endif()
else()
    message(FATAL_ERROR "unknown MODE ${MODE}")
endif()
message(STATUS "probe (${MODE}) wrote standard error as expected")
