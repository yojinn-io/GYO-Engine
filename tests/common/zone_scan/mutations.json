{
  "version": 1,
  "description": "Declared mutants of the zone-C scanner (judgement 2 of j17-scanner.zh-Hant.md): at least one per rule ZS1..ZS7, four for the masking, one for the list version check, plus header expansion, header-name case and list validation. A mutant is killed only when the self-test fails with the expected test name (run_mutations.py).",
  "mutants": [
    {
      "id": "zs1-chrono-removed",
      "file": "zone_scan_rules.json",
      "find": "    \"chrono\",\n",
      "replace": "",
      "expect": "test_zs1_banned_headers_angle_form"
    },
    {
      "id": "zs1-prefix-check-removed",
      "file": "zone_scan.py",
      "find": "return lowered in self.zs1_headers or lowered.startswith(self.zs1_prefixes)",
      "replace": "return lowered in self.zs1_headers",
      "expect": "test_zs1_banned_headers_angle_form"
    },
    {
      "id": "zs2-static-const-check-removed",
      "file": "zone_scan.py",
      "find": "    if is_immutable(declaration):\n        return False\n    inside,",
      "replace": "    if False:\n        return False\n    inside,",
      "expect": "test_negative_static_constexpr"
    },
    {
      "id": "zs2-thread-local-dropped",
      "file": "zone_scan.py",
      "find": "STATIC = re.compile(r\"\\b(?:static|thread_local)\\b\")",
      "replace": "STATIC = re.compile(r\"\\b(?:static)\\b\")",
      "expect": "test_zs2_static_in_function_forms"
    },
    {
      "id": "zs2-namespace-variable-dropped",
      "file": "zone_scan.py",
      "find": "    return \"variable\", squash(raw_text)\n\n\ndef declarators_only",
      "replace": "    return \"other\", None\n\n\ndef declarators_only",
      "expect": "test_positive_anonymous_namespace_counter"
    },
    {
      "id": "zs3-imgui-removed",
      "file": "zone_scan_rules.json",
      "find": "      \"\\\\bImGui::\\\\w+\",\n",
      "replace": "",
      "expect": "test_positive_imgui_getio"
    },
    {
      "id": "zs4-time-now-removed",
      "file": "zone_scan_rules.json",
      "find": "      \"\\\\bTime::Now(?:Ns)?\\\\b\",\n",
      "replace": "",
      "expect": "test_positive_time_now"
    },
    {
      "id": "zs5-this-capture-dropped",
      "file": "zone_scan.py",
      "find": "\\s*\\[(?:this|=|&)\")",
      "replace": "\\s*\\[(?:=|&)\")",
      "expect": "test_positive_this_lambda_into_member_is_a_candidate"
    },
    {
      "id": "zs6-random-device-removed",
      "file": "zone_scan_rules.json",
      "find": "      \"\\\\brandom_device\\\\b\",\n",
      "replace": "",
      "expect": "test_positive_random_device"
    },
    {
      "id": "zs7-std-hash-removed",
      "file": "zone_scan_rules.json",
      "find": "      \"\\\\bstd::hash\\\\b\",\n",
      "replace": "",
      "expect": "test_positive_std_hash"
    },
    {
      "id": "mask-line-comment-kept",
      "file": "zone_scan.py",
      "find": "        if text.startswith(\"//\", i):",
      "replace": "        if False and text.startswith(\"//\", i):",
      "expect": "test_negative_imgui_in_comment"
    },
    {
      "id": "mask-block-comment-kept",
      "file": "zone_scan.py",
      "find": "        elif text.startswith(\"/*\", i):",
      "replace": "        elif False and text.startswith(\"/*\", i):",
      "expect": "test_block_comment_and_raw_string_are_not_code"
    },
    {
      "id": "mask-string-literal-kept",
      "file": "zone_scan.py",
      "find": "        elif (c in \"\\\"'\" and not (c == \"'\" and identifier_before(text, i))) or \\\n",
      "replace": "        elif False or \\\n",
      "expect": "test_negative_chrono_in_string"
    },
    {
      "id": "list-version-2-accepted",
      "file": "zone_scan.py",
      "find": "SUPPORTED_VERSIONS = (1,)",
      "replace": "SUPPORTED_VERSIONS = (1, 2)",
      "expect": "test_unknown_version_is_refused_with_the_contract_message"
    },
    {
      "id": "expansion-leaves-owner",
      "file": "zone_scan.py",
      "find": "        if value is None or not (value == owner_root or value.startswith(owner_root + \"/\")):\n            continue\n",
      "replace": "        if value is None:\n            continue\n",
      "expect": "test_resolution_never_leaves_owner_root"
    },
    {
      "id": "list-sort-check-removed",
      "file": "zone_scan.py",
      "find": "    if files != sorted(files):\n        errors.append(\"list: files must be sorted (byte order)\")\n",
      "replace": "",
      "expect": "test_path_rules_are_enforced"
    },
    {
      "id": "mask-raw-string-prefix-dropped",
      "file": "zone_scan.py",
      "find": "RAW_STRING_START = re.compile(r'(?:u8|u|U|L)?R\"')",
      "replace": "RAW_STRING_START = re.compile(r'R\"')",
      "expect": "test_prefixed_raw_strings_and_literals_are_masked"
    },
    {
      "id": "zs1-case-sensitive-header",
      "file": "zone_scan.py",
      "find": "        lowered = target.lower()  # include names are case-insensitive on Windows (<Windows.h>)",
      "replace": "        lowered = target",
      "expect": "test_zs1_header_names_are_case_insensitive_and_sdl_satellites_count"
    }
  ]
}
