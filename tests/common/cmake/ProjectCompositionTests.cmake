run(TRUE "" "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -DTEST_OUTPUT_COLLISION=OFF -DGYO_TOOLS=canvas)
run(TRUE "" "${CMAKE_COMMAND}" --build "${binary}" --config Debug)
run(TRUE "" "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -DGYO_TOOLS=)
run(TRUE "" "${CMAKE_COMMAND}" --build "${binary}" --config Debug)
