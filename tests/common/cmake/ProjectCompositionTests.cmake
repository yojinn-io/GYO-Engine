file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/selection.txt" "${GYO_ACTIVE_GAMES}")
file(WRITE "${CMAKE_CURRENT_BINARY_DIR}/requirements.txt" "${GYO_REQUESTED_COMPONENTS}")
foreach(GYO_CURRENT_GAME IN LISTS GYO_ACTIVE_GAMES)
    add_subdirectory("games/${GYO_CURRENT_GAME}")
endforeach()
if(TEST_MIXED_GAME_CONFIG)
    add_executable(mixed_config games/first/main.cpp)
    gyo_use_game_config(mixed_config first)
    gyo_use_game_config(mixed_config second)
endif()
foreach(GYO_CURRENT_TOOL IN LISTS GYO_ACTIVE_TOOLS)
    get_property(GYO_TOOL_VARIANT GLOBAL PROPERTY GYO_TOOL_${GYO_CURRENT_TOOL}_VARIANT)
    add_subdirectory("tools/${GYO_CURRENT_TOOL}")
endforeach()
gyo_finalize_product_packages()
]=])
# The display name carries a quote: the generated header must escape it.
set(project_json "{\"version\":1,\"display_name\":\"Fixture \\\"game\\\"\",\"components\":[]}\n")
set(game_cmake [=[
file(APPEND "${PROJECT_BINARY_DIR}/configured.txt" "${GYO_CURRENT_GAME}\n")
gyo_game_project()
gyo_game_add_library(domain OUT_TARGET domain SOURCES domain.cpp)
gyo_game_add_executable(main MAIN OUT_TARGET game SOURCES main.cpp LIBRARIES ${domain})
gyo_get_game_target("${GYO_CURRENT_GAME}" domain lookup)
if(NOT lookup STREQUAL domain)
    message(FATAL_ERROR "Independent support could not locate the game domain")
endif()
get_target_property(includes ${domain} INTERFACE_INCLUDE_DIRECTORIES)
if("${GYO_GAME_GENERATED_INCLUDE_DIR}" IN_LIST includes)
    message(FATAL_ERROR "Generated game identity leaked through public includes")
endif()
file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/${GYO_CURRENT_GAME}-$<CONFIG>.txt" CONTENT "$<TARGET_FILE:${game}>")
]=])
foreach(game first second)
    file(WRITE "${source}/games/${game}/project.json" "${project_json}")
    file(WRITE "${source}/games/${game}/CMakeLists.txt" "${game_cmake}")
    file(WRITE "${source}/games/${game}/domain.cpp"
        "#include <gyo/GameConfig.hpp>\nconst char* identity() { return GYO_GAME_ID; }\n")
    file(WRITE "${source}/games/${game}/main.cpp"
        "#include <gyo/GameConfig.hpp>\n#include <iostream>\nconst char* identity();\nint main() { std::cout << '[' << identity() << '|' << GYO_GAME_DISPLAY_NAME << '|' << GYO_GAME_ASSETS << '|' << GYO_GAME_CONTENT_MANIFEST << ']'; }\n")
endforeach()

set(configure_args "-DGYO_TEST_REPOSITORY=${repository}" -DCMAKE_BUILD_TYPE=Debug)
foreach(pair GENERATOR MAKE_PROGRAM PLATFORM CXX_COMPILER)
    if(${pair})
        if(pair STREQUAL "GENERATOR")
            list(APPEND configure_args -G "${GENERATOR}")
        elseif(pair STREQUAL "PLATFORM")
            list(APPEND configure_args -A "${PLATFORM}")
        elseif(pair STREQUAL "MAKE_PROGRAM")
            list(APPEND configure_args "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
        else()
            list(APPEND configure_args "-DCMAKE_CXX_COMPILER=${CXX_COMPILER}")
        endif()
    endif()
endforeach()

function(run success fragment)
    execute_process(COMMAND ${ARGN} RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 180)
    if(success AND NOT result EQUAL 0)
        message(FATAL_ERROR "Fixture command failed (${result}): ${ARGN}\n${stdout}\n${stderr}")
    elseif(NOT success AND result EQUAL 0)
        message(FATAL_ERROR "Invalid fixture unexpectedly succeeded: ${ARGN}")
    endif()
    if(NOT fragment STREQUAL "")
        string(FIND "${stdout}\n${stderr}" "${fragment}" position)
        if(position LESS 0)
            message(FATAL_ERROR "Expected '${fragment}': ${stdout}\n${stderr}")
        endif()
    endif()
endfunction()

run(TRUE "" "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" ${configure_args} -DGYO_GAMES=AUTO -DGYO_TOOLS=)
file(READ "${binary}/configured.txt" configured)
if(NOT configured STREQUAL "first\nsecond\n")
    message(FATAL_ERROR "Game CMake ran more than once or selected an unregistered directory: ${configured}")
endif()
run(TRUE "" "${CMAKE_COMMAND}" --build "${binary}" --config Debug --parallel 2)
foreach(game first second)
    file(READ "${binary}/${game}-Debug.txt" executable)
    # Every identity macro, bracketed so a prefix or suffix on any value is seen.
    run(TRUE "[${game}|Fixture \"game\"|assets/${game}|assets/${game}/content.json]" "${executable}")
    set(stage "${work}/stage-${game}")
    run(TRUE "" "${CMAKE_COMMAND}" --install "${binary}" --config Debug --component "${game}" --prefix "${stage}")
    file(READ "${stage}/share/gyo/products/${game}/manifest.json" manifest)
    string(JSON version GET "${manifest}" schema_version)
    string(JSON identity GET "${manifest}" product)
    string(JSON checks LENGTH "${manifest}" checks)
    if(NOT version EQUAL 4 OR NOT identity STREQUAL game OR NOT checks EQUAL 0)
        message(FATAL_ERROR "Copied game acquired the wrong package contract: ${manifest}")
    endif()
    file(GLOB installed "${stage}/bin/*")
    list(LENGTH installed count)
    if(NOT count EQUAL 1)
        message(FATAL_ERROR "Game package includes another product or support code: ${installed}")
    endif()
endforeach()

# A compilation error in any selected game fails the complete graph. The build
# starts clean: whether an incremental build sees a source rewritten within the
# same second depends on the generator's timestamp resolution (GNU Make 3.81
# compares whole seconds), which is not what this case is about.
file(READ "${source}/games/second/main.cpp" original_main)
file(WRITE "${source}/games/second/main.cpp" "#error selected game compilation failure\n")
run(FALSE "selected game compilation failure" "${CMAKE_COMMAND}" --build "${binary}" --config Debug --clean-first)
file(WRITE "${source}/games/second/main.cpp" "${original_main}")

# CSV edits regenerate selection without directory discovery or stale targets.
file(WRITE "${registry}" "${header}first,,,0,1,1,1\nsecond,,,1,1,1,1\n")
run(TRUE "" "${CMAKE_COMMAND}" --build "${binary}" --config Debug)
file(READ "${binary}/selection.txt" selected)
if(NOT selected STREQUAL second)
    message(FATAL_ERROR "CSV-only edit did not update selection: ${selected}")
endif()
run(FALSE "" "${CMAKE_COMMAND}" --build "${binary}" --config Debug --target gyo_first)
run(FALSE "disabled" "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -DGYO_GAMES=first)

# Invalid metadata is rejected before a game executes arbitrary CMake.
file(WRITE "${source}/games/second/project.json" "{\"version\":1,\"components\":[\"UNKNOWN\"]}")
run(FALSE "Unknown GYO component" "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -DGYO_GAMES=second)
file(WRITE "${source}/games/second/project.json" "${project_json}")

# Two unrelated tools compose without game sources or concrete central branches.
set(tool_header "name,description,version,enabled,default,release,windows,linux,macos\n")
file(WRITE "${source}/config/tools.csv" "${tool_header}canvas,,,1,1,1,1,1,1\npacker,,,1,1,1,1,1,1\n")
foreach(tool canvas packer)
    file(MAKE_DIRECTORY "${source}/tools/${tool}" "${source}/build/acceptance/${tool}")
    file(WRITE "${source}/tools/${tool}/project.json" [=[
{"version":2,"default_variant":"normal","requires_games":{},"variants":{"normal":{"components":[],"packageable":true}}}
]=])
    file(WRITE "${source}/tools/${tool}/main.cpp" "int main() { return 0; }\n")
    file(WRITE "${source}/tools/${tool}/CMakeLists.txt" [=[
add_executable(${GYO_CURRENT_TOOL} main.cpp)
if(NOT TEST_UNREGISTERED_TOOL)
    gyo_tool_install_target(TARGET ${GYO_CURRENT_TOOL} ROLE main)
endif()
if(TEST_DUPLICATE_ROLE)
    gyo_tool_install_target(TARGET ${GYO_CURRENT_TOOL} ROLE main)
endif()
if(TEST_OUTPUT_COLLISION)
    set_target_properties(${GYO_CURRENT_TOOL} PROPERTIES OUTPUT_NAME shared-output)
endif()
]=])
    file(WRITE "${source}/build/acceptance/${tool}/checks.json" [=[
{"version":1,"checks":[{"name":"startup","command":["@EXECUTABLE:main@"],"environment":[],"profiles":["quick","release"],"platforms":["windows-x64","linux-x64","macos-arm64","macos-x64"],"gpu":false,"timeout":10}]}
]=])
endforeach()
# A game config is private and cannot be mixed with another game on one target.
file(WRITE "${registry}" "${header}first,,,1,1,1,1\nsecond,,,1,1,1,1\n")
run(FALSE "multiple game configurations" "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -DGYO_GAMES=AUTO -DTEST_MIXED_GAME_CONFIG=ON)
file(WRITE "${registry}" "${header}")
file(RENAME "${source}/games" "${source}/unused-games")
run(TRUE "" "${CMAKE_COMMAND}" -S "${source}" -B "${binary}" -DGYO_GAMES=AUTO -DGYO_TOOLS=AUTO -DTEST_MIXED_GAME_CONFIG=OFF)
run(TRUE "" "${CMAKE_COMMAND}" --build "${binary}" --config Debug)
run(TRUE "" "${CMAKE_COMMAND}" --install "${binary}" --config Debug --component toolchain --prefix "${work}/stage-toolchain")
file(READ "${work}/stage-toolchain/share/gyo/products/toolchain/manifest.json" manifest)
