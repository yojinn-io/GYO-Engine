   "file": "engine/json/src/adapters/yyjson/YyjsonDocument.cpp",
   "find": "text.size(), YYJSON_READ_NUMBER_AS_RAW,",
   "replace": "text.size(), YYJSON_READ_NOFLAG,",
   "target": "gyo_json_tests",
   "cases": "ObjectView and ArrayView: document order*",
   "expect": "CHECK\\( text\\.has_value\\(\\) \\)"
  },
  {
   "id": "js-repeated-small-unchecked",
