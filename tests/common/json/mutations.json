   "replace": "if (false) return RepeatedKey(key);",
   "target": "gyo_json_tests",
   "cases": "Parse: a key repeated in one object*",
   "expect": "JsonErrorCode::RepeatedKey"
  },
  {
   "id": "js-repeated-large-unchecked",
   "what": "J-2: a repeated key in a large object (hash path) is not found",
   "file": "engine/json/src/adapters/yyjson/YyjsonDocument.cpp",
   "find": "if (!seen.insert(StringOf(key)).second) return RepeatedKey(key);",
   "replace": "seen.insert(StringOf(key));",
   "target": "gyo_json_tests",
   "cases": "Parse: repeated keys are found in large objects*",
   "expect": "JsonErrorCode::RepeatedKey"
  },
  {
   "id": "js-repeated-nested-unchecked",
