# Design Invariant 4 (docs/architecture/audio.md): the audio thread writes the
# playhead board and never reads it. The only reader in the mixer's sources is
# Mixer::PlayheadOf, so a read anywhere else (in particular on the rendering
# path) fails this check. Run as a CTest with -DSOURCE_DIR=engine/audio/src.
file(GLOB sources "${SOURCE_DIR}/*.cpp" "${SOURCE_DIR}/*.hpp")
set(found 0)
foreach(source IN LISTS sources)
    get_filename_component(name "${source}" NAME)
    if(name STREQUAL "PlayheadBoard.hpp")
        continue()
    endif()
    file(READ "${source}" text)
    string(REGEX MATCHALL "board\\.Read\\(" reads "${text}")
    list(LENGTH reads count)
    if(count EQUAL 0)
        continue()
    endif()
    math(EXPR found "${found} + ${count}")
    if(NOT name STREQUAL "Mixer.cpp" OR NOT count EQUAL 1)
        message(FATAL_ERROR "the audio thread must not read the playhead board: ${count} read(s) in ${name}")
    endif()
    string(FIND "${text}" "Playhead Mixer::PlayheadOf(" begin)
    string(FIND "${text}" "board.Read(" at)
    if(begin EQUAL -1 OR at LESS begin)
        message(FATAL_ERROR "the audio thread must not read the playhead board: a read outside Mixer::PlayheadOf")
    endif()
    string(SUBSTRING "${text}" ${begin} -1 rest)
    string(FIND "${rest}" "\n}\n" end)
    math(EXPR offset "${at} - ${begin}")
    if(end EQUAL -1 OR offset GREATER end)
        message(FATAL_ERROR "the audio thread must not read the playhead board: a read outside Mixer::PlayheadOf")
    endif()
endforeach()
if(NOT found EQUAL 1)
    message(FATAL_ERROR "expected exactly one playhead board read (in Mixer::PlayheadOf), found ${found}")
endif()
message(STATUS "playhead board read only in Mixer::PlayheadOf")
