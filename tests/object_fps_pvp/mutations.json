{
  "version": 1,
  "description": "Declared mutants of object_fps_pvp. A mutant is killed only when its check fails with the expected message (run_mutations.py).",
  "checks": {
    "cpu": {
      "build": [
        "gyo_object_fps_pvp_tests"
      ],
      "ctest": "object_fps_pvp.cpu"
    },
    "worker": {
      "build": [
        "gyo_object_fps_pvp_worker_probe"
      ],
      "ctest": "object_fps_pvp.worker"
    },
    "go": {
      "command": [
        "{go}",
        "test",
        "./gateway/..."
      ],
      "cwd": "apps/object_fps_pvp"
    },
    "protocol_version": {
      "ctest": "object_fps_pvp.protocol_version"
    },
    "presentation": {
      "build": [
        "gyo_object_fps_pvp_presentation_tests"
      ],
      "ctest": "object_fps_pvp.presentation_cpu"
    }
  },
  "mutants": [
    {
      "id": "09-hit-count",
      "batch": "09",
      "what": "Match stops counting hits",
      "file": "apps/object_fps_pvp/src/Pvp/PvpMatch.cpp",
      "find": "                    ++target.combat.damageCount;\n",
      "replace": "",
      "check": "cpu",
      "expect": "hit record"
    },
    {
      "id": "09-hit-attacker",
      "batch": "09",
      "what": "Match stops recording the attacker",
      "file": "apps/object_fps_pvp/src/Pvp/PvpMatch.cpp",
      "find": "                    target.combat.lastAttackerId = playerId;\n",
      "replace": "",
      "check": "cpu",
      "expect": "hit record"
    },
    {
      "id": "09-hit-dead-rule",
      "batch": "09",
      "what": "Client accepts a dead player without a lethal hit record",
      "file": "apps/object_fps_pvp/include/RetroFPS/Pvp/Combat.hpp",
      "find": "    if (dead && (none || combat.lastDamageTick != lifeStateTick)) return false;\n",
      "replace": "",
      "check": "cpu",
      "expect": "hit record decode check"
    },
    {
      "id": "09-hit-self-rule",
      "batch": "09",
      "what": "Client accepts a self-inflicted hit",
      "file": "apps/object_fps_pvp/include/RetroFPS/Pvp/Combat.hpp",
      "find": "combat.lastAttackerId != combat.playerId && ",
      "replace": "",
      "check": "cpu",
      "expect": "hit record decode check"
    },
    {
      "id": "09-hit-go-check",
      "batch": "09",
      "what": "Gateway skips hit record validation",
      "file": "apps/object_fps_pvp/gateway/adapter/adapter.go",
      "find": " ||\n\t\t\t!validDamageRecord(state, seen[state.PlayerId], in.Tick, rules) {",
      "replace": " {",
      "check": "go",
      "expect": "TestHitRecordIsValidatedAndKeptVerbatim"
    },
    {
      "id": "09-arena-order",
      "batch": "09",
      "what": "canonical order changes",
      "file": "apps/object_fps_pvp/src/Pvp/Arena.cpp",
      "find": "    f32(jumpHeight);\n    f32(gravity);\n",
      "replace": "    f32(gravity);\n    f32(jumpHeight);\n",
      "check": "cpu",
      "expect": "arena content digest"
    },
    {
      "id": "09-arena-yaw",
      "batch": "09",
      "what": "spawn yaw left out of the digest",
      "file": "apps/object_fps_pvp/src/Pvp/Arena.cpp",
      "find": "vec3(spawn.position); f32(spawn.yaw); }",
      "replace": "vec3(spawn.position); }",
      "check": "cpu",
      "expect": "arena content digest"
    },
    {
      "id": "09-arena-client-compare",
      "batch": "09",
      "what": "Client does not compare digests",
      "file": "apps/object_fps_pvp/src/Pvp/ClientConnection.cpp",
      "find": "if(!digest || *digest!=expectedArenaDigest)",
      "replace": "if(!digest)",
      "check": "worker",
      "expect": "HTTP join accepted different arena content"
    },
    {
      "id": "09-arena-client-welcome",
      "batch": "09",
      "what": "Welcome path is not checked",
      "file": "apps/object_fps_pvp/src/Pvp/ClientConnection.cpp",
      "find": "                CheckArena(message.arena_id(),message.arena_version(),\n                    message.arena_digest()?std::optional<std::uint64_t>{message.arena_digest()}:std::nullopt);\n",
      "replace": "",
      "check": "worker",
      "expect": "Welcome accepted different arena content"
    },
    {
      "id": "09-arena-gateway-zero",
      "batch": "09",
      "what": "Gateway admits a Ready without digest",
      "file": "apps/object_fps_pvp/gateway/runtime_link.go",
      "find": "ready.ArenaDigest == 0 || ",
      "replace": "",
      "check": "go",
      "expect": "with digest 0 admitted"
    },
    {
      "id": "09-arena-gateway-welcome",
      "batch": "09",
      "what": "Gateway drops the digest from Welcome",
      "file": "apps/object_fps_pvp/gateway/server.go",
      "find": "ArenaDigest: s.ready.ArenaDigest, CombatRules",
      "replace": "CombatRules",
      "check": "go",
      "expect": "welcome "
    },
    {
      "id": "09-version-python",
      "batch": "09",
      "what": "one version definition disagrees",
      "file": "build/acceptance/object_fps_pvp/acceptance_util.py",
      "find": "\nPROTOCOL_VERSION = 6\n",
      "replace": "\nPROTOCOL_VERSION = 5\n",
      "check": "protocol_version",
      "expect": "acceptance Python"
    },
    {
      "id": "12-earliest-plus-one",
      "batch": "12",
      "what": "The gate expects a shot to resolve one tick later than it can",
      "file": "apps/object_fps_pvp/src/Pvp/FireGate.cpp",
      "find": "    const auto earliest = newest - static_cast<std::int64_t>(InitialCommandLead) + steps;\n",
      "replace": "    const auto earliest = newest - static_cast<std::int64_t>(InitialCommandLead) + steps + 1;\n",
      "check": "cpu",
      "expect": "the gate's bounds hold"
    },
    {
      "id": "12-no-guard",
      "batch": "12",
      "what": "The earliest tick drops the phase-error guard",
      "file": "apps/object_fps_pvp/src/Pvp/FireGate.cpp",
      "find": "MovementPhaseTargetSeconds - FireGateGuardSeconds -",
      "replace": "MovementPhaseTargetSeconds -",
      "check": "cpu",
      "expect": "follows the newest command less the lead"
    },
    {
      "id": "12-shift-ignored",
      "batch": "12",
      "what": "A slewing correction that delays the phase is ignored",
      "file": "apps/object_fps_pvp/src/Pvp/FireGate.cpp",
      "find": " -\n        Engine::Math::Max(0.0, timing.phaseShiftSeconds);",
      "replace": ";",
      "check": "cpu",
      "expect": "follows the newest command less the lead"
    },
    {
      "id": "12-no-pending-spread",
      "batch": "12",
      "what": "A pending shot is assumed to resolve at its earliest tick",
      "file": "apps/object_fps_pvp/src/Pvp/FireGate.cpp",
      "find": "*earliest + FireGatePendingSpreadTicks + cooldownTicks",
      "replace": "*earliest + cooldownTicks",
      "check": "cpu",
      "expect": "holds a pending shot"
    },
    {
      "id": "12-decision-ignored",
      "batch": "12",
      "what": "An accepted decision does not set the cooldown",
      "file": "apps/object_fps_pvp/src/Pvp/FireGate.cpp",
      "find": "        decidedNextAllowed_ = Engine::Math::Max(decidedNextAllowed_, decision.resolvedTick + cooldownTicks);\n",
      "replace": "",
      "check": "cpu",
      "expect": "waits for every known cooldown"
    },
    {
      "id": "11-pitch-ignored",
      "batch": "11",
      "what": "The remote upper body ignores the pitch (no aim blend)",
      "file": "apps/object_fps_pvp/src/Pvp/PlayerPresentation.cpp",
      "find": "            if (actions.aimWeight != 0) {\n",
      "replace": "            if (false) {\n",
      "check": "presentation",
      "expect": "a positive pitch points the pistol down"
    },
    {
      "id": "11-pitch-reversed",
      "batch": "11",
      "what": "Looking up shows the down pose",
      "file": "apps/object_fps_pvp/src/Pvp/PlayerPresentation.cpp",
      "find": "actions.aimWeight < 0 ? definition.aimUpClip :",
      "replace": "actions.aimWeight > 0 ? definition.aimUpClip :",
      "check": "presentation",
      "expect": "a positive pitch points the pistol down"
    },
    {
      "id": "11-pitch-unclamped",
      "batch": "11",
      "what": "A pitch beyond the down pose is not clamped",
      "file": "apps/object_fps_pvp/src/Pvp/PlayerPresentation.cpp",
      "find": "static_cast<float>(Engine::Math::Min(1.0, frame.pitch / definition.aimDownRadians));",
      "replace": "static_cast<float>(frame.pitch / definition.aimDownRadians);",
      "check": "presentation",
      "expect": "clamps the pitch"
    },
    {
      "id": "11-action-replaces",
      "batch": "11",
      "what": "A shot or reload replaces the upper body and drops the pitch",
      "file": "apps/object_fps_pvp/src/Pvp/PlayerPresentation.cpp",
      "find": "                    aim.localTransforms[i] = AddMotion(aim.localTransforms[i], reference.localTransforms[i],\n                                                       motion->localTransforms[i]);\n",
      "replace": "                    aim.localTransforms[i] = motion->localTransforms[i];\n",
      "check": "presentation",
      "expect": "keep the remote pitch"
    },
    {
      "id": "11-dead-aims",
      "batch": "11",
      "what": "Death no longer owns the whole body: the aim pose overrides its upper body",
      "file": "apps/object_fps_pvp/src/Pvp/PlayerPresentation.cpp",
      "find": "            upper = nullptr; // Death owns the whole body, weapon hand included.\n",
      "replace": "",
      "check": "presentation",
      "expect": "plays Death01 once over the whole body"
    },
    {
      "id": "11-limit-uncalibrated",
      "batch": "11",
      "what": "The down limit no longer matches the measured down pose",
      "file": "assets/object_fps_pvp/players/presentation.json",
      "find": "    \"down_pitch_radians\": 1.5236\n",
      "replace": "    \"down_pitch_radians\": 1.3\n",
      "check": "presentation",
      "expect": "measured muzzle elevations"
    }
  ]
}
