        STARTUP_ENVIRONMENT "VALUE=one;two" "EMPTY="
        STARTUP_TIMEOUT 7 REQUIRED_FILES "bin/data;set.json")
    gyo_add_app_package_check(NAME direct
        COMMAND "@EXECUTABLE@" "one two" "semi;colon" "" "tail" ""
