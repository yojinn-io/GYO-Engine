get_property(manifest GLOBAL PROPERTY GYO_APP_sample_PACKAGE)
file(WRITE "${CMAKE_BINARY_DIR}/review-manifest.json" "${manifest}\n")
]=])

set(generator_args "")
if(GENERATOR)
    list(APPEND generator_args -G "${GENERATOR}")
endif()
if(MAKE_PROGRAM)
    list(APPEND generator_args "-DCMAKE_MAKE_PROGRAM=${MAKE_PROGRAM}")
endif()
if(PLATFORM)
    list(APPEND generator_args -A "${PLATFORM}")
endif()

function(expect_equal actual expected context)
    if(NOT "${actual}" STREQUAL "${expected}")
        message(FATAL_ERROR "${context}: expected '${expected}', got '${actual}'")
    endif()
endfunction()

function(run_fixture name success system processor expected_platform)
    set(binary "${work}/${name}")
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${source}" -B "${binary}"
        ${generator_args} "-DGYO_TEST_REPOSITORY=${repository}"
        "-DTEST_SYSTEM=${system}" "-DTEST_PROCESSOR=${processor}" ${ARGN}
        RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 30)
    if(NOT success)
        if(result EQUAL 0)
            message(FATAL_ERROR "Invalid package fixture '${name}' was accepted")
        endif()
        string(TOLOWER "${stdout}\n${stderr}" diagnostic)
        string(FIND "${diagnostic}" "${expected_platform}" found)
        if(found EQUAL -1)
            message(FATAL_ERROR
                "Fixture '${name}' did not report '${expected_platform}': ${stdout}\n${stderr}")
        endif()
        return()
    endif()
    if(NOT result EQUAL 0)
        message(FATAL_ERROR "Package fixture '${name}' failed: ${stdout}\n${stderr}")
    endif()
    file(READ "${binary}/review-manifest.json" manifest)
    string(JSON platform GET "${manifest}" platform)
    expect_equal("${platform}" "${expected_platform}" "${name}/target platform")

    # Compare each argument separately: treating the command as a CMake list
    # here would hide the very semicolon/empty-argument regression being tested.
    foreach(check RANGE 0 1)
        string(JSON count LENGTH "${manifest}" checks ${check} command)
        expect_equal("${count}" 6 "${name}/check ${check} argv count")
        string(JSON executable GET "${manifest}" checks ${check} command 0)
        string(JSON spaced GET "${manifest}" checks ${check} command 1)
        string(JSON semicolon GET "${manifest}" checks ${check} command 2)
        string(JSON empty GET "${manifest}" checks ${check} command 3)
        string(JSON tail GET "${manifest}" checks ${check} command 4)
        string(JSON trailing_empty GET "${manifest}" checks ${check} command 5)
        expect_equal("${executable}" "@EXECUTABLE@" "${name}/check ${check} executable")
        expect_equal("${spaced}" "one two" "${name}/check ${check} spaced argument")
        expect_equal("${semicolon}" "semi;colon" "${name}/check ${check} semicolon argument")
        expect_equal("${empty}" "" "${name}/check ${check} empty argument")
        expect_equal("${tail}" tail "${name}/check ${check} tail argument")
        expect_equal("${trailing_empty}" "" "${name}/check ${check} trailing empty argument")
        string(JSON environment_count LENGTH "${manifest}" checks ${check} environment)
        expect_equal("${environment_count}" 2 "${name}/check ${check} environment count")
        string(JSON value GET "${manifest}" checks ${check} environment 0)
        string(JSON empty_value GET "${manifest}" checks ${check} environment 1)
        expect_equal("${value}" "VALUE=one;two" "${name}/check ${check} semicolon environment")
        expect_equal("${empty_value}" "EMPTY=" "${name}/check ${check} empty environment")
    endforeach()
    string(JSON required_count LENGTH "${manifest}" required_files)
    expect_equal("${required_count}" 2 "${name}/required path count")
    string(JSON required_path GET "${manifest}" required_files 1)
    expect_equal("${required_path}" "bin/data;set.json" "${name}/semicolon path")
    string(JSON startup_timeout GET "${manifest}" checks 0 timeout)
    string(JSON direct_timeout GET "${manifest}" checks 1 timeout)
    string(JSON maximum_timeout GET "${manifest}" checks 2 timeout)
    expect_equal("${startup_timeout}" 7 "${name}/startup timeout")
    expect_equal("${direct_timeout}" 11 "${name}/direct timeout")
    expect_equal("${maximum_timeout}" 3600 "${name}/maximum timeout")
endfunction()

