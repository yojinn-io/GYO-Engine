# Judgment E7 of v8-tool-voxel-map-editor-core (docs/tools/plans/v8/voxel-map-editor.md):
# the command line's success and failure paths, run with cmake -P.
# Inputs: EDITOR (the executable), WORK (a scratch folder), FIXTURES.

file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

set(last_output "")
macro(check expected name)
    execute_process(COMMAND "${EDITOR}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: exit ${code}, expected ${expected}\n${out}${err}")
    endif()
    set(last_output "${out}${err}")
endmacro()

check(0 help --help)
check(2 no_command)
check(2 unknown nonsense)
check(2 build_arguments build "${FIXTURES}/sample.voxel_grid.json")

# build writes what the golden file holds, byte for byte.
check(0 build build "${FIXTURES}/sample.voxel_grid.json" "${WORK}/out/sample.voxel_mesh.json")
file(SHA256 "${WORK}/out/sample.voxel_mesh.json" built)
file(SHA256 "${FIXTURES}/sample.voxel_mesh.json" golden)
if(NOT built STREQUAL golden)
    message(FATAL_ERROR "build: the baked file differs from the golden file")
endif()
if(NOT last_output MATCHES "11 cells, 84 quads, 12 colliders")
    message(FATAL_ERROR "build: the summary is wrong\n${last_output}")
endif()

# verify: the same file passes; one changed byte fails.
check(0 verify_same verify "${FIXTURES}/sample.voxel_grid.json" "${WORK}/out/sample.voxel_mesh.json")
file(READ "${WORK}/out/sample.voxel_mesh.json" mesh)
string(REPLACE "\"cell_size\": 0.5" "\"cell_size\": 0.6" changed "${mesh}")
file(CONFIGURE OUTPUT "${WORK}/out/changed.voxel_mesh.json" CONTENT "${changed}" @ONLY NEWLINE_STYLE LF)
check(4 verify_different verify "${FIXTURES}/sample.voxel_grid.json" "${WORK}/out/changed.voxel_mesh.json")
check(3 verify_missing verify "${FIXTURES}/sample.voxel_grid.json" "${WORK}/nowhere.json")

# An invalid grid writes nothing.
file(CONFIGURE OUTPUT "${WORK}/bad.voxel_grid.json" CONTENT "{\"schema\": \"gyo.voxel_grid\"}\n" @ONLY NEWLINE_STYLE LF)
check(1 build_invalid build "${WORK}/bad.voxel_grid.json" "${WORK}/bad.voxel_mesh.json")
if(EXISTS "${WORK}/bad.voxel_mesh.json")
    message(FATAL_ERROR "build_invalid: a file was written")
endif()
# A grid Engine refuses to have baked (no blocks placed, so no quads) writes nothing.
file(READ "${FIXTURES}/sample.voxel_grid.json" grid)
string(REGEX REPLACE "\"chunks\": \\[.*\\]\n}" "\"chunks\": []\n}" emptied "${grid}")
file(CONFIGURE OUTPUT "${WORK}/empty.voxel_grid.json" CONTENT "${emptied}" @ONLY NEWLINE_STYLE LF)
check(1 build_refused build "${WORK}/empty.voxel_grid.json" "${WORK}/empty.voxel_mesh.json")
if(NOT last_output MATCHES "BuildRefused")
    message(FATAL_ERROR "build_refused: not refused by Engine\n${last_output}")
endif()
if(EXISTS "${WORK}/empty.voxel_mesh.json")
    message(FATAL_ERROR "build_refused: a file was written")
endif()

# inspect knows both formats.
check(0 inspect_grid inspect "${FIXTURES}/sample.voxel_grid.json")
if(NOT last_output MATCHES "gyo.voxel_grid: 3 shapes, 3 blocks, 2 chunks, 11 cells")
    message(FATAL_ERROR "inspect_grid\n${last_output}")
endif()
check(0 inspect_mesh inspect "${FIXTURES}/sample.voxel_mesh.json")
if(NOT last_output MATCHES "84 quads, 12 colliders")
    message(FATAL_ERROR "inspect_mesh\n${last_output}")
endif()
check(1 inspect_invalid inspect "${WORK}/bad.voxel_grid.json")

# import-boxes takes boxes from wherever the caller points.
file(CONFIGURE OUTPUT "${WORK}/boxes.json" CONTENT "{\"level\": {\"solid\": [{\"min\": [-1, 0, -1], \"max\": [0, 3, 2]}, {\"min\": [2, 0, 2], \"max\": [4, 2, 4]}]}}\n" @ONLY NEWLINE_STYLE LF)
check(0 import import-boxes "${WORK}/boxes.json" /level/solid "${WORK}/imported.voxel_grid.json")
check(0 import_build build "${WORK}/imported.voxel_grid.json" "${WORK}/imported.voxel_mesh.json")
if(NOT last_output MATCHES "17 cells, .* quads, 2 colliders")
    message(FATAL_ERROR "import_build\n${last_output}")
endif()
check(1 import_missing_pointer import-boxes "${WORK}/boxes.json" /walls "${WORK}/nothing.voxel_grid.json")
if(EXISTS "${WORK}/nothing.voxel_grid.json")
    message(FATAL_ERROR "import_missing_pointer: a file was written")
endif()

# W8 of v8-tool-voxel-map-editor-window: edit and measure-preview check their arguments in every variant; a build
# without the window says so and opens nothing.
check(2 edit_arguments edit "${WORK}/only.voxel_grid.json")
check(2 edit_option edit "${WORK}/a.voxel_grid.json" "${WORK}/a.voxel_mesh.json" --gpu "metal")
# The window edits geometry only: markers are the scene editor's (v8-tool-voxel-window-1, W8).
check(2 edit_markers edit "${WORK}/a.voxel_grid.json" "${WORK}/a-map" --markers "${WORK}/m.json")
check(2 measure_no_edit_value measure-preview --synthetic --csv "${WORK}/m.csv" --no-edit --frames)
check(2 measure_no_map measure-preview --csv "${WORK}/m.csv")
check(2 measure_both measure-preview --synthetic --grid "${WORK}/a.voxel_grid.json" --csv "${WORK}/m.csv")
check(2 measure_no_csv measure-preview --synthetic)
check(2 measure_frames measure-preview --synthetic --csv "${WORK}/m.csv" --frames 0)
check(2 measure_unknown measure-preview --synthetic --csv "${WORK}/m.csv" --fast yes)
if(NOT HAS_WINDOW)
    check(2 edit_without_window edit "${WORK}/a.voxel_grid.json" "${WORK}/a.voxel_mesh.json")
    if(NOT last_output MATCHES "has no window")
        message(FATAL_ERROR "edit_without_window\n${last_output}")
    endif()
    if(EXISTS "${WORK}/a.voxel_grid.json" OR EXISTS "${WORK}/a.voxel_mesh.json")
        message(FATAL_ERROR "edit_without_window: a file was written")
    endif()
    check(2 measure_without_window measure-preview --synthetic --csv "${WORK}/m.csv")
endif()

# The chunked map (v8-arch-big-map-tool-chunked, judgments T1, T2 and T4).
check(2 build_map_arguments build-map "${FIXTURES}/sample.voxel_grid.json")
check(0 build_map build-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
if(NOT last_output MATCHES "2 regions, 2 chunks")
    message(FATAL_ERROR "build_map: the summary is wrong\n${last_output}")
endif()
file(GLOB_RECURSE golden_files RELATIVE "${FIXTURES}/sample_map" "${FIXTURES}/sample_map/*")
file(GLOB_RECURSE built_files RELATIVE "${WORK}/map" "${WORK}/map/*")
list(SORT golden_files)
list(SORT built_files)
if(NOT golden_files STREQUAL built_files)
    message(FATAL_ERROR "build_map: files ${built_files}, expected ${golden_files}")
endif()
foreach(name IN LISTS golden_files)
    file(SHA256 "${WORK}/map/${name}" built)
    file(SHA256 "${FIXTURES}/sample_map/${name}" golden)
    if(NOT built STREQUAL golden)
        message(FATAL_ERROR "build_map: ${name} differs from the golden file")
    endif()
endforeach()
check(0 verify_map_same verify-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
check(0 inspect_map inspect-map "${WORK}/map")
if(NOT last_output MATCHES "gyo.voxel_map: 3 palette entries, 2 regions, 2 chunks, 69 quads, 13 colliders")
    message(FATAL_ERROR "inspect_map\n${last_output}")
endif()
# One changed byte in a region file fails verify-map.
list(GET golden_files 1 region_name)
file(READ "${WORK}/map/${region_name}" region)
string(REPLACE "\"version\": 1" "\"version\": 1 " changed "${region}")
file(CONFIGURE OUTPUT "${WORK}/map/${region_name}" CONTENT "${changed}" @ONLY NEWLINE_STYLE LF)
check(4 verify_map_different verify-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
check(3 verify_map_missing verify-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/nowhere")
# Building again repairs it; building another grid into the same folder removes
# the region files only the old index listed.
check(0 build_map_again build-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
check(0 verify_map_again verify-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
check(0 build_map_other build-map "${WORK}/imported.voxel_grid.json" "${WORK}/map")
check(0 verify_map_other verify-map "${WORK}/imported.voxel_grid.json" "${WORK}/map")
foreach(name IN LISTS golden_files)
    if(name MATCHES "^regions/" AND EXISTS "${WORK}/map/${name}")
        message(FATAL_ERROR "build_map_other: ${name} of the old map is still there")
    endif()
endforeach()
# A grid without filled cells has no map, and nothing is written.
check(1 build_map_empty build-map "${WORK}/empty.voxel_grid.json" "${WORK}/empty-map")
if(NOT last_output MATCHES "EmptyMap")
    message(FATAL_ERROR "build_map_empty\n${last_output}")
endif()
if(EXISTS "${WORK}/empty-map")
    message(FATAL_ERROR "build_map_empty: something was written")
endif()
# A grid whose map Engine refuses (its chunk ends past +-2^20 units, rule M6) writes nothing.
file(CONFIGURE OUTPUT "${WORK}/edge.voxel_grid.json" CONTENT "{\"schema\": \"gyo.voxel_grid\", \"version\": 1, \"origin\": [8, 0, 0], \"cell_size\": 1.0, \"shapes\": [{\"name\": \"cube\", \"boxes\": [{\"min\": [0, 0, 0], \"max\": [16, 16, 16]}]}], \"blocks\": [{\"name\": \"stone\", \"shape\": 0, \"color\": [1, 2, 3, 255]}], \"chunks\": [{\"at\": [4095, 0, 0], \"runs\": [[0, 0, 7], [1, 0, 1], [0, 0, 4088]]}]}\n" @ONLY NEWLINE_STYLE LF)
check(1 build_map_refused build-map "${WORK}/edge.voxel_grid.json" "${WORK}/edge-map")
if(NOT last_output MATCHES "BuildRefused")
    message(FATAL_ERROR "build_map_refused: not refused by Engine\n${last_output}")
endif()
if(EXISTS "${WORK}/edge-map")
    message(FATAL_ERROR "build_map_refused: something was written")
endif()
check(1 build_map_invalid build-map "${WORK}/bad.voxel_grid.json" "${WORK}/bad-map")
if(EXISTS "${WORK}/bad-map")
    message(FATAL_ERROR "build_map_invalid: something was written")
endif()
check(3 inspect_map_missing inspect-map "${FIXTURES}")
file(CONFIGURE OUTPUT "${WORK}/bad-index/map.json" CONTENT "{\"schema\": \"gyo.voxel_map\"}\n" @ONLY NEWLINE_STYLE LF)
check(1 inspect_map_invalid inspect-map "${WORK}/bad-index")

# Markers through Engine (v8-arch-big-map-tool-chunked, judgment T6).
check(2 check_markers_arguments check-markers "${FIXTURES}/sample.map_markers.json" "${FIXTURES}/sample.marker_kinds.json")
file(CONFIGURE OUTPUT "${WORK}/all.marker_kinds.json" CONTENT "{\"schema\": \"gyo.marker_kinds\", \"version\": 1, \"kinds\": [\"a\", \"b\", \"c\"]}\n" @ONLY NEWLINE_STYLE LF)
check(0 check_markers check-markers "${FIXTURES}/sample.map_markers.json" --marker-kinds "${WORK}/all.marker_kinds.json")
if(NOT last_output MATCHES "4 markers, every kind in 3 kinds")
    message(FATAL_ERROR "check_markers\n${last_output}")
endif()
# The sample lists a and c; marker m2 has kind b.
check(1 check_markers_unknown check-markers "${FIXTURES}/sample.map_markers.json" --marker-kinds "${FIXTURES}/sample.marker_kinds.json")
if(NOT last_output MATCHES "unknown kind: markers\\[1\\]\\.kind" OR NOT last_output MATCHES "UnknownKinds")
    message(FATAL_ERROR "check_markers_unknown\n${last_output}")
endif()
file(CONFIGURE OUTPUT "${WORK}/bad.marker_kinds.json" CONTENT "{\"schema\": \"gyo.marker_kinds\", \"version\": 1, \"kinds\": []}\n" @ONLY NEWLINE_STYLE LF)
check(1 check_markers_bad_kinds check-markers "${FIXTURES}/sample.map_markers.json" --marker-kinds "${WORK}/bad.marker_kinds.json")
if(NOT last_output MATCHES "InvalidMarkers")
    message(FATAL_ERROR "check_markers_bad_kinds\n${last_output}")
endif()
check(1 check_markers_bad_markers check-markers "${WORK}/bad.voxel_grid.json" --marker-kinds "${WORK}/all.marker_kinds.json")
check(3 check_markers_missing check-markers "${WORK}/nowhere.json" --marker-kinds "${WORK}/all.marker_kinds.json")
