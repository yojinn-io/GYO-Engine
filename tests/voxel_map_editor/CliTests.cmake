# The command line's success and failure paths, run with cmake -P: master's CLI cases for the commands carried
# (tests/voxel_map_editor/VoxelMapCliTests.cmake), the Goxel import end to end and the synthetic maps.
# Inputs: EDITOR (the executable), WORK (a scratch folder), FIXTURES.

# Relative paths are taken from the current directory (cmake -P sets the source directory to it).
get_filename_component(FIXTURES "${FIXTURES}" ABSOLUTE)
get_filename_component(WORK "${WORK}" ABSOLUTE)
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}")

set(last_output "")
macro(check expected name)
    execute_process(COMMAND "${EDITOR}" ${ARGN} RESULT_VARIABLE code OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(NOT code STREQUAL "${expected}")
        message(FATAL_ERROR "${name}: exit ${code}, expected ${expected}\n${out}${err}")
    endif()
    set(last_output "${out}${err}")
endmacro()
macro(expect_output name pattern)
    if(NOT last_output MATCHES "${pattern}")
        message(FATAL_ERROR "${name}: the output does not match '${pattern}'\n${last_output}")
    endif()
endmacro()
macro(expect_missing name path)
    if(EXISTS "${path}")
        message(FATAL_ERROR "${name}: ${path} was written")
    endif()
endmacro()

check(0 help --help)
check(2 no_command)
check(2 unknown nonsense)
# Single-file v1 (build, verify) is not carried.
check(2 build_v1 build "${FIXTURES}/sample.voxel_grid.json" "${WORK}/sample.voxel_mesh.json")

# build-map writes master's golden map, byte for byte.
check(2 build_map_arguments build-map "${FIXTURES}/sample.voxel_grid.json")
check(0 build_map build-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
expect_output(build_map "2 regions, 2 chunks, 69 quads, 13 colliders, 4486 bytes")
file(GLOB_RECURSE golden_files RELATIVE "${FIXTURES}/sample_map" "${FIXTURES}/sample_map/*")
file(GLOB_RECURSE built_files RELATIVE "${WORK}/map" "${WORK}/map/*")
list(SORT golden_files)
list(SORT built_files)
if(NOT golden_files STREQUAL built_files)
    message(FATAL_ERROR "build_map: files ${built_files}, expected ${golden_files}")
endif()
foreach(name IN LISTS golden_files)
    file(SHA256 "${WORK}/map/${name}" built)
    file(SHA256 "${FIXTURES}/sample_map/${name}" golden)
    if(NOT built STREQUAL golden)
        message(FATAL_ERROR "build_map: ${name} differs from master's golden file")
    endif()
endforeach()
check(0 verify_map_same verify-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
check(0 verify_map_golden verify-map "${FIXTURES}/sample.voxel_grid.json" "${FIXTURES}/sample_map")
check(0 inspect_map inspect-map "${WORK}/map")
expect_output(inspect_map "gyo.voxel_map: 3 palette entries, 2 regions, 2 chunks, 69 quads, 13 colliders, 4486 bytes")
# catalog: the index and every region the index lists, in index order (the game's catalog takes them as they are).
check(0 catalog catalog "${WORK}/map" game.map maps/sample)
expect_output(catalog "[{]\"id\": \"game[.]map\", \"type\": \"voxel_map\", \"path\": \"maps/sample/map[.]json\"[}]")
expect_output(catalog "\"id\": \"game[.]map[.]r_-1_0\", \"type\": \"voxel_region\", \"path\": \"maps/sample/regions/r_-1_0_96e1b233dc9068b6[.]json\"[^]]*\"id\": \"game[.]map[.]r_0_0\"")
check(2 catalog_arguments catalog "${WORK}/map" game.map)
check(2 catalog_bad_id catalog "${WORK}/map" game/map maps/sample)
check(0 inspect_grid inspect "${FIXTURES}/sample.voxel_grid.json")
expect_output(inspect_grid "gyo.voxel_grid: 3 shapes, 3 blocks, 2 chunks, 11 cells")
# One changed byte in a region file fails verify-map.
list(GET golden_files 1 region_name)
file(READ "${WORK}/map/${region_name}" region)
string(REPLACE "\"version\": 1" "\"version\": 1 " changed "${region}")
file(CONFIGURE OUTPUT "${WORK}/map/${region_name}" CONTENT "${changed}" @ONLY NEWLINE_STYLE LF)
check(4 verify_map_different verify-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
check(1 inspect_map_changed inspect-map "${WORK}/map")
expect_output(inspect_map_changed "BuildRefused")
check(3 verify_map_missing verify-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/nowhere")
check(3 inspect_map_missing inspect-map "${WORK}/nowhere")

# import-boxes takes boxes from wherever the caller points; building another grid into the same folder removes the
# region files only the old index listed.
file(CONFIGURE OUTPUT "${WORK}/boxes.json" CONTENT "{\"level\": {\"solid\": [{\"min\": [-1, 0, -1], \"max\": [0, 3, 2]}, {\"min\": [2, 0, 2], \"max\": [4, 2, 4]}]}}\n" @ONLY NEWLINE_STYLE LF)
check(0 import import-boxes "${WORK}/boxes.json" /level/solid "${WORK}/imported.voxel_grid.json")
check(0 inspect_imported inspect "${WORK}/imported.voxel_grid.json")
expect_output(inspect_imported "1 blocks, 1 chunks, 17 cells")
check(1 import_missing_pointer import-boxes "${WORK}/boxes.json" /walls "${WORK}/nothing.voxel_grid.json")
expect_output(import_missing_pointer "InvalidBoxes")
expect_missing(import_missing_pointer "${WORK}/nothing.voxel_grid.json")
check(2 import_arguments import-boxes "${WORK}/boxes.json" /level/solid)
check(0 build_map_again build-map "${FIXTURES}/sample.voxel_grid.json" "${WORK}/map")
check(0 build_map_other build-map "${WORK}/imported.voxel_grid.json" "${WORK}/map")
expect_output(build_map_other "2 colliders")
check(0 verify_map_other verify-map "${WORK}/imported.voxel_grid.json" "${WORK}/map")
foreach(name IN LISTS golden_files)
    if(name MATCHES "^regions/" AND EXISTS "${WORK}/map/${name}")
        message(FATAL_ERROR "build_map_other: ${name} of the old map is still there")
    endif()
endforeach()

# Grids that give no map write nothing: no filled cell (EmptyMap), a chunk past +-2^20 units (rule M6, refused by the
# voxel_map Module), a grid the format refuses.
file(READ "${FIXTURES}/sample.voxel_grid.json" grid)
string(REGEX REPLACE "\"chunks\": \\[.*\\]\n}" "\"chunks\": []\n}" emptied "${grid}")
file(CONFIGURE OUTPUT "${WORK}/empty.voxel_grid.json" CONTENT "${emptied}" @ONLY NEWLINE_STYLE LF)
check(1 build_map_empty build-map "${WORK}/empty.voxel_grid.json" "${WORK}/empty-map")
expect_output(build_map_empty "EmptyMap")
expect_missing(build_map_empty "${WORK}/empty-map")
file(CONFIGURE OUTPUT "${WORK}/edge.voxel_grid.json" CONTENT "{\"schema\": \"gyo.voxel_grid\", \"version\": 1, \"origin\": [8, 0, 0], \"cell_size\": 1.0, \"shapes\": [{\"name\": \"cube\", \"boxes\": [{\"min\": [0, 0, 0], \"max\": [16, 16, 16]}]}], \"blocks\": [{\"name\": \"stone\", \"shape\": 0, \"color\": [1, 2, 3, 255]}], \"chunks\": [{\"at\": [4095, 0, 0], \"runs\": [[0, 0, 7], [1, 0, 1], [0, 0, 4088]]}]}\n" @ONLY NEWLINE_STYLE LF)
check(1 build_map_refused build-map "${WORK}/edge.voxel_grid.json" "${WORK}/edge-map")
expect_output(build_map_refused "BuildRefused")
expect_missing(build_map_refused "${WORK}/edge-map")
file(CONFIGURE OUTPUT "${WORK}/bad.voxel_grid.json" CONTENT "{\"schema\": \"gyo.voxel_grid\"}\n" @ONLY NEWLINE_STYLE LF)
check(1 build_map_invalid build-map "${WORK}/bad.voxel_grid.json" "${WORK}/bad-map")
expect_output(build_map_invalid "InvalidGrid")
expect_missing(build_map_invalid "${WORK}/bad-map")
check(1 inspect_invalid inspect "${WORK}/bad.voxel_grid.json")
file(CONFIGURE OUTPUT "${WORK}/bad-index/map.json" CONTENT "{\"schema\": \"gyo.voxel_map\"}\n" @ONLY NEWLINE_STYLE LF)
check(1 inspect_map_invalid inspect-map "${WORK}/bad-index")

# import-gox end to end on the town map: import, bake, read back with the Module, bake again the same.
check(0 import_gox import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/town.voxel_grid.json"
      --exclude-layer "Spawns*" --block 51544a=cube)
expect_output(import_gox "layer \"Spawns and exits\": excluded")
expect_output(import_gox "imported .*: 80 blocks, 323 chunks, 644121 cells")
check(0 import_gox_build build-map "${WORK}/town.voxel_grid.json" "${WORK}/town")
check(0 import_gox_inspect inspect-map "${WORK}/town")
expect_output(import_gox_inspect "80 palette entries, 4 regions, 323 chunks")
check(0 import_gox_verify verify-map "${WORK}/town.voxel_grid.json" "${WORK}/town")
# The same import twice writes the same grid.
file(SHA256 "${WORK}/town.voxel_grid.json" first)
check(0 import_gox_again import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/town.voxel_grid.json"
      --exclude-layer "Spawns*" --block 51544a=cube)
file(SHA256 "${WORK}/town.voxel_grid.json" second)
if(NOT first STREQUAL second)
    message(FATAL_ERROR "import_gox_again: the grid changed")
endif()
check(0 import_gox_note import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/note.voxel_grid.json" --block 123456=slab)
expect_output(import_gox_note "note: no geometry voxel has the colour of --block 123456")
check(2 import_gox_arguments import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox")
check(2 import_gox_block_form import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json" --block 51544a)
check(2 import_gox_block_colour import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json" --block 51544=cube)
check(2 import_gox_block_twice import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json"
      --block 51544a=cube --block 51544A=slab)
check(2 import_gox_cell_size import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json" --cell-size 0)
check(2 import_gox_cell_size_text import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json" --cell-size half)
check(2 import_gox_option import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json" --layer Terrain)
check(2 import_gox_value import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json" --exclude-layer)
check(1 import_gox_shape import-gox "${FIXTURES}/Kiriyu_Town_Graybox.gox" "${WORK}/x.voxel_grid.json" --block 51544a=ramp)
expect_output(import_gox_shape "InvalidGox")
check(1 import_gox_not_gox import-gox "${FIXTURES}/sample.voxel_grid.json" "${WORK}/x.voxel_grid.json")
expect_output(import_gox_not_gox "InvalidGox")
check(3 import_gox_missing import-gox "${WORK}/nowhere.gox" "${WORK}/x.voxel_grid.json")
expect_missing(import_gox_errors "${WORK}/x.voxel_grid.json")

# synthesize: a small km2-ground (64 x 64 cells: 4 x 4 chunks, one region), its grid written too and baked again
# the same by build-map; the arguments.
check(0 synthesize synthesize km2-ground "${WORK}/ground" --size 64 --grid "${WORK}/ground.voxel_grid.json")
expect_output(synthesize "built .*: 1 regions, 16 chunks")
check(0 synthesize_verify verify-map "${WORK}/ground.voxel_grid.json" "${WORK}/ground")
check(2 synthesize_arguments synthesize km2-ground)
check(2 synthesize_name synthesize city "${WORK}/city")
check(2 synthesize_size synthesize km2-ground "${WORK}/ground" --size 100)
check(2 synthesize_size_text synthesize km2-ground "${WORK}/ground" --size big)
check(2 synthesize_option synthesize km2-ground "${WORK}/ground" --seed 1)
expect_missing(synthesize_errors "${WORK}/city")
