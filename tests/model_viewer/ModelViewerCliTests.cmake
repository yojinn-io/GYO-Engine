if(NOT VIEWER OR NOT WORK OR NOT FIXTURES)
    message(FATAL_ERROR "VIEWER, WORK and FIXTURES are required")
endif()
file(REMOVE_RECURSE "${WORK}")
file(MAKE_DIRECTORY "${WORK}/assets" "${WORK}/working")
file(WRITE "${WORK}/assets/asset_catalog.json" "{\n  \"version\": 1,\n  \"assets\": [\n    { \"id\": \"game.model.a\", \"type\": \"model\", \"path\": \"a.fbx\" },\n    { \"id\": \"game.anim_events.a\", \"type\": \"text\", \"path\": \"a.anim_events.json\" }\n  ]\n}\n")
file(WRITE "${WORK}/assets/a.fbx" "not an fbx")
file(WRITE "${WORK}/assets/a.anim_events.json" "{\n  \"schema\": \"gyo.anim_events\",\n  \"version\": 1,\n  \"model_asset_id\": \"game.model.a\",\n  \"clips\": {\n    \"Take\": [\n      { \"seconds\": 0.5, \"event\": \"step\" }\n    ]\n  }\n}\n")
set(mount --asset-root "${WORK}/assets" --asset-catalog "${WORK}/assets/asset_catalog.json")
function(check expected label)
    execute_process(COMMAND "${VIEWER}" ${ARGN}
        WORKING_DIRECTORY "${WORK}/working" RESULT_VARIABLE actual
        OUTPUT_VARIABLE output ERROR_VARIABLE error TIMEOUT 30)
    if(NOT actual STREQUAL "${expected}")
        message(FATAL_ERROR "${label}: expected ${expected}, got ${actual}\n${output}\n${error}")
    endif()
    set(last_output "${output}" PARENT_SCOPE)
endfunction()
check(0 help --help)
check(2 no_command)
check(2 unknown_command play)
check(2 models_without_root models)
check(2 info_without_model info ${mount})
check(2 repeated_option models ${mount} --asset-root "${WORK}/assets")
check(2 unexpected_argument models ${mount} extra)
check(0 models models ${mount})
if(NOT last_output MATCHES "game\\.model\\.a\ta\\.fbx")
    message(FATAL_ERROR "models: the model is not listed\n${last_output}")
endif()
check(4 mount_missing models --asset-root "${WORK}/nowhere")
check(4 info_invalid_model info ${mount} --model game.model.a)
check(4 info_unknown_model info ${mount} --model game.anim_events.a)
check(4 roundtrip_unknown roundtrip ${mount} --events game.model.a)
check(4 roundtrip_invalid_model roundtrip ${mount} --events game.anim_events.a)
# Success paths on the viewer's own fixture (a triangle with the clip "Take", 2/30 s).
file(MAKE_DIRECTORY "${WORK}/good")
file(COPY_FILE "${FIXTURES}/animated_triangle.fbx" "${WORK}/good/t.fbx")
file(WRITE "${WORK}/good/asset_catalog.json" "{\n  \"version\": 1,\n  \"assets\": [\n    { \"id\": \"game.model.t\", \"type\": \"model\", \"path\": \"t.fbx\" },\n    { \"id\": \"game.anim_events.t\", \"type\": \"text\", \"path\": \"t.anim_events.json\" },\n    { \"id\": \"game.anim_events.late\", \"type\": \"text\", \"path\": \"late.anim_events.json\" }\n  ]\n}\n")
set(events_text "{\n  \"schema\": \"gyo.anim_events\",\n  \"version\": 1,\n  \"model_asset_id\": \"game.model.t\",\n  \"clips\": {\n    \"Take\": [\n      { \"seconds\": 0.05, \"event\": \"step\" }\n    ]\n  }\n}\n")
file(WRITE "${WORK}/good/t.anim_events.json" "${events_text}")
string(REPLACE "0.05" "0.5" late_text "${events_text}")
file(WRITE "${WORK}/good/late.anim_events.json" "${late_text}")
set(good --asset-root "${WORK}/good" --asset-catalog "${WORK}/good/asset_catalog.json")
check(0 info info ${good} --model game.model.t)
if(NOT last_output MATCHES "clips: 1\n  Take: 0\\.067 s, 1 tracks\n")
    message(FATAL_ERROR "info: the clip is not described\n${last_output}")
endif()
if(NOT last_output MATCHES "game\\.anim_events\\.t: 1 events in 1 clips")
    message(FATAL_ERROR "info: the events file is not listed\n${last_output}")
endif()
# Parsed but beyond the clip: binding is Engine's to refuse, and info says so.
if(NOT last_output MATCHES "game\\.anim_events\\.late: refused by Engine: InvalidAnimationEvents")
    message(FATAL_ERROR "info: the file Engine cannot bind is not refused\n${last_output}")
endif()
check(0 roundtrip roundtrip ${good} --events game.anim_events.t)
if(NOT last_output MATCHES "byte for byte the same")
    message(FATAL_ERROR "roundtrip: the hand-written layout did not come back\n${last_output}")
endif()
check(4 roundtrip_late roundtrip ${good} --events game.anim_events.late)
file(READ "${WORK}/good/t.anim_events.json" after)
if(NOT after STREQUAL events_text)
    message(FATAL_ERROR "roundtrip wrote the events file")
endif()
# Nothing the viewer did wrote a file.
file(GLOB written RELATIVE "${WORK}/assets" "${WORK}/assets/*")
list(SORT written)
if(NOT written STREQUAL "a.anim_events.json;a.fbx;asset_catalog.json")
    message(FATAL_ERROR "the asset root changed: ${written}")
endif()
