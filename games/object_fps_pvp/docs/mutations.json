{
 "version": 1,
 "description": "Declared mutants of the Object_FPS_PVP port (games/object_fps_pvp/docs/port-declaration.zh-Hant.md, section 4; ids pvp-). A mutant is killed only when the named test case fails with the expected message. Run: python3 tests/common/mutation/run_mutations.py --build-dir build/target/_build/test --catalog games/object_fps_pvp/docs/mutations.json",
 "mutants": [
  {
   "id": "pvp-jump-no-gravity",
   "what": "the fall keeps the jump's speed: the body never comes down",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/world/PvpWorld.cpp",
   "find": "body.verticalVelocity = fall.velocity;",
   "replace": "(void)fall.velocity;",
   "target": "gyo_object_fps_pvp_world_tests",
   "cases": "world: a jump*",
   "expect": "a jump rises"
  },
  {
   "id": "pvp-crouch-stands-anywhere",
   "what": "standing up does not ask for room",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/world/PvpWorld.cpp",
   "find": "if (*room) crouched = false;",
   "replace": "crouched = false;",
   "target": "gyo_object_fps_pvp_world_tests",
   "cases": "world: a crouched*",
   "expect": "a crouched player"
  },
  {
   "id": "pvp-shot-wall-ignored",
   "what": "the shot's ray does not look at the walls",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/world/PvpWorld.cpp",
   "find": "if (*wall && (!world || (*wall)->hit.t < *world)) world = (*wall)->hit.t;",
   "replace": "(void)wall;",
   "target": "gyo_object_fps_pvp_world_tests",
   "cases": "world: the pillar*",
   "expect": "the pillar stops a shot"
  },
  {
   "id": "pvp-tie-higher-id",
   "what": "players at one distance: the higher id wins",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/sim/CombatRules.cpp",
   "find": "candidate.player < closest.player",
   "replace": "candidate.player > closest.player",
   "target": "gyo_object_fps_pvp_logic_tests",
   "cases": "PvP combat rules: the shot's outcome*",
   "expect": "the shot's outcome"
  },
  {
   "id": "pvp-head-multiplier-ignored",
   "what": "a head hit deals the body's damage",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/sim/CombatRules.cpp",
   "find": "case HitPart::Head: permille = rules.headPermille; break;",
   "replace": "case HitPart::Head: permille = rules.bodyPermille; break;",
   "target": "gyo_object_fps_pvp_logic_tests",
   "cases": "PvP combat rules: the damage*",
   "expect": "the damage of each part"
  },
  {
   "id": "pvp-cooldown-ignored",
   "what": "a press in the cooldown fires",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/world/PvpWorld.cpp",
   "find": "now >= next.nextShotTick",
   "replace": "true",
   "target": "gyo_object_fps_pvp_world_tests",
   "cases": "world: a shot hits*",
   "expect": "the cooldown holds the next"
  },
  {
   "id": "pvp-spawn-nearest",
   "what": "the spawn nearest the enemies is chosen",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/sim/CombatRules.cpp",
   "find": "if (!selected || nearest > best) {",
   "replace": "if (!selected || nearest < best) {",
   "target": "gyo_object_fps_pvp_logic_tests",
   "cases": "PvP combat rules: the spawn*",
   "expect": "the spawn farthest"
  },
  {
   "id": "pvp-collider-origin-ignored",
   "what": "the unit conversion leaves out origin",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/data/VoxelMeshFile.cpp",
   "find": "const std::int64_t sum = std::int64_t{units[i]} + 16 * std::int64_t{file.origin[i]};",
   "replace": "const std::int64_t sum = std::int64_t{units[i]};",
   "target": "gyo_object_fps_pvp_logic_tests",
   "cases": "PvP voxel mesh:*",
   "expect": "units are 1/16 of a cell|pvp_arena's five colliders"
  },
  {
   "id": "pvp-no-input-moves",
   "what": "a player without input steers by its last input",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/world/PvpWorld.cpp",
   "find": "const bool steering = alive && input.present != 0;",
   "replace": "const bool steering = alive;",
   "target": "gyo_object_fps_pvp_world_tests",
   "cases": "world: a player without input*",
   "expect": "neither moves nor turns"
  },
  {
   "id": "pvp-respawn-early",
   "what": "a dead player comes back at once",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/world/PvpWorld.cpp",
   "find": "now < combat.respawnTick",
   "replace": "false",
   "target": "gyo_object_fps_pvp_world_tests",
   "cases": "world: a shot hits*",
   "expect": "the respawn is the farthest spawn"
  },
  {
   "id": "pvp-room-not-full",
   "what": "the admission never refuses",
   "guards": [
    "port-declaration 4"
   ],
   "file": "games/object_fps_pvp/src/world/PvpWorld.cpp",
   "find": "if (taken >= seats->capacity) {",
   "replace": "if (false) {",
   "target": "gyo_object_fps_pvp_world_tests",
   "cases": "world: a Client past the seats*",
   "expect": "past the seats is refused"
  }
 ]
}
