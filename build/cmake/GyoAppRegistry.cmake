# Application selection is data, independent of compilers and dependency fetches.
# Keep this module usable with `cmake -P` by CI and the registry tests.

function(_gyo_registry_json_quote value output)
    set(escaped "${value}")
    string(REPLACE "\\" "\\\\" escaped "${escaped}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    string(REPLACE "\n" "\\n" escaped "${escaped}")
    string(REPLACE "\r" "\\r" escaped "${escaped}")
    string(REPLACE "\t" "\\t" escaped "${escaped}")
    string(ASCII 8 backspace)
    string(ASCII 12 form_feed)
    string(REPLACE "${backspace}" "\\b" escaped "${escaped}")
    string(REPLACE "${form_feed}" "\\f" escaped "${escaped}")
    set(${output} "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(_gyo_registry_json_append array value output)
    string(JSON count LENGTH "${array}")
    string(JSON result SET "${array}" ${count} "${value}")
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

# Parse characters rather than CMake lists: both semicolons and line breaks
# are legal inside a CSV field, and empty fields must retain their positions.
function(_gyo_registry_csv_records path output)
    if(NOT EXISTS "${path}" OR IS_DIRECTORY "${path}")
        message(FATAL_ERROR "App registry does not exist: ${path}")
    endif()
    # CMake's text reader normalizes CRLF to LF, including quoted line breaks.
    file(READ "${path}" content)
    string(ASCII 239 187 191 bom)
    string(FIND "${content}" "${bom}" bom_position)
    if(bom_position EQUAL 0)
        string(SUBSTRING "${content}" 3 -1 content)
    endif()
    string(LENGTH "${content}" length)
    set(records "[]")
    set(row "[]")
    set(field "")
    set(state start)
    set(row_started FALSE)
    set(position 0)
    while(position LESS length)
        string(SUBSTRING "${content}" ${position} 1 character)
        math(EXPR next_position "${position} + 1")
        if(state STREQUAL "quoted")
            if(character STREQUAL "\"")
                set(next_character "")
                if(next_position LESS length)
                    string(SUBSTRING "${content}" ${next_position} 1 next_character)
                endif()
                if(next_character STREQUAL "\"")
                    string(APPEND field "\"")
                    math(EXPR position "${position} + 1")
                else()
                    set(state closed)
                endif()
            else()
                string(APPEND field "${character}")
            endif()
        elseif(character STREQUAL ",")
            _gyo_registry_json_quote("${field}" json_field)
            _gyo_registry_json_append("${row}" "${json_field}" row)
            set(field "")
            set(state start)
            set(row_started TRUE)
        elseif(character STREQUAL "\r" OR character STREQUAL "\n")
            # Ignore completely blank lines, but not rows containing empty cells.
            if(row_started)
                _gyo_registry_json_quote("${field}" json_field)
                _gyo_registry_json_append("${row}" "${json_field}" row)
                _gyo_registry_json_append("${records}" "${row}" records)
            endif()
            set(row "[]")
            set(field "")
            set(state start)
            set(row_started FALSE)
            if(character STREQUAL "\r" AND next_position LESS length)
                string(SUBSTRING "${content}" ${next_position} 1 next_character)
                if(next_character STREQUAL "\n")
                    math(EXPR position "${position} + 1")
                endif()
            endif()
        elseif(state STREQUAL "closed")
            message(FATAL_ERROR
                "Invalid app registry CSV: unexpected character after a quoted field at byte ${position}: ${path}")
        elseif(character STREQUAL "\"")
            if(NOT state STREQUAL "start")
                message(FATAL_ERROR
                    "Invalid app registry CSV: quote inside an unquoted field at byte ${position}: ${path}")
            endif()
            set(state quoted)
            set(row_started TRUE)
        else()
            string(APPEND field "${character}")
            set(state unquoted)
            set(row_started TRUE)
        endif()
        math(EXPR position "${position} + 1")
    endwhile()
    if(state STREQUAL "quoted")
        message(FATAL_ERROR "Invalid app registry CSV: unterminated quoted field: ${path}")
    endif()
    if(row_started)
        _gyo_registry_json_quote("${field}" json_field)
        _gyo_registry_json_append("${row}" "${json_field}" row)
        _gyo_registry_json_append("${records}" "${row}" records)
    endif()
    set(${output} "${records}" PARENT_SCOPE)
endfunction()

# JSON result: {"projects":[{"name":...,"description":...,"version":...,
#                           "enabled":bool,"windows":bool,"linux":bool,"macos":bool}]}
# Description and version remain opaque strings and never affect selection.
function(gyo_read_app_registry csv output)
    _gyo_registry_csv_records("${csv}" records)
    string(JSON record_count LENGTH "${records}")
    set(columns name description version enabled windows linux macos)
    if(record_count EQUAL 0)
        message(FATAL_ERROR "App registry is missing its header: ${csv}")
    endif()
    string(JSON column_count LENGTH "${records}" 0)
    if(NOT column_count EQUAL 7)
        message(FATAL_ERROR "App registry header must contain exactly 7 columns: ${csv}")
    endif()
    foreach(index RANGE 0 6)
        string(JSON actual GET "${records}" 0 ${index})
        list(GET columns ${index} expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR
                "App registry header column ${index} must be '${expected}', got '${actual}': ${csv}")
        endif()
    endforeach()

    set(projects "[]")
    set(names "")
    if(record_count GREATER 1)
        math(EXPR last_record "${record_count} - 1")
        foreach(record RANGE 1 ${last_record})
            string(JSON column_count LENGTH "${records}" ${record})
            math(EXPR display_record "${record} + 1")
            if(NOT column_count EQUAL 7)
                message(FATAL_ERROR
                    "App registry record ${display_record} must contain exactly 7 columns, got ${column_count}: ${csv}")
            endif()
            string(JSON name GET "${records}" ${record} 0)
            if(NOT name MATCHES "^[a-z][a-z0-9_]*$")
                message(FATAL_ERROR
                    "Invalid app name '${name}' in registry record ${display_record}; expected [a-z][a-z0-9_]*: ${csv}")
            endif()
            if(name STREQUAL "common" OR name STREQUAL "toolchain" OR name STREQUAL "ui_editor")
                message(FATAL_ERROR
                    "Reserved app name '${name}' conflicts with engine support or toolchain ownership: ${csv}")
            endif()
            if(name IN_LIST names)
                message(FATAL_ERROR "Duplicate app name '${name}' in registry: ${csv}")
            endif()
            list(APPEND names "${name}")
            set(project "{}")
            foreach(index RANGE 0 6)
                list(GET columns ${index} column)
                string(JSON value GET "${records}" ${record} ${index})
                if(index LESS 3)
                    _gyo_registry_json_quote("${value}" json_value)
                else()
                    string(TOLOWER "${value}" normalized)
                    if(normalized STREQUAL "true" OR normalized STREQUAL "1")
                        set(json_value true)
                    elseif(normalized STREQUAL "false" OR normalized STREQUAL "0")
                        set(json_value false)
                    else()
                        message(FATAL_ERROR
                            "Invalid boolean '${value}' for app '${name}' column '${column}'; expected true, false, 1 or 0: ${csv}")
                    endif()
                endif()
                string(JSON project SET "${project}" "${column}" "${json_value}")
            endforeach()
            _gyo_registry_json_append("${projects}" "${project}" projects)
        endforeach()
    endif()
    string(JSON registry SET "{}" projects "${projects}")
    set(${output} "${registry}" PARENT_SCOPE)
endfunction()

# AUTO selects all enabled apps supported by the target OS. An empty value
# deliberately selects no apps. Explicit subsets cannot bypass registry policy.
function(gyo_select_apps registry target_system selection output)
    if("${selection}" STREQUAL "")
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    if(target_system STREQUAL "Windows")
        set(platform windows)
    elseif(target_system STREQUAL "Linux")
        set(platform linux)
    elseif(target_system STREQUAL "Darwin")
        set(platform macos)
    else()
        message(FATAL_ERROR "Unsupported app target system '${target_system}'")
    endif()
    string(JSON count LENGTH "${registry}" projects)
    set(available "")
    set(enabled_names "")
    set(supported_names "")
    set(selected "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${registry}" projects ${index} name)
            string(JSON enabled GET "${registry}" projects ${index} enabled)
            string(JSON supported GET "${registry}" projects ${index} ${platform})
            list(APPEND available "${name}")
            if(enabled)
                list(APPEND enabled_names "${name}")
            endif()
            if(supported)
                list(APPEND supported_names "${name}")
            endif()
            if(selection STREQUAL "AUTO" AND enabled AND supported)
                list(APPEND selected "${name}")
            endif()
        endforeach()
    endif()
    if(NOT selection STREQUAL "AUTO")
        set(selected "")
        foreach(name IN LISTS selection)
            if(NOT name IN_LIST available)
                message(FATAL_ERROR "Requested app '${name}' is not registered")
            endif()
            if(NOT name IN_LIST enabled_names)
                message(FATAL_ERROR "Requested app '${name}' is disabled in the registry")
            endif()
            if(NOT name IN_LIST supported_names)
                message(FATAL_ERROR "Requested app '${name}' is not enabled for target ${target_system}")
            endif()
            if(name IN_LIST selected)
                message(FATAL_ERROR "Requested app '${name}' appears more than once in the selection")
            endif()
            list(APPEND selected "${name}")
        endforeach()
    endif()
    set(${output} "${selected}" PARENT_SCOPE)
endfunction()

function(gyo_validate_app_sources root)
    foreach(name IN LISTS ARGN)
        if(NOT name MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "Invalid selected app name '${name}'")
        endif()
        set(directory "${root}/apps/${name}")
        if(NOT IS_DIRECTORY "${directory}" OR NOT EXISTS "${directory}/CMakeLists.txt" OR
           IS_DIRECTORY "${directory}/CMakeLists.txt")
            message(FATAL_ERROR "Selected app '${name}' requires ${directory}/CMakeLists.txt")
        endif()
    endforeach()
endfunction()

function(gyo_export_app_matrix registry output)
    set(entries "[]")
    string(JSON count LENGTH "${registry}" projects)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON enabled GET "${registry}" projects ${index} enabled)
            if(NOT enabled)
                continue()
            endif()
            string(JSON name GET "${registry}" projects ${index} name)
            foreach(platform IN ITEMS windows linux macos)
                string(JSON supported GET "${registry}" projects ${index} ${platform})
                if(NOT supported)
                    continue()
                endif()
                if(platform STREQUAL "macos")
                    set(matrix_platform macos-arm64)
                else()
                    set(matrix_platform "${platform}-x64")
                endif()
                _gyo_registry_json_quote("${name}" json_name)
                _gyo_registry_json_quote("${matrix_platform}" json_platform)
                string(JSON entry SET "{}" app "${json_name}")
                string(JSON entry SET "${entry}" platform "${json_platform}")
                _gyo_registry_json_append("${entries}" "${entry}" entries)
            endforeach()
        endforeach()
    endif()
    string(JSON matrix SET "{}" include "${entries}")
    set(${output} "${matrix}" PARENT_SCOPE)
endfunction()
