# Game selection is data, independent of compilers and dependency fetches.
# Keep this module usable with `cmake -P` by CI and the registry tests.
include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GyoRegistryCsv.cmake")

function(gyo_read_game_registry csv output)
    _gyo_read_registry("${csv}" game games "name;description;version;enabled;windows;linux;macos" data)
    set(${output} "${data}" PARENT_SCOPE)
endfunction()

# AUTO selects all enabled games supported by the target OS. An empty value
# deliberately selects no games. Explicit subsets cannot bypass registry policy.
function(gyo_select_games registry target_system selection output)
    if("${selection}" STREQUAL "")
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    if(target_system STREQUAL "Windows")
        set(platform windows)
    elseif(target_system STREQUAL "Linux")
        set(platform linux)
    elseif(target_system STREQUAL "Darwin")
        set(platform macos)
    else()
        message(FATAL_ERROR "Unsupported game target system '${target_system}'")
    endif()
    string(JSON count LENGTH "${registry}" games)
    set(available "")
    set(enabled_names "")
    set(supported_names "")
    set(selected "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${registry}" games ${index} name)
            string(JSON enabled GET "${registry}" games ${index} enabled)
            string(JSON supported GET "${registry}" games ${index} ${platform})
            list(APPEND available "${name}")
            if(enabled)
                list(APPEND enabled_names "${name}")
            endif()
            if(supported)
                list(APPEND supported_names "${name}")
            endif()
            if(selection STREQUAL "AUTO" AND enabled AND supported)
                list(APPEND selected "${name}")
            endif()
        endforeach()
    endif()
    if(NOT selection STREQUAL "AUTO")
        set(selected "")
        foreach(name IN LISTS selection)
            if(NOT name IN_LIST available)
                message(FATAL_ERROR "Requested game '${name}' is not registered")
            endif()
            if(NOT name IN_LIST enabled_names)
                message(FATAL_ERROR "Requested game '${name}' is disabled in the registry")
            endif()
            if(NOT name IN_LIST supported_names)
                message(FATAL_ERROR "Requested game '${name}' is not enabled for target ${target_system}")
            endif()
            if(name IN_LIST selected)
                message(FATAL_ERROR "Requested game '${name}' appears more than once in the selection")
            endif()
            list(APPEND selected "${name}")
        endforeach()
    endif()
    set(${output} "${selected}" PARENT_SCOPE)
endfunction()

function(gyo_validate_game_sources root)
    foreach(name IN LISTS ARGN)
        if(NOT name MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "Invalid selected game name '${name}'")
        endif()
        set(directory "${root}/games/${name}")
        if(NOT IS_DIRECTORY "${directory}" OR NOT EXISTS "${directory}/CMakeLists.txt" OR
           IS_DIRECTORY "${directory}/CMakeLists.txt")
            message(FATAL_ERROR "Selected game '${name}' requires ${directory}/CMakeLists.txt")
        endif()
    endforeach()
endfunction()

# Returns the release package platforms a registered game supports, whether or
# not it is enabled; an unregistered name is an error.
function(gyo_game_registry_package_platforms registry name output)
    string(JSON count LENGTH "${registry}" games)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON candidate GET "${registry}" games ${index} name)
            if(NOT candidate STREQUAL name)
                continue()
            endif()
            set(platforms "")
            foreach(platform IN ITEMS windows linux macos)
                string(JSON supported GET "${registry}" games ${index} ${platform})
                if(supported)
                    _gyo_registry_package_platforms("${platform}" package_platforms)
                    list(APPEND platforms ${package_platforms})
                endif()
            endforeach()
            set(${output} "${platforms}" PARENT_SCOPE)
            return()
        endforeach()
    endif()
    message(FATAL_ERROR "Game '${name}' is not registered")
endfunction()

function(gyo_export_game_matrix registry output)
    set(entries "[]")
    string(JSON count LENGTH "${registry}" games)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON enabled GET "${registry}" games ${index} enabled)
            if(NOT enabled)
                continue()
            endif()
            string(JSON name GET "${registry}" games ${index} name)
            foreach(platform IN ITEMS windows linux macos)
                string(JSON supported GET "${registry}" games ${index} ${platform})
                if(NOT supported)
                    continue()
                endif()
                _gyo_registry_package_platforms("${platform}" matrix_platforms)
                _gyo_registry_json_quote("${name}" json_name)
                foreach(matrix_platform IN LISTS matrix_platforms)
                    _gyo_registry_json_quote("${matrix_platform}" json_platform)
                    string(JSON entry SET "{}" game "${json_name}")
                    string(JSON entry SET "${entry}" platform "${json_platform}")
                    _gyo_registry_json_append("${entries}" "${entry}" entries)
                endforeach()
            endforeach()
        endforeach()
    endif()
    string(JSON matrix SET "{}" include "${entries}")
    set(${output} "${matrix}" PARENT_SCOPE)
endfunction()
