cmake_minimum_required(VERSION 3.30)
file(READ "${GYO_PRODUCT_MANIFEST}" manifest)
string(JSON count LENGTH "${manifest}" executables)
set(paths "")
if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON role MEMBER "${manifest}" executables ${index})
        string(JSON path GET "${manifest}" executables "${role}" path)
        if(WIN32)
            string(TOLOWER "${path}" path)
        endif()
        if(path IN_LIST paths)
            message(FATAL_ERROR "Product executable output collision: ${role} -> ${path}")
        endif()
        list(APPEND paths "${path}")
    endforeach()
endif()
string(JSON count LENGTH "${manifest}" native_files)
if(count GREATER 0)
    math(EXPR last "${count}-1")
    foreach(index RANGE 0 ${last})
        string(JSON path GET "${manifest}" native_files ${index})
        if(WIN32)
            string(TOLOWER "${path}" path)
        endif()
        if(path IN_LIST paths)
            message(FATAL_ERROR "Native library overwrites a product executable: ${path}")
        endif()
    endforeach()
endif()
