include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GyoAppRegistry.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GyoComponents.cmake")

function(gyo_read_tool_registry csv output)
    _gyo_read_registry("${csv}" tool tools
        "name;description;version;enabled;default;release;windows;linux;macos" data)
    set(${output} "${data}" PARENT_SCOPE)
endfunction()

function(gyo_validate_registry_owners apps tools)
    string(JSON count LENGTH "${apps}" projects)
    set(owners "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${apps}" projects ${index} name)
            list(APPEND owners "${name}")
        endforeach()
    endif()
    string(JSON count LENGTH "${tools}" tools)
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${tools}" tools ${index} name)
            if(name IN_LIST owners)
                message(FATAL_ERROR "App/tool owner collision: '${name}' is registered in both registries")
            endif()
        endforeach()
    endif()
endfunction()

function(gyo_select_tools registry target_system selection output)
    if("${selection}" STREQUAL "")
        set(${output} "" PARENT_SCOPE)
        return()
    endif()
    if(target_system STREQUAL "Windows")
        set(platform windows)
    elseif(target_system STREQUAL "Linux")
        set(platform linux)
    elseif(target_system STREQUAL "Darwin")
        set(platform macos)
    else()
        message(FATAL_ERROR "Unsupported tool target system '${target_system}'")
    endif()
    string(JSON count LENGTH "${registry}" tools)
    set(names "")
    set(enabled_names "")
    set(supported_names "")
    set(selected "")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON name GET "${registry}" tools ${index} name)
            string(JSON enabled GET "${registry}" tools ${index} enabled)
            string(JSON supported GET "${registry}" tools ${index} ${platform})
            string(JSON default GET "${registry}" tools ${index} default)
            list(APPEND names "${name}")
            if(enabled)
                list(APPEND enabled_names "${name}")
            endif()
            if(supported)
                list(APPEND supported_names "${name}")
            endif()
            if(selection STREQUAL "AUTO" AND default AND enabled AND supported)
                list(APPEND selected "${name}")
            endif()
        endforeach()
    endif()
    if(NOT selection STREQUAL "AUTO")
        set(selected_names "")
        foreach(entry IN LISTS selection)
            if(NOT entry MATCHES "^([a-z][a-z0-9_]*)(:([a-z][a-z0-9_]*))?$")
                message(FATAL_ERROR "Invalid tool selection '${entry}'; expected id[:variant]")
            endif()
            set(name "${CMAKE_MATCH_1}")
            if(NOT name IN_LIST names)
                message(FATAL_ERROR "Requested tool '${name}' is not registered")
            endif()
            if(NOT name IN_LIST enabled_names)
                message(FATAL_ERROR "Requested tool '${name}' is disabled in the registry")
            endif()
            if(NOT name IN_LIST supported_names)
                message(FATAL_ERROR "Requested tool '${name}' is not enabled for target ${target_system}")
            endif()
            if(name IN_LIST selected_names)
                message(FATAL_ERROR "Requested tool '${name}' appears more than once in the selection")
            endif()
            list(APPEND selected_names "${name}")
            list(APPEND selected "${entry}")
        endforeach()
    endif()
    set(${output} "${selected}" PARENT_SCOPE)
endfunction()

function(_gyo_tool_json_type data expected file)
    string(JSON actual ERROR_VARIABLE error TYPE "${data}" ${ARGN})
    if(error OR NOT actual STREQUAL expected)
        message(FATAL_ERROR "Tool metadata '${ARGN}' must be ${expected}: ${file}")
    endif()
endfunction()

# Returns only the selected variant and app dependency data. Reading descriptors
# never runs tool CMake, so registry export needs no compiler or dependencies.
function(gyo_read_tool_project file requested_variant output)
    if(NOT EXISTS "${file}" OR IS_DIRECTORY "${file}")
        message(FATAL_ERROR "Missing tool metadata: ${file}")
    endif()
    file(READ "${file}" data)
    _gyo_tool_json_type("${data}" OBJECT "${file}")
    _gyo_tool_json_type("${data}" NUMBER "${file}" version)
    string(JSON version GET "${data}" version)
    if(NOT "${version}" STREQUAL "1")
        message(FATAL_ERROR "Unsupported tool metadata version: ${file}")
    endif()
    _gyo_tool_json_type("${data}" STRING "${file}" default_variant)
    _gyo_tool_json_type("${data}" OBJECT "${file}" variants)
    _gyo_tool_json_type("${data}" OBJECT "${file}" requires_apps)
    string(JSON default GET "${data}" default_variant)
    if(NOT default MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Invalid default tool variant '${default}': ${file}")
    endif()
    string(JSON default_type ERROR_VARIABLE error TYPE "${data}" variants "${default}")
    if(error)
        message(FATAL_ERROR "Default tool variant '${default}' is not declared: ${file}")
    endif()
    string(JSON dependencies GET "${data}" requires_apps)
    string(JSON dependency_count LENGTH "${dependencies}")
    if(dependency_count GREATER 0)
        math(EXPR last "${dependency_count} - 1")
        foreach(index RANGE 0 ${last})
            string(JSON alias MEMBER "${dependencies}" ${index})
            _gyo_tool_json_type("${dependencies}" STRING "${file}" "${alias}")
            string(JSON app GET "${dependencies}" "${alias}")
            if(NOT alias MATCHES "^[a-z][a-z0-9_]*$" OR NOT app MATCHES "^[a-z][a-z0-9_]*$")
                message(FATAL_ERROR "Invalid tool app dependency '${alias}=${app}': ${file}")
            endif()
        endforeach()
    endif()
    string(JSON count LENGTH "${data}" variants)
    if(count LESS 1)
        message(FATAL_ERROR "Tool metadata requires at least one variant: ${file}")
    endif()
    math(EXPR last "${count} - 1")
    foreach(index RANGE 0 ${last})
        string(JSON variant MEMBER "${data}" variants ${index})
        if(NOT variant MATCHES "^[a-z][a-z0-9_]*$")
            message(FATAL_ERROR "Invalid tool variant '${variant}': ${file}")
        endif()
        _gyo_tool_json_type("${data}" OBJECT "${file}" variants "${variant}")
        _gyo_tool_json_type("${data}" ARRAY "${file}" variants "${variant}" components)
        _gyo_tool_json_type("${data}" BOOLEAN "${file}" variants "${variant}" packageable)
        string(JSON component_count LENGTH "${data}" variants "${variant}" components)
        set(variant_components "")
        if(component_count GREATER 0)
            math(EXPR component_last "${component_count} - 1")
            foreach(component_index RANGE 0 ${component_last})
                _gyo_tool_json_type("${data}" STRING "${file}" variants "${variant}" components ${component_index})
                string(JSON component GET "${data}" variants "${variant}" components ${component_index})
                gyo_validate_components("${component}")
                list(APPEND variant_components "${component}")
            endforeach()
        endif()
        string(JSON role_type ERROR_VARIABLE no_roles TYPE "${data}" variants "${variant}" role_components)
        if(NOT no_roles)
            _gyo_tool_json_type("${data}" OBJECT "${file}" variants "${variant}" role_components)
            string(JSON role_count LENGTH "${data}" variants "${variant}" role_components)
            if(role_count GREATER 0)
                math(EXPR role_last "${role_count} - 1")
                foreach(role_index RANGE 0 ${role_last})
                    string(JSON role MEMBER "${data}" variants "${variant}" role_components ${role_index})
                    if(NOT role MATCHES "^[a-z][a-z0-9_]*$")
                        message(FATAL_ERROR "Invalid tool role '${role}': ${file}")
                    endif()
                    _gyo_tool_json_type("${data}" ARRAY "${file}" variants "${variant}" role_components "${role}")
                    string(JSON role_component_count LENGTH "${data}" variants "${variant}" role_components "${role}")
                    if(role_component_count GREATER 0)
                        math(EXPR role_component_last "${role_component_count} - 1")
                        foreach(component_index RANGE 0 ${role_component_last})
                            _gyo_tool_json_type("${data}" STRING "${file}" variants "${variant}" role_components "${role}" ${component_index})
                            string(JSON component GET "${data}" variants "${variant}" role_components "${role}" ${component_index})
                            gyo_validate_components("${component}")
                            if(NOT component IN_LIST variant_components)
                                message(FATAL_ERROR "Tool role '${role}' component '${component}' is not declared by variant '${variant}': ${file}")
                            endif()
                        endforeach()
                    endif()
                endforeach()
            endif()
        endif()
        string(JSON packageable GET "${data}" variants "${variant}" packageable)
        if(packageable AND dependency_count GREATER 0)
            message(FATAL_ERROR "Packageable tool variant '${variant}' cannot depend on apps: ${file}")
        endif()
    endforeach()
    if("${requested_variant}" STREQUAL "")
        set(requested_variant "${default}")
    endif()
    string(JSON result ERROR_VARIABLE error GET "${data}" variants "${requested_variant}")
    if(error)
        message(FATAL_ERROR "Unknown tool variant '${requested_variant}': ${file}")
    endif()
    _gyo_registry_json_quote("${requested_variant}" json_variant)
    string(JSON result SET "${result}" variant "${json_variant}")
    string(JSON result SET "${result}" requires_apps "${dependencies}")
    set(${output} "${result}" PARENT_SCOPE)
endfunction()

function(gyo_export_tool_matrix registry root output)
    set(entries "[]")
    string(JSON count LENGTH "${registry}" tools)
    foreach(platform windows linux macos)
        set(tools "[]")
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON enabled GET "${registry}" tools ${index} enabled)
                string(JSON release GET "${registry}" tools ${index} release)
                string(JSON supported GET "${registry}" tools ${index} ${platform})
                if(NOT enabled OR NOT release OR NOT supported)
                    continue()
                endif()
                string(JSON name GET "${registry}" tools ${index} name)
                gyo_read_tool_project("${root}/tools/${name}/project.json" "" metadata)
                string(JSON packageable GET "${metadata}" packageable)
                if(NOT packageable)
                    message(FATAL_ERROR "Release tool '${name}' default variant is not packageable")
                endif()
                string(JSON variant GET "${metadata}" variant)
                _gyo_registry_json_quote("${name}:${variant}" json_selection)
                _gyo_registry_json_append("${tools}" "${json_selection}" tools)
            endforeach()
        endif()
        string(JSON selected_count LENGTH "${tools}")
        if(selected_count EQUAL 0)
            message(FATAL_ERROR "No release tools selected for ${platform}")
        endif()
        if(platform STREQUAL "macos")
            set(matrix_platform macos-arm64)
        else()
            set(matrix_platform "${platform}-x64")
        endif()
        _gyo_registry_json_quote("${matrix_platform}" json_platform)
        string(JSON entry SET "{}" platform "${json_platform}")
        string(JSON entry SET "${entry}" tools "${tools}")
        _gyo_registry_json_append("${entries}" "${entry}" entries)
    endforeach()
    string(JSON matrix SET "{}" include "${entries}")
    set(${output} "${matrix}" PARENT_SCOPE)
endfunction()
