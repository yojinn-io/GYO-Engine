include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GyoToolRegistry.cmake")

function(gyo_configure_tools)
    set(GYO_TOOLS "" CACHE STRING "Empty selects no tools; AUTO selects defaults; otherwise id[:variant] entries")
    set(GYO_TOOL_REGISTRY_FILE "${GYO_REPOSITORY_ROOT}/engine/config/tools.csv" CACHE FILEPATH "Tool build selection registry")
    set(components "${GYO_REQUESTED_COMPONENTS}")
    set(selected "")
    # A minimal game copy need not carry a tool registry or any tool sources.
    if(EXISTS "${GYO_TOOL_REGISTRY_FILE}" OR NOT "${GYO_TOOLS}" STREQUAL "")
        set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GYO_TOOL_REGISTRY_FILE}")
        gyo_read_tool_registry("${GYO_TOOL_REGISTRY_FILE}" registry)
        if(DEFINED GYO_APP_REGISTRY_DATA)
            gyo_validate_registry_owners("${GYO_APP_REGISTRY_DATA}" "${registry}")
        endif()
        gyo_select_tools("${registry}" "${CMAKE_SYSTEM_NAME}" "${GYO_TOOLS}" selections)
        foreach(entry IN LISTS selections)
            string(REPLACE ":" ";" parts "${entry}")
            list(GET parts 0 tool)
            list(LENGTH parts count)
            set(variant "")
            if(count EQUAL 2)
                list(GET parts 1 variant)
            endif()
            set(directory "${GYO_REPOSITORY_ROOT}/tools/${tool}")
            if(NOT EXISTS "${directory}/CMakeLists.txt" OR IS_DIRECTORY "${directory}/CMakeLists.txt")
                message(FATAL_ERROR "Selected tool '${tool}' requires ${directory}/CMakeLists.txt")
            endif()
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${directory}/project.json")
            gyo_read_tool_project("${directory}/project.json" "${variant}" metadata)
            string(JSON variant GET "${metadata}" variant)
            string(JSON packageable GET "${metadata}" packageable)
            string(JSON dependencies GET "${metadata}" requires_apps)
            string(JSON dependency_count LENGTH "${dependencies}")
            if(dependency_count GREATER 0)
                math(EXPR last "${dependency_count} - 1")
                foreach(index RANGE 0 ${last})
                    string(JSON alias MEMBER "${dependencies}" ${index})
                    string(JSON app GET "${dependencies}" "${alias}")
                    if(NOT app IN_LIST GYO_ACTIVE_APPS)
                        message(FATAL_ERROR "Tool '${tool}' dependency '${alias}' requires selected app '${app}'; select it through projects.csv and GYO_APPS")
                    endif()
                endforeach()
            endif()
            string(JSON component_count LENGTH "${metadata}" components)
            set(tool_components "")
            if(component_count GREATER 0)
                math(EXPR last "${component_count} - 1")
                foreach(index RANGE 0 ${last})
                    string(JSON component GET "${metadata}" components ${index})
                    list(APPEND tool_components "${component}")
                endforeach()
            endif()
            set_property(GLOBAL PROPERTY GYO_TOOL_${tool}_VARIANT "${variant}")
            set_property(GLOBAL PROPERTY GYO_TOOL_${tool}_COMPONENTS "${tool_components}")
            string(JSON role_components ERROR_VARIABLE no_roles GET "${metadata}" role_components)
            if(no_roles)
                set(role_components "{}")
            endif()
            set_property(GLOBAL PROPERTY GYO_TOOL_${tool}_ROLE_COMPONENTS "${role_components}")
            set_property(GLOBAL PROPERTY GYO_TOOL_${tool}_PACKAGEABLE "${packageable}")
            set_property(GLOBAL PROPERTY GYO_TOOL_${tool}_REQUIRES_APPS "${dependencies}")
            list(APPEND selected "${tool}")
            list(APPEND components ${tool_components})
        endforeach()
    endif()
    list(REMOVE_DUPLICATES components)
    set(GYO_ACTIVE_TOOLS "${selected}" PARENT_SCOPE)
    set(GYO_REQUESTED_COMPONENTS "${components}" PARENT_SCOPE)
    message(STATUS "GYO tools: target=${CMAKE_SYSTEM_NAME}, selected=[${selected}]")
endfunction()

function(gyo_tool_app_dependency alias output)
    if(NOT GYO_CURRENT_TOOL)
        message(FATAL_ERROR "Tool dependency lookup requires a selected tool owner")
    endif()
    get_property(dependencies GLOBAL PROPERTY GYO_TOOL_${GYO_CURRENT_TOOL}_REQUIRES_APPS)
    string(JSON app ERROR_VARIABLE error GET "${dependencies}" "${alias}")
    if(error)
        message(FATAL_ERROR "Tool '${GYO_CURRENT_TOOL}' has no app dependency '${alias}'")
    endif()
    set(${output} "${app}" PARENT_SCOPE)
endfunction()

# The descriptor owns deployment components and whether a target is releasable.
# Local tools use a separate output root and never register installed products.
function(gyo_tool_install_target)
    cmake_parse_arguments(PARSE_ARGV 0 ARG "" "TARGET;ROLE" "")
    if(ARG_UNPARSED_ARGUMENTS OR NOT ARG_TARGET OR NOT ARG_ROLE OR NOT GYO_CURRENT_TOOL)
        message(FATAL_ERROR "gyo_tool_install_target requires TARGET and ROLE in a selected tool")
    endif()
    if(NOT ARG_ROLE MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "Invalid tool executable role '${ARG_ROLE}'")
    endif()
    get_property(existing GLOBAL PROPERTY GYO_TOOL_${GYO_CURRENT_TOOL}_ROLE_${ARG_ROLE})
    if(existing)
        message(FATAL_ERROR "Duplicate tool role '${GYO_CURRENT_TOOL}:${ARG_ROLE}'")
    endif()
    set_property(GLOBAL PROPERTY GYO_TOOL_${GYO_CURRENT_TOOL}_ROLE_${ARG_ROLE} "${ARG_TARGET}")
    get_property(packageable GLOBAL PROPERTY GYO_TOOL_${GYO_CURRENT_TOOL}_PACKAGEABLE)
    get_property(components GLOBAL PROPERTY GYO_TOOL_${GYO_CURRENT_TOOL}_COMPONENTS)
    get_property(role_components GLOBAL PROPERTY GYO_TOOL_${GYO_CURRENT_TOOL}_ROLE_COMPONENTS)
    string(JSON count ERROR_VARIABLE no_override LENGTH "${role_components}" "${ARG_ROLE}")
    if(NOT no_override)
        set(components "")
        if(count GREATER 0)
            math(EXPR last "${count} - 1")
            foreach(index RANGE 0 ${last})
                string(JSON component GET "${role_components}" "${ARG_ROLE}" ${index})
                list(APPEND components "${component}")
            endforeach()
        endif()
    endif()
    if(packageable)
        gyo_install_product_target(TARGET ${ARG_TARGET} PRODUCT toolchain KIND toolchain
            OWNER "${GYO_CURRENT_TOOL}" ROLE "${ARG_ROLE}" COMPONENTS ${components})
    else()
        set(output "${GYO_OUTPUT_ROOT}/_tools/${GYO_CURRENT_TOOL}/bin")
        set_target_properties(${ARG_TARGET} PROPERTIES RUNTIME_OUTPUT_DIRECTORY "${output}")
        foreach(config DEBUG RELEASE RELWITHDEBINFO MINSIZEREL)
            set_target_properties(${ARG_TARGET} PROPERTIES RUNTIME_OUTPUT_DIRECTORY_${config} "${output}")
        endforeach()
        gyo_copy_runtime_dlls(${ARG_TARGET})
    endif()
endfunction()
