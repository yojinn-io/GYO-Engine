include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GyoComponents.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GyoAppRegistry.cmake")

# Read data before composing dependencies, never execute app CMake for discovery.
function(gyo_read_project file output)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "Missing project metadata: ${file}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" data)
    string(JSON version GET "${data}" version)
    if(NOT version EQUAL 1)
        message(FATAL_ERROR "Unsupported project metadata version: ${file}")
    endif()
    string(JSON count LENGTH "${data}" components)
    set(components "")
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON component GET "${data}" components ${index})
            list(APPEND components "${component}")
        endforeach()
    endif()
    gyo_validate_components(${components})
    set(${output} "${components}" PARENT_SCOPE)
endfunction()

function(gyo_configure_apps)
    set(GYO_APPS AUTO CACHE STRING "AUTO selects enabled CSV games; empty selects none; otherwise an enabled subset")
    set(GYO_REGISTRY_FILE "${GYO_REPOSITORY_ROOT}/engine/config/projects.csv" CACHE FILEPATH "Game build selection registry")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GYO_REGISTRY_FILE}")
    gyo_read_app_registry("${GYO_REGISTRY_FILE}" data)
    gyo_select_apps("${data}" "${CMAKE_SYSTEM_NAME}" "${GYO_APPS}" selected)
    gyo_validate_app_sources("${GYO_REPOSITORY_ROOT}" ${selected})
    set(components "")
    foreach(app IN LISTS selected)
        gyo_read_project("${GYO_REPOSITORY_ROOT}/apps/${app}/project.json" requested)
        set_property(GLOBAL PROPERTY GYO_APP_${app}_COMPONENTS "${requested}")
        list(APPEND components ${requested})
    endforeach()
    if(GYO_BUILD_UI_EDITOR)
        gyo_read_project("${GYO_REPOSITORY_ROOT}/tools/ui_editor/project.json" requested)
        if(NOT DEFINED GYO_UI_EDITOR_BUILD_GUI OR GYO_UI_EDITOR_BUILD_GUI)
            list(APPEND components ${requested})
        endif()
    endif()
    if(BUILD_TESTING)
        include("${GYO_REPOSITORY_ROOT}/tests/common/Requirements.cmake")
        list(APPEND components ${GYO_COMMON_TEST_COMPONENTS})
    endif()
    list(REMOVE_DUPLICATES components)
    set(GYO_ACTIVE_APPS "${selected}" PARENT_SCOPE)
    set(GYO_REQUESTED_COMPONENTS "${components}" PARENT_SCOPE)
    message(STATUS "GYO games: target=${CMAKE_SYSTEM_NAME}, selected=[${selected}], components=[${components}]")
endfunction()
