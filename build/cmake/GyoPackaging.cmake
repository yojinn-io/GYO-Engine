include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GyoAcceptance.cmake")

function(_gyo_package_quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    string(REPLACE "\n" "\\n" value "${value}")
    string(REPLACE "\r" "\\r" value "${value}")
    string(REPLACE "\t" "\\t" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

function(_gyo_package_array variable output)
    set(array "[]")
    set(index 0)
    foreach(value IN LISTS ${variable})
        _gyo_package_quote("${value}" quoted)
        string(JSON array SET "${array}" ${index} "${quoted}")
        math(EXPR index "${index}+1")
    endforeach()
    set(${output} "${array}" PARENT_SCOPE)
endfunction()

function(_gyo_package_platform output)
    set(architecture "${CMAKE_SYSTEM_PROCESSOR}")
    if(MSVC AND CMAKE_CXX_COMPILER_ARCHITECTURE_ID)
        set(architecture "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
    elseif(APPLE AND CMAKE_OSX_ARCHITECTURES)
        set(architecture "${CMAKE_OSX_ARCHITECTURES}")
    endif()
    string(TOLOWER "${architecture}" architecture)
    if(CMAKE_SYSTEM_NAME STREQUAL Windows AND architecture MATCHES "^(x64|amd64|x86_64)$")
        set(platform windows-x64)
    elseif(CMAKE_SYSTEM_NAME STREQUAL Linux AND architecture MATCHES "^(x64|amd64|x86_64)$")
        set(platform linux-x64)
    elseif(CMAKE_SYSTEM_NAME STREQUAL Darwin AND architecture MATCHES "^(arm64|aarch64)$")
        set(platform macos-arm64)
    else()
        message(FATAL_ERROR "No package platform for ${CMAKE_SYSTEM_NAME}/${architecture}; supported targets are Windows x64, Linux x64 and macOS ARM64")
    endif()
    set(${output} "${platform}" PARENT_SCOPE)
endfunction()

function(gyo_finalize_product_packages)
    if(NOT GYO_ENABLE_PACKAGING)
        return()
    endif()
    _gyo_package_platform(platform)
    get_property(tool_owners GLOBAL PROPERTY GYO_PRODUCT_toolchain_OWNERS)
    foreach(tool IN LISTS GYO_ACTIVE_TOOLS)
        get_property(packageable GLOBAL PROPERTY GYO_TOOL_${tool}_PACKAGEABLE)
        if(packageable AND NOT tool IN_LIST tool_owners)
            message(FATAL_ERROR "Selected packageable tool '${tool}' did not register a product executable")
        endif()
    endforeach()
    get_property(products GLOBAL PROPERTY GYO_PRODUCTS)
    foreach(product IN LISTS products)
        get_property(kind GLOBAL PROPERTY GYO_PRODUCT_${product}_KIND)
        get_property(targets GLOBAL PROPERTY GYO_PRODUCT_${product}_TARGETS)
        set(manifest "{\"schema_version\":3,\"executables\":{},\"checks\":[],\"native_files\":[]}")
        string(JSON manifest SET "${manifest}" configuration "\"$<IF:$<BOOL:$<CONFIG>>,$<CONFIG>,Unspecified>\"")
        foreach(field product kind platform)
            _gyo_package_quote("${${field}}" quoted)
            string(JSON manifest SET "${manifest}" "${field}" "${quoted}")
        endforeach()
        set(required "")
        set(identities "")
        foreach(target IN LISTS targets)
            get_target_property(owner ${target} GYO_PRODUCT_OWNER)
            get_target_property(role ${target} GYO_PRODUCT_ROLE)
            get_target_property(components ${target} GYO_PRODUCT_COMPONENTS)
            set(identity "${owner}.${role}")
            if(NOT owner MATCHES "^[a-z][a-z0-9_]*$" OR NOT role MATCHES "^[a-z][a-z0-9_]*$" OR identity IN_LIST identities)
                message(FATAL_ERROR "Duplicate or invalid product executable owner/role: ${identity}")
            endif()
            list(APPEND identities "${identity}")
            set(executable "bin/$<TARGET_FILE_NAME:${target}>")
            set(entry "{\"runtime_dependencies\":[]}")
            foreach(field owner role)
                _gyo_package_quote("${${field}}" quoted)
                string(JSON entry SET "${entry}" "${field}" "${quoted}")
            endforeach()
            _gyo_package_quote("${executable}" quoted)
            string(JSON entry SET "${entry}" path "${quoted}")
            foreach(component IN LISTS components)
                if(component MATCHES "^SDL_" OR component STREQUAL IMGUI)
                    string(JSON entry SET "${entry}" runtime_dependencies "[\"SDL3\"]")
                    break()
                endif()
            endforeach()
            string(JSON manifest SET "${manifest}" executables "${identity}" "${entry}")
            list(APPEND required "${executable}")
            get_property(content TARGET ${target} PROPERTY GYO_PRODUCT_REQUIRED_FILES)
            list(APPEND required ${content})
        endforeach()
        list(REMOVE_DUPLICATES required)
        _gyo_package_array(required required_json)
        string(JSON manifest SET "${manifest}" required_files "${required_json}")
        get_property(native GLOBAL PROPERTY GYO_PRODUCT_${product}_NATIVE_FILES)
        list(REMOVE_DUPLICATES native)
        string(JSON manifest SET "${manifest}" native_files "\"__GYO_NATIVE_FILES__\"")
        gyo_collect_product_acceptance("${product}" "${kind}" "${platform}" "${manifest}" checks owners replacements)
        string(JSON manifest SET "${manifest}" checks "${checks}")
        set(output "${PROJECT_BINARY_DIR}/packages/${product}/$<IF:$<BOOL:$<CONFIG>>,$<CONFIG>,Unspecified>/manifest.json")
        install(FILES "${output}" DESTINATION "share/gyo/products/${product}" COMPONENT "${product}")

        set(context "{\"schema_version\":1}")
        foreach(field product platform)
            _gyo_package_quote("${${field}}" quoted)
            string(JSON context SET "${context}" "${field}" "${quoted}")
        endforeach()
        string(JSON context SET "${context}" configuration "\"$<IF:$<BOOL:$<CONFIG>>,$<CONFIG>,Unspecified>\"")
        string(JSON context SET "${context}" manifest "${manifest}")
        string(JSON context SET "${context}" owners "${owners}")
        set(native "$<FILTER:$<REMOVE_DUPLICATES:${native}>,EXCLUDE,^$>")
        set(native_json "[$<$<BOOL:${native}>:\"$<JOIN:${native},\",\">\">]")
        string(REPLACE "\"__GYO_NATIVE_FILES__\"" "${native_json}" manifest "${manifest}")
        string(REPLACE "\"__GYO_NATIVE_FILES__\"" "${native_json}" context "${context}")
        file(GENERATE OUTPUT "${output}" CONTENT "${manifest}\n")
        foreach(replacement IN LISTS replacements)
            string(REPLACE "|" ";" fields "${replacement}")
            list(GET fields 0 marker)
            list(GET fields 1 target)
            set(dlls "$<TARGET_RUNTIME_DLLS:${target}>")
            set(array "[$<$<BOOL:${dlls}>:\"$<JOIN:${dlls},\",\">\">]")
            string(REPLACE "\"${marker}\"" "${array}" context "${context}")
        endforeach()
        file(GENERATE OUTPUT "${PROJECT_BINARY_DIR}/packages/${product}/$<IF:$<BOOL:$<CONFIG>>,$<CONFIG>,Unspecified>/acceptance-context.json" CONTENT "${context}\n")

        # Validate resolved, configuration-specific names before building or
        # installing any member. OUTPUT_NAME may itself be a generator expression.
        set(validation "${PROJECT_BINARY_DIR}/packages/${product}/$<IF:$<BOOL:$<CONFIG>>,$<CONFIG>,Unspecified>/validate-layout.cmake")
        file(GENERATE OUTPUT "${validation}" CONTENT
            "set(GYO_PRODUCT_MANIFEST [==[${output}]==])\ninclude([==[${CMAKE_CURRENT_FUNCTION_LIST_DIR}/ValidateProductLayout.cmake]==])\n")
        add_custom_target(gyo_${product}--package-layout
            COMMAND "${CMAKE_COMMAND}" -P "${validation}" VERBATIM)
        foreach(target IN LISTS targets)
            get_target_property(imported ${target} IMPORTED)
            if(NOT imported)
                add_dependencies(${target} gyo_${product}--package-layout)
            endif()
        endforeach()
    endforeach()
endfunction()
