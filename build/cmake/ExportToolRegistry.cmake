cmake_minimum_required(VERSION 3.30)
include("${CMAKE_CURRENT_LIST_DIR}/GyoToolRegistry.cmake")
if(NOT DEFINED GYO_REPOSITORY_ROOT)
    get_filename_component(GYO_REPOSITORY_ROOT "${CMAKE_CURRENT_LIST_DIR}/../.." ABSOLUTE)
endif()
if(NOT DEFINED GYO_TOOL_REGISTRY_FILE)
    set(GYO_TOOL_REGISTRY_FILE "${GYO_REPOSITORY_ROOT}/engine/config/tools.csv")
endif()
gyo_read_tool_registry("${GYO_TOOL_REGISTRY_FILE}" registry)
gyo_export_tool_matrix("${registry}" "${GYO_REPOSITORY_ROOT}" matrix)
if(DEFINED GYO_OUTPUT AND NOT "${GYO_OUTPUT}" STREQUAL "")
    get_filename_component(directory "${GYO_OUTPUT}" DIRECTORY)
    if(NOT "${directory}" STREQUAL "")
        file(MAKE_DIRECTORY "${directory}")
    endif()
    file(WRITE "${GYO_OUTPUT}" "${matrix}\n")
else()
    execute_process(COMMAND "${CMAKE_COMMAND}" -E echo "${matrix}" COMMAND_ERROR_IS_FATAL ANY)
endif()
