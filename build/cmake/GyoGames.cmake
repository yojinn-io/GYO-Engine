include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GyoComponents.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/GyoGameRegistry.cmake")

# Read data before composing dependencies, never execute game CMake for discovery.
function(gyo_read_project file output)
    if(NOT EXISTS "${file}")
        message(FATAL_ERROR "Missing project metadata: ${file}")
    endif()
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${file}")
    file(READ "${file}" data)
    string(JSON version GET "${data}" version)
    if(NOT version EQUAL 1)
        message(FATAL_ERROR "Unsupported project metadata version: ${file}")
    endif()
    string(JSON count LENGTH "${data}" components)
    set(components "")
    if(count GREATER 0)
        math(EXPR last "${count}-1")
        foreach(index RANGE 0 ${last})
            string(JSON component GET "${data}" components ${index})
            list(APPEND components "${component}")
        endforeach()
    endif()
    gyo_validate_components(${components})
    set(${output} "${components}" PARENT_SCOPE)
endfunction()

function(gyo_configure_games)
    set(GYO_GAMES AUTO CACHE STRING "AUTO selects enabled CSV games; empty selects none; otherwise an enabled subset")
    set(GYO_GAME_REGISTRY_FILE "${GYO_REPOSITORY_ROOT}/config/games.csv" CACHE FILEPATH "Game build selection registry")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${GYO_GAME_REGISTRY_FILE}")
    gyo_read_game_registry("${GYO_GAME_REGISTRY_FILE}" data)
    gyo_select_games("${data}" "${CMAKE_SYSTEM_NAME}" "${GYO_GAMES}" selected)
    gyo_validate_game_sources("${GYO_REPOSITORY_ROOT}" ${selected})
    set(components "")
    foreach(game IN LISTS selected)
        gyo_game_directory("${game}" directory)
        gyo_read_project("${GYO_REPOSITORY_ROOT}/${directory}/project.json" requested)
        set_property(GLOBAL PROPERTY GYO_GAME_${game}_COMPONENTS "${requested}")
        list(APPEND components ${requested})
    endforeach()
    if(BUILD_TESTING)
        include("${GYO_REPOSITORY_ROOT}/tests/common/Requirements.cmake")
        list(APPEND components ${GYO_COMMON_TEST_COMPONENTS})
    endif()
    list(REMOVE_DUPLICATES components)
    set(GYO_GAME_REGISTRY_DATA "${data}" PARENT_SCOPE)
    set(GYO_ACTIVE_GAMES "${selected}" PARENT_SCOPE)
    set(GYO_REQUESTED_COMPONENTS "${components}" PARENT_SCOPE)
    message(STATUS "GYO games: target=${CMAKE_SYSTEM_NAME}, selected=[${selected}], components=[${components}]")
endfunction()
