# Module and Plugin registers (docs/architecture/target/v2/orchestration-skeleton-declaration.zh-Hant.md,
# section 3.2; Design Invariant O-6 of docs/architecture/target/v2/orchestration.zh-Hant.md).
#
# engine/config/modules.csv and engine/config/plugins.csv are the one place
# that says which Modules and Plugins exist, whether each goes into a World
# (has a registration unit), whether a product carries it by default, and
# what it depends on (v8-arch-gyo2-module-plugin-registers,
# v8-arch-gyo2-module-deps-in-registers). CMake reads them to add the engine
# directories, to link each engine Module's dependencies and to generate a
# product's table of registration units; the orchestration layer checks the
# dependencies of the units a Product carries when the Product is built.
#
# Columns: name,target,description,library_only,default,depends,private_depends,unit,header
#   name             the directory name (engine/<name>/ or plugins/<name>/)
#   target           the alias that is linked (GYO::<...>; N14's capitals are irregular)
#   library_only     yes: no registration unit; no: goes into a World
#   default          yes: products carry this in-World Module unless they disable it;
#                    no: carried only when listed (library-only rows and Plugins: no)
#   depends          ;-separated names, linked PUBLIC (INTERFACE for interface libraries)
#   private_depends  ;-separated names, linked PRIVATE
#   unit, header     in-World rows: the registration unit's class and header
# Usable with cmake -P (the register tests).

include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/GyoAppRegistry.cmake")

set(GYO_UNIT_REGISTER_COLUMNS name target description library_only default depends private_depends unit header)

function(_gyo_unit_yes_no value file row column output)
    string(TOLOWER "${value}" lowered)
    if(lowered STREQUAL "yes")
        set(${output} TRUE PARENT_SCOPE)
    elseif(lowered STREQUAL "no")
        set(${output} FALSE PARENT_SCOPE)
    else()
        message(FATAL_ERROR "Unit register ${file} row ${row}: column '${column}' must be yes or no, got '${value}'")
    endif()
endfunction()

# Reads one register file into global properties under prefix (rows appended
# to <prefix>_ORDER in file order).
function(_gyo_read_unit_register prefix csv kind)
    _gyo_registry_csv_records("${csv}" records)
    string(JSON count LENGTH "${records}")
    if(count EQUAL 0)
        message(FATAL_ERROR "Unit register is missing its header: ${csv}")
    endif()
    list(LENGTH GYO_UNIT_REGISTER_COLUMNS columns)
    string(JSON header_count LENGTH "${records}" 0)
    if(NOT header_count EQUAL columns)
        message(FATAL_ERROR "Unit register header must have ${columns} columns (${GYO_UNIT_REGISTER_COLUMNS}): ${csv}")
    endif()
    math(EXPR last_column "${columns} - 1")
    foreach(index RANGE 0 ${last_column})
        string(JSON actual GET "${records}" 0 ${index})
        list(GET GYO_UNIT_REGISTER_COLUMNS ${index} expected)
        if(NOT actual STREQUAL expected)
            message(FATAL_ERROR "Unit register header column ${index} must be '${expected}', got '${actual}': ${csv}")
        endif()
    endforeach()
    get_property(order GLOBAL PROPERTY ${prefix}_ORDER)
    math(EXPR last_row "${count} - 1")
    if(last_row LESS 1)
        return()
    endif()
    foreach(row RANGE 1 ${last_row})
        string(JSON fields LENGTH "${records}" ${row})
        if(NOT fields EQUAL columns)
            message(FATAL_ERROR "Unit register ${csv} row ${row}: ${fields} columns, expected ${columns}")
        endif()
        foreach(index RANGE 0 ${last_column})
            list(GET GYO_UNIT_REGISTER_COLUMNS ${index} column)
            string(JSON value_${column} GET "${records}" ${row} ${index})
        endforeach()
        set(name "${value_name}")
        if(name STREQUAL "")
            message(FATAL_ERROR "Unit register ${csv} row ${row}: empty name")
        endif()
        if(name IN_LIST order)
            get_property(first_file GLOBAL PROPERTY ${prefix}_${name}_FILE)
            message(FATAL_ERROR "Unit register ${csv} row ${row}: '${name}' is already in ${first_file}")
        endif()
        _gyo_unit_yes_no("${value_library_only}" "${csv}" ${row} library_only library_only)
        _gyo_unit_yes_no("${value_default}" "${csv}" ${row} default default_on)
        if(library_only AND (NOT value_unit STREQUAL "" OR NOT value_header STREQUAL ""))
            message(FATAL_ERROR "Unit register ${csv} row ${row}: '${name}' is library_only but names a unit or header")
        endif()
        if(NOT library_only AND (value_unit STREQUAL "" OR value_header STREQUAL ""))
            message(FATAL_ERROR "Unit register ${csv} row ${row}: '${name}' goes into a World but has no unit or header")
        endif()
        if(default_on AND (library_only OR kind STREQUAL "Plugin"))
            message(FATAL_ERROR "Unit register ${csv} row ${row}: '${name}' has default yes, but only an in-World Module may")
        endif()
        if(value_target STREQUAL "")
            message(FATAL_ERROR "Unit register ${csv} row ${row}: '${name}' has no target")
        endif()
        list(APPEND order "${name}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_KIND "${kind}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_FILE "${csv}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_ROW "${row}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_TARGET "${value_target}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_LIBRARY_ONLY "${library_only}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_DEFAULT "${default_on}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_DEPENDS "${value_depends}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_PRIVATE "${value_private_depends}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_UNIT "${value_unit}")
        set_property(GLOBAL PROPERTY ${prefix}_${name}_HEADER "${value_header}")
    endforeach()
    set_property(GLOBAL PROPERTY ${prefix}_ORDER "${order}")
endfunction()

# Reads both registers under prefix and checks them as one list: names unique
# across the two files; every dependency exists and comes earlier (the order is
# the build order; nothing is reordered); a Module depends on no Plugin.
function(gyo_load_unit_registers prefix modules_csv plugins_csv)
    set_property(GLOBAL PROPERTY ${prefix}_ORDER "")
    _gyo_read_unit_register(${prefix} "${modules_csv}" Module)
    _gyo_read_unit_register(${prefix} "${plugins_csv}" Plugin)
    get_property(order GLOBAL PROPERTY ${prefix}_ORDER)
    set(seen "")
    foreach(name IN LISTS order)
        get_property(kind GLOBAL PROPERTY ${prefix}_${name}_KIND)
        get_property(file GLOBAL PROPERTY ${prefix}_${name}_FILE)
        get_property(row GLOBAL PROPERTY ${prefix}_${name}_ROW)
        get_property(depends GLOBAL PROPERTY ${prefix}_${name}_DEPENDS)
        get_property(private GLOBAL PROPERTY ${prefix}_${name}_PRIVATE)
        foreach(dep IN LISTS depends private)
            if(NOT dep IN_LIST order)
                message(FATAL_ERROR "Unit register ${file} row ${row}: '${name}' depends on '${dep}', which is in no register")
            endif()
            # The kind before the order: Plugins come after Modules, so a
            # Module's Plugin dependency is always later as well.
            get_property(dep_kind GLOBAL PROPERTY ${prefix}_${dep}_KIND)
            if(kind STREQUAL "Module" AND dep_kind STREQUAL "Plugin")
                message(FATAL_ERROR "Unit register ${file} row ${row}: Module '${name}' depends on Plugin '${dep}'; a Module does not depend on a Plugin")
            endif()
            if(NOT dep IN_LIST seen)
                message(FATAL_ERROR "Unit register ${file} row ${row}: '${name}' depends on '${dep}', which comes later (the order is the build order and is not changed)")
            endif()
        endforeach()
        list(APPEND seen "${name}")
    endforeach()
endfunction()

# The in-World units a product carries, in register order: every in-World
# Module with default yes, minus DISABLE_MODULES, plus MODULES, plus PLUGINS.
# A name that is not an in-World unit of the right kind, or a carried unit
# whose in-World dependency is not carried, is a FATAL_ERROR (the
# orchestration layer checks the same again when the Product is built, since a
# RegisteredUnits may be written by hand).
function(gyo_unit_selection prefix output)
    cmake_parse_arguments(PARSE_ARGV 2 ARG "" "" "DISABLE_MODULES;MODULES;PLUGINS")
    get_property(order GLOBAL PROPERTY ${prefix}_ORDER)
    foreach(list_name IN ITEMS DISABLE_MODULES MODULES PLUGINS)
        set(wanted_kind Module)
        if(list_name STREQUAL "PLUGINS")
            set(wanted_kind Plugin)
        endif()
        foreach(name IN LISTS ARG_${list_name})
            get_property(kind GLOBAL PROPERTY ${prefix}_${name}_KIND)
            get_property(library_only GLOBAL PROPERTY ${prefix}_${name}_LIBRARY_ONLY)
            if(NOT name IN_LIST order OR NOT kind STREQUAL wanted_kind OR library_only)
                message(FATAL_ERROR "gyo_product_units: ${list_name} names '${name}', which is no in-World ${wanted_kind}")
            endif()
        endforeach()
    endforeach()
    set(selected "")
    foreach(name IN LISTS order)
        get_property(kind GLOBAL PROPERTY ${prefix}_${name}_KIND)
        get_property(library_only GLOBAL PROPERTY ${prefix}_${name}_LIBRARY_ONLY)
        get_property(default_on GLOBAL PROPERTY ${prefix}_${name}_DEFAULT)
        if(library_only)
            continue()
        endif()
        if(kind STREQUAL "Module")
            if((default_on AND NOT name IN_LIST ARG_DISABLE_MODULES) OR name IN_LIST ARG_MODULES)
                list(APPEND selected "${name}")
            endif()
        elseif(name IN_LIST ARG_PLUGINS)
            list(APPEND selected "${name}")
        endif()
    endforeach()
    foreach(name IN LISTS selected)
        get_property(depends GLOBAL PROPERTY ${prefix}_${name}_DEPENDS)
        get_property(private GLOBAL PROPERTY ${prefix}_${name}_PRIVATE)
        foreach(dep IN LISTS depends private)
            get_property(dep_library_only GLOBAL PROPERTY ${prefix}_${dep}_LIBRARY_ONLY)
            if(NOT dep_library_only AND NOT dep IN_LIST selected)
                message(FATAL_ERROR "gyo_product_units: '${name}' depends on '${dep}', which the product does not carry (disabled or not listed)")
            endif()
        endforeach()
    endforeach()
    set(${output} "${selected}" PARENT_SCOPE)
endfunction()

# The engine Module <name> (target gyo_<name>) links its registered
# dependencies: depends PUBLIC (INTERFACE for an interface library),
# private_depends PRIVATE. Third-party links stay in the module's CMakeLists.
function(gyo_link_registered_dependencies name)
    get_property(order GLOBAL PROPERTY GYO_UNITS_ORDER)
    if(NOT name IN_LIST order)
        message(FATAL_ERROR "gyo_link_registered_dependencies: '${name}' is in no unit register")
    endif()
    set(target gyo_${name})
    if(NOT TARGET ${target})
        message(FATAL_ERROR "gyo_link_registered_dependencies: no target ${target} for register row '${name}'")
    endif()
    get_target_property(type ${target} TYPE)
    get_property(depends GLOBAL PROPERTY GYO_UNITS_${name}_DEPENDS)
    get_property(private GLOBAL PROPERTY GYO_UNITS_${name}_PRIVATE)
    set(public_targets "")
    foreach(dep IN LISTS depends)
        get_property(dep_target GLOBAL PROPERTY GYO_UNITS_${dep}_TARGET)
        list(APPEND public_targets "${dep_target}")
    endforeach()
    set(private_targets "")
    foreach(dep IN LISTS private)
        get_property(dep_target GLOBAL PROPERTY GYO_UNITS_${dep}_TARGET)
        list(APPEND private_targets "${dep_target}")
    endforeach()
    if(type STREQUAL "INTERFACE_LIBRARY")
        if(private_targets)
            message(FATAL_ERROR "gyo_link_registered_dependencies: interface library ${target} has private_depends")
        endif()
        if(public_targets)
            target_link_libraries(${target} INTERFACE ${public_targets})
        endif()
    else()
        if(public_targets)
            target_link_libraries(${target} PUBLIC ${public_targets})
        endif()
        if(private_targets)
            target_link_libraries(${target} PRIVATE ${private_targets})
        endif()
    endif()
endfunction()

# A product target's registration units (section 3.2 point 3): links the
# carried units' targets and generates <target>_units.cpp defining
# MakeRegisteredUnits() (every row of both registers, and an instance of each
# carried unit in register order). REGISTERS <modules.csv> <plugins.csv> is for
# the common tests' synthetic registers.
function(gyo_product_units target)
    cmake_parse_arguments(PARSE_ARGV 1 ARG "" "" "DISABLE_MODULES;MODULES;PLUGINS;REGISTERS")
    set(prefix GYO_UNITS)
    if(ARG_REGISTERS)
        list(LENGTH ARG_REGISTERS register_count)
        if(NOT register_count EQUAL 2)
            message(FATAL_ERROR "gyo_product_units: REGISTERS takes <modules.csv> <plugins.csv>")
        endif()
        list(GET ARG_REGISTERS 0 modules_csv)
        list(GET ARG_REGISTERS 1 plugins_csv)
        set(prefix _GYO_UNITS_${target})
        gyo_load_unit_registers(${prefix} "${modules_csv}" "${plugins_csv}")
    endif()
    gyo_unit_selection(${prefix} selected DISABLE_MODULES ${ARG_DISABLE_MODULES} MODULES ${ARG_MODULES} PLUGINS ${ARG_PLUGINS})
    get_property(order GLOBAL PROPERTY ${prefix}_ORDER)
    set(includes "")
    set(rows "")
    set(modules "")
    set(plugins "")
    set(link_targets "")
    foreach(name IN LISTS order)
        get_property(kind GLOBAL PROPERTY ${prefix}_${name}_KIND)
        get_property(library_only GLOBAL PROPERTY ${prefix}_${name}_LIBRARY_ONLY)
        get_property(default_on GLOBAL PROPERTY ${prefix}_${name}_DEFAULT)
        get_property(depends GLOBAL PROPERTY ${prefix}_${name}_DEPENDS)
        get_property(private GLOBAL PROPERTY ${prefix}_${name}_PRIVATE)
        set(depends_cpp "")
        foreach(dep IN LISTS depends)
            string(APPEND depends_cpp "\"${dep}\", ")
        endforeach()
        set(private_cpp "")
        foreach(dep IN LISTS private)
            string(APPEND private_cpp "\"${dep}\", ")
        endforeach()
        set(library_cpp false)
        if(library_only)
            set(library_cpp true)
        endif()
        set(default_cpp false)
        if(default_on)
            set(default_cpp true)
        endif()
        string(APPEND rows "    units.rows.push_back(RegisterRow{\"${name}\", UnitKind::${kind}, ${library_cpp}, ${default_cpp}, {${depends_cpp}}, {${private_cpp}}});\n")
        if(name IN_LIST selected)
            get_property(unit GLOBAL PROPERTY ${prefix}_${name}_UNIT)
            get_property(header GLOBAL PROPERTY ${prefix}_${name}_HEADER)
            get_property(unit_target GLOBAL PROPERTY ${prefix}_${name}_TARGET)
            string(APPEND includes "#include \"${header}\"\n")
            if(kind STREQUAL "Module")
                string(APPEND modules "    units.modules.push_back(UnitEntry<Module>{\"${name}\", std::make_unique<${unit}>()});\n")
            else()
                string(APPEND plugins "    units.plugins.push_back(UnitEntry<Plugin>{\"${name}\", std::make_unique<${unit}>()});\n")
            endif()
            list(APPEND link_targets "${unit_target}")
        endif()
    endforeach()
    list(REMOVE_DUPLICATES link_targets)
    set(generated "${CMAKE_CURRENT_BINARY_DIR}/${target}_units.cpp")
    # Built with string(APPEND): the C++ text has semicolons, which a CMake list would split.
    set(content "// Generated by gyo_product_units (build/cmake/GyoUnitRegistry.cmake); do not edit.\n")
    string(APPEND content "#include \"engine/orchestration/RegisteredUnits.hpp\"\n${includes}\n#include <memory>\n\n")
    string(APPEND content "namespace GYO::Engine::Orchestration {\n\nRegisteredUnits MakeRegisteredUnits() {\n")
    string(APPEND content "    RegisteredUnits units;\n${rows}${modules}${plugins}    return units;\n}\n\n")
    string(APPEND content "} // namespace GYO::Engine::Orchestration\n")
    file(CONFIGURE OUTPUT "${generated}" CONTENT "${content}" @ONLY)
    target_sources(${target} PRIVATE "${generated}")
    target_link_libraries(${target} PRIVATE GYO::Orchestration ${link_targets})
endfunction()
