include_guard(GLOBAL)

# Probes belong to external acceptance support and are never installed.
function(gyo_register_acceptance_probe)
    cmake_parse_arguments(P "" "OWNER;ROLE;TARGET" "" ${ARGN})
    if(P_UNPARSED_ARGUMENTS OR P_KEYWORDS_MISSING_VALUES OR
        NOT P_OWNER MATCHES "^[a-z][a-z0-9_]*$" OR NOT P_ROLE MATCHES "^[a-z][a-z0-9_]*$" OR
        NOT TARGET "${P_TARGET}")
        message(FATAL_ERROR "Invalid acceptance probe registration")
    endif()
    get_property(previous GLOBAL PROPERTY GYO_ACCEPTANCE_${P_OWNER}.${P_ROLE}_TARGET)
    get_target_property(type ${P_TARGET} TYPE)
    if(previous OR NOT type STREQUAL EXECUTABLE)
        message(FATAL_ERROR "Duplicate or non-executable acceptance probe: ${P_OWNER}.${P_ROLE}")
    endif()
    set_property(GLOBAL APPEND PROPERTY GYO_ACCEPTANCE_${P_OWNER}_ROLES "${P_ROLE}")
    set_property(GLOBAL PROPERTY GYO_ACCEPTANCE_${P_OWNER}.${P_ROLE}_TARGET "${P_TARGET}")
endfunction()

function(_gyo_acceptance_check_tokens check owner manifest platform)
    string(JSON platforms GET "${check}" platforms)
    string(FIND "${platforms}" "\"${platform}\"" supported)
    string(REGEX MATCHALL "@[^@]+@" tokens "${check}")
    foreach(token IN LISTS tokens)
        if(token MATCHES "^@EXECUTABLE:([a-z][a-z0-9_]*)@$")
            if(NOT supported EQUAL -1)
                string(JSON ignored ERROR_VARIABLE missing GET "${manifest}" executables "${owner}.${CMAKE_MATCH_1}")
                if(missing)
                    message(FATAL_ERROR "Acceptance executable role is not registered: ${owner}/${token}")
                endif()
            endif()
        elseif(token MATCHES "^@PROBE:([a-z][a-z0-9_]*)@$")
            if(NOT supported EQUAL -1)
                get_property(target GLOBAL PROPERTY GYO_ACCEPTANCE_${owner}.${CMAKE_MATCH_1}_TARGET)
                if(NOT TARGET "${target}")
                    message(FATAL_ERROR "Acceptance probe role is not registered: ${owner}/${token}")
                endif()
            endif()
        elseif(NOT token MATCHES "^@(PACKAGE_ROOT|CHECK_ROOT|LOG_ROOT|PYTHON|PROFILE|DRIVER)@$")
            message(FATAL_ERROR "Unknown acceptance token: ${owner}/${token}")
        endif()
    endforeach()
endfunction()

function(gyo_collect_product_acceptance product kind platform manifest checks_out owners_out replacements_out)
    get_property(owners GLOBAL PROPERTY GYO_PRODUCT_${product}_OWNERS)
    list(REMOVE_DUPLICATES owners)
    set(checks "[]")
    set(context_owners "{}")
    set(replacements "")
    foreach(owner IN LISTS owners)
        set(root "${GYO_REPOSITORY_ROOT}/build/acceptance/${owner}")
        set(check_file "${root}/checks.json")
        set(quick FALSE)
        set(release FALSE)
        if(EXISTS "${check_file}")
            set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${check_file}")
            file(READ "${check_file}" data)
            string(JSON version GET "${data}" version)
            string(JSON check_type TYPE "${data}" checks)
            if(NOT version EQUAL 1 OR NOT check_type STREQUAL ARRAY)
                message(FATAL_ERROR "Unsupported acceptance contract: ${check_file}")
            endif()
            string(JSON count LENGTH "${data}" checks)
            set(names "")
            if(count GREATER 0)
                math(EXPR last "${count}-1")
                foreach(index RANGE 0 ${last})
                    string(JSON check GET "${data}" checks ${index})
                    string(JSON name GET "${check}" name)
                    if(NOT name MATCHES "^[A-Za-z0-9_.-]+$" OR name IN_LIST names OR name STREQUAL package_files)
                        message(FATAL_ERROR "Duplicate or invalid acceptance check: ${owner}/${name}")
                    endif()
                    list(APPEND names "${name}")
                    string(JSON command_type TYPE "${check}" command)
                    string(JSON command_count LENGTH "${check}" command)
                    string(JSON command GET "${check}" command)
                    if(NOT command_type STREQUAL ARRAY OR command_count EQUAL 0)
                        message(FATAL_ERROR "Acceptance check requires an executable command: ${owner}/${name}")
                    endif()
                    _gyo_acceptance_check_tokens("${check}" "${owner}" "${manifest}" "${platform}")
                    _gyo_package_quote("${owner}" quoted)
                    string(JSON check SET "${check}" owner "${quoted}")
                    string(JSON next LENGTH "${checks}")
                    string(JSON checks SET "${checks}" ${next} "${check}")
                    string(JSON platforms GET "${check}" platforms)
                    string(JSON profiles GET "${check}" profiles)
                    string(FIND "${platforms}" "\"${platform}\"" supported)
                    if(NOT supported EQUAL -1 AND command MATCHES "@(EXECUTABLE|PROBE):[a-z][a-z0-9_]*@")
                        foreach(profile quick release)
                            string(FIND "${profiles}" "\"${profile}\"" covered)
                            if(NOT covered EQUAL -1)
                                set(${profile} TRUE)
                            endif()
                        endforeach()
                    endif()
                endforeach()
            endif()
        endif()
        if(kind STREQUAL toolchain AND (NOT quick OR NOT release))
            message(FATAL_ERROR "Toolchain owner ${owner} requires acceptance coverage for quick and release on ${platform}: ${check_file}")
        endif()

        get_property(roles GLOBAL PROPERTY GYO_ACCEPTANCE_${owner}_ROLES)
        if(NOT EXISTS "${check_file}" AND NOT roles)
            continue()
        endif()
        _gyo_package_quote("${root}" quoted)
        string(JSON context_owner SET "{}" root "${quoted}")
        string(JSON context_owner SET "${context_owner}" probes "{}")
        foreach(role IN LISTS roles)
            get_property(target GLOBAL PROPERTY GYO_ACCEPTANCE_${owner}.${role}_TARGET)
            _gyo_package_quote("$<TARGET_FILE:${target}>" quoted)
            string(JSON probe SET "{}" path "${quoted}")
            # A placeholder keeps JSON valid while composing it; file(GENERATE)
            # then resolves the target's config-specific native dependency list.
            get_target_property(imported ${target} IMPORTED)
            if(imported)
                string(JSON probe SET "${probe}" runtime_files "[]")
            else()
                set(marker "__GYO_PROBE_FILES_${owner}_${role}__")
                string(JSON probe SET "${probe}" runtime_files "\"${marker}\"")
                list(APPEND replacements "${marker}|${target}")
            endif()
            string(JSON context_owner SET "${context_owner}" probes "${role}" "${probe}")
        endforeach()
        string(JSON context_owners SET "${context_owners}" "${owner}" "${context_owner}")
    endforeach()
    set(${checks_out} "${checks}" PARENT_SCOPE)
    set(${owners_out} "${context_owners}" PARENT_SCOPE)
    set(${replacements_out} "${replacements}" PARENT_SCOPE)
endfunction()
