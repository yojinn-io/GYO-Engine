include_guard(GLOBAL)

# Discover from the selected compiler installation, rather than CMake's list
# of known Visual Studio releases. Older IDE-bundled CMake versions can build
# with a newer cl.exe even when InstallRequiredSystemLibraries cannot find it.
function(gyo_find_msvc_runtime output)
    cmake_parse_arguments(CRT "" "COMPILER;ARCHITECTURE;REDIST_ROOT" "" ${ARGN})
    set(${output} "" PARENT_SCOPE)
    if(NOT CRT_ARCHITECTURE MATCHES "^(x86|x64|arm64)$")
        return()
    endif()
    file(TO_CMAKE_PATH "${CRT_COMPILER}" compiler)
    string(TOLOWER "${compiler}" compiler_version_path)
    set(minimum_version "")
    if(compiler_version_path MATCHES "/msvc/([0-9]+\\.[0-9]+)[./]")
        set(minimum_version "${CMAKE_MATCH_1}")
    endif()
    set(roots "${CRT_REDIST_ROOT}")
    if(NOT roots)
        get_filename_component(directory "${compiler}" DIRECTORY)
        while(directory)
            if(IS_DIRECTORY "${directory}/Redist/MSVC")
                list(APPEND roots "${directory}/Redist/MSVC")
                break()
            endif()
            get_filename_component(parent "${directory}" DIRECTORY)
            if(parent STREQUAL directory)
                break()
            endif()
            set(directory "${parent}")
        endwhile()
        # Also covers clang-cl and explicitly selected VS generator instances.
        list(APPEND roots "$ENV{VCToolsRedistDir}"
            "${CMAKE_GENERATOR_INSTANCE}/VC/Redist/MSVC"
            "$ENV{VSINSTALLDIR}/VC/Redist/MSVC")
    endif()
    foreach(root IN LISTS roots)
        if(NOT IS_DIRECTORY "${root}")
            continue()
        endif()
        if(IS_DIRECTORY "${root}/${CRT_ARCHITECTURE}")
            set(versions "${root}")
        else()
            file(GLOB versions LIST_DIRECTORIES TRUE "${root}/[0-9]*")
            list(SORT versions COMPARE NATURAL ORDER DESCENDING)
        endif()
        foreach(version IN LISTS versions)
            get_filename_component(version_name "${version}" NAME)
            if(minimum_version AND version_name MATCHES "^[0-9]+\\.[0-9]+" AND
               version_name VERSION_LESS minimum_version)
                continue()
            endif()
            file(GLOB directories LIST_DIRECTORIES TRUE
                "${version}/${CRT_ARCHITECTURE}/Microsoft.VC*.CRT")
            list(SORT directories COMPARE NATURAL ORDER DESCENDING)
            foreach(crt_directory IN LISTS directories)
                if(EXISTS "${crt_directory}/msvcp140.dll" AND
                   EXISTS "${crt_directory}/vcruntime140.dll" AND
                   EXISTS "${crt_directory}/concrt140.dll")
                    file(GLOB libraries "${crt_directory}/*.dll")
                    set(${output} "${libraries}" PARENT_SCOPE)
                    return()
                endif()
            endforeach()
        endforeach()
    endforeach()
endfunction()

function(gyo_install_msvc_runtime)
    cmake_parse_arguments(INSTALL "" "COMPONENT" "" ${ARGN})
    set(component_args "")
    if(INSTALL_COMPONENT)
        list(APPEND component_args COMPONENT "${INSTALL_COMPONENT}")
    endif()
    set(GYO_MSVC_REDIST_DIR "" CACHE PATH
        "Optional MSVC redist root (version directory, or VC/Redist/MSVC)")
    set(architecture "${MSVC_CXX_ARCHITECTURE_ID}")
    if(NOT architecture)
        set(architecture "${CMAKE_CXX_COMPILER_ARCHITECTURE_ID}")
    endif()
    string(TOLOWER "${architecture}" architecture)
    if(architecture STREQUAL "amd64")
        set(architecture x64)
    endif()
    gyo_find_msvc_runtime(libraries COMPILER "${CMAKE_CXX_COMPILER}"
        ARCHITECTURE "${architecture}" REDIST_ROOT "${GYO_MSVC_REDIST_DIR}")
    set_property(GLOBAL PROPERTY GYO_MSVC_RUNTIME_LIBRARIES "${libraries}")
    if(libraries)
        message(STATUS "GYO package: found ${architecture} MSVC runtime for the selected compiler")
        install(PROGRAMS ${libraries} DESTINATION bin
            CONFIGURATIONS Release RelWithDebInfo MinSizeRel ${component_args})
    else()
        message(STATUS "GYO package: MSVC redist unavailable; development builds remain enabled")
        # Packaging is strict, but redistributables are not a compile-time
        # dependency. Do not prevent CLion from configuring or running a game.
        install(CODE [[
            string(TOLOWER "${CMAKE_INSTALL_CONFIG_NAME}" gyo_install_config)
            if(gyo_install_config MATCHES "^(release|relwithdebinfo|minsizerel)$")
                message(FATAL_ERROR
                    "MSVC runtime is required for a release package. Install the selected Visual Studio C++ redistributables, or configure GYO_MSVC_REDIST_DIR and configure again.")
            endif()
        ]] ${component_args})
    endif()
endfunction()
