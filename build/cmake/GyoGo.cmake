include_guard(GLOBAL)

# Go is optional for native builds: only explicit service targets and Go tests
# invoke it. CI verifies the recorded modules with its own provisioned Go.
set(GYO_GO_EXECUTABLE go CACHE STRING "Go executable used by explicit Go service targets and Go tests")

# Release package platforms a Go service may declare; build/ci/common/go_checks.py
# maps each one to its GOOS/GOARCH when cross-building service archives.
set(GYO_GO_SERVICE_PLATFORMS windows-x64 linux-x64 macos-arm64 macos-x64)

function(_gyo_go_json_quote value output)
    string(REPLACE "\\" "\\\\" value "${value}")
    string(REPLACE "\"" "\\\"" value "${value}")
    set(${output} "\"${value}\"" PARENT_SCOPE)
endfunction()

# Records one Go module for the configured build. OWNER is a registered product
# or the reserved engine layer; CI reads the record from gyo-build.json and
# never discovers modules. TESTS adds the module's checks as CTest tests with
# the dedicated "go" label, outside the cpu|shader test presets. OUT_PATH
# receives the recorded repository-relative module path.
function(gyo_register_go_module)
    cmake_parse_arguments(PARSE_ARGV 0 MODULE "TESTS" "OWNER;DIRECTORY;OUT_PATH" "")
    if(MODULE_UNPARSED_ARGUMENTS OR MODULE_KEYWORDS_MISSING_VALUES OR
        NOT MODULE_OWNER MATCHES "^[a-z][a-z0-9_]*$" OR NOT IS_DIRECTORY "${MODULE_DIRECTORY}")
        message(FATAL_ERROR "gyo_register_go_module requires a valid OWNER and an existing DIRECTORY")
    endif()
    cmake_path(ABSOLUTE_PATH MODULE_DIRECTORY NORMALIZE OUTPUT_VARIABLE directory)
    string(REGEX REPLACE "/$" "" directory "${directory}")
    if(NOT EXISTS "${directory}/go.mod")
        message(FATAL_ERROR "Go module directory has no go.mod: ${directory}")
    endif()
    cmake_path(IS_PREFIX GYO_REPOSITORY_ROOT "${directory}" NORMALIZE inside)
    file(RELATIVE_PATH relative "${GYO_REPOSITORY_ROOT}" "${directory}")
    if(NOT inside OR relative STREQUAL "" OR relative MATCHES "^\\.\\./|^\\.\\.$")
        message(FATAL_ERROR "Go module must be a repository subdirectory: ${directory}")
    endif()
    if(MODULE_OUT_PATH)
        set(${MODULE_OUT_PATH} "${relative}" PARENT_SCOPE)
    endif()
    get_property(modules GLOBAL PROPERTY GYO_GO_MODULES)
    if(relative IN_LIST modules)
        get_property(owner GLOBAL PROPERTY "GYO_GO_MODULE_${relative}_OWNER")
        if(NOT owner STREQUAL MODULE_OWNER)
            message(FATAL_ERROR "Go module ${relative} is already owned by ${owner}, not ${MODULE_OWNER}")
        endif()
        return()
    endif()
    set_property(GLOBAL APPEND PROPERTY GYO_GO_MODULES "${relative}")
    set_property(GLOBAL PROPERTY "GYO_GO_MODULE_${relative}_OWNER" "${MODULE_OWNER}")
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${directory}/go.mod")
    if(MODULE_TESTS AND BUILD_TESTING)
        find_package(Python3 REQUIRED COMPONENTS Interpreter)
        set(steps vet test)
        # The race detector needs cgo and is verified only on Linux hosts.
        if(CMAKE_HOST_SYSTEM_NAME STREQUAL "Linux")
            list(APPEND steps race)
        endif()
        foreach(step IN LISTS steps)
            set(name "${MODULE_OWNER}.go.${step}")
            add_test(NAME "${name}"
                COMMAND "${Python3_EXECUTABLE}" "${CMAKE_CURRENT_FUNCTION_LIST_DIR}/../ci/common/go_checks.py"
                    check --module "${directory}" --go "${GYO_GO_EXECUTABLE}" --step ${step})
            # One go command per test: outlast go_checks.py COMMAND_TIMEOUT (900s)
            # so its own timeout diagnostic is the one that reports.
            set_tests_properties("${name}" PROPERTIES LABELS go TIMEOUT 960)
        endforeach()
    endif()
endfunction()

# Records one owner-declared Go service: its module, main package and the
# release platforms it is cross-built for. Callers validate the owner context.
function(gyo_record_go_service)
    cmake_parse_arguments(PARSE_ARGV 0 SERVICE "" "OWNER;ROLE;MODULE;PACKAGE" "PLATFORMS")
    if(SERVICE_UNPARSED_ARGUMENTS OR SERVICE_KEYWORDS_MISSING_VALUES OR
        NOT SERVICE_OWNER MATCHES "^[a-z][a-z0-9_]*$" OR NOT SERVICE_ROLE MATCHES "^[a-z][a-z0-9_]*$")
        message(FATAL_ERROR "gyo_record_go_service requires a valid OWNER and ROLE")
    endif()
    get_property(modules GLOBAL PROPERTY GYO_GO_MODULES)
    get_property(module_owner GLOBAL PROPERTY "GYO_GO_MODULE_${SERVICE_MODULE}_OWNER")
    if(NOT SERVICE_MODULE IN_LIST modules OR NOT module_owner STREQUAL SERVICE_OWNER)
        message(FATAL_ERROR "Go service ${SERVICE_OWNER}/${SERVICE_ROLE} must use a module its owner registered")
    endif()
    if(NOT SERVICE_PACKAGE MATCHES "^\\./[A-Za-z0-9_./-]*$" OR SERVICE_PACKAGE MATCHES "(^|/)\\.\\.(/|$)")
        message(FATAL_ERROR "Go service package must be a module-relative ./ path: ${SERVICE_PACKAGE}")
    endif()
    if(NOT SERVICE_PLATFORMS)
        message(FATAL_ERROR "Go service ${SERVICE_OWNER}/${SERVICE_ROLE} must declare PLATFORMS")
    endif()
    set(platforms "[]")
    set(seen "")
    foreach(platform IN LISTS SERVICE_PLATFORMS)
        if(NOT platform IN_LIST GYO_GO_SERVICE_PLATFORMS OR platform IN_LIST seen)
            message(FATAL_ERROR "Unknown or duplicate Go service platform '${platform}'; expected one of ${GYO_GO_SERVICE_PLATFORMS}")
        endif()
        list(APPEND seen "${platform}")
        string(JSON index LENGTH "${platforms}")
        string(JSON platforms SET "${platforms}" ${index} "\"${platform}\"")
    endforeach()
    get_property(services GLOBAL PROPERTY GYO_GO_SERVICES_JSON)
    if(NOT services)
        set(services "[]")
    endif()
    string(JSON count LENGTH "${services}")
    if(count GREATER 0)
        math(EXPR last "${count} - 1")
        foreach(index RANGE ${last})
            string(JSON owner GET "${services}" ${index} owner)
            string(JSON role GET "${services}" ${index} role)
            if(owner STREQUAL SERVICE_OWNER AND role STREQUAL SERVICE_ROLE)
                message(FATAL_ERROR "Duplicate Go service ${SERVICE_OWNER}/${SERVICE_ROLE}")
            endif()
        endforeach()
    endif()
    set(service "{}")
    foreach(field OWNER ROLE MODULE PACKAGE)
        string(TOLOWER "${field}" key)
        _gyo_go_json_quote("${SERVICE_${field}}" quoted)
        string(JSON service SET "${service}" "${key}" "${quoted}")
    endforeach()
    string(JSON service SET "${service}" platforms "${platforms}")
    string(JSON services SET "${services}" ${count} "${service}")
    set_property(GLOBAL PROPERTY GYO_GO_SERVICES_JSON "${services}")
endfunction()

# Returns the recorded modules and services as JSON arrays for gyo-build.json.
function(gyo_go_build_record modules_output services_output)
    set(modules "[]")
    get_property(paths GLOBAL PROPERTY GYO_GO_MODULES)
    foreach(path IN LISTS paths)
        get_property(owner GLOBAL PROPERTY "GYO_GO_MODULE_${path}_OWNER")
        _gyo_go_json_quote("${path}" quoted_path)
        _gyo_go_json_quote("${owner}" quoted_owner)
        string(JSON index LENGTH "${modules}")
        string(JSON modules SET "${modules}" ${index} "{\"owner\":${quoted_owner},\"path\":${quoted_path}}")
    endforeach()
    get_property(services GLOBAL PROPERTY GYO_GO_SERVICES_JSON)
    if(NOT services)
        set(services "[]")
    endif()
    set(${modules_output} "${modules}" PARENT_SCOPE)
    set(${services_output} "${services}" PARENT_SCOPE)
endfunction()
