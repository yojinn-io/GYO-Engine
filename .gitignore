# IDE and editor state
/.idea/
/.vs/
/.vscode/
*.iml
*.suo
*.user
*.userosscache
*.sln.docstates

# CLion and CMake build trees
/build/
/build-*/
/cmake-build-*/
/out/
/CMakeFiles/
/CMakeCache.txt
/cmake_install.cmake
/CTestTestfile.cmake
/DartConfiguration.tcl
/Makefile
/build.ninja
/rules.ninja
/.ninja_deps
/.ninja_log
/Testing/
/compile_commands.json
/install_manifest.txt
/CMakeUserPresets.json

# Compiler and linker outputs
*.o
*.obj
*.a
*.lib
*.dll
*.so
*.so.*
*.dylib
*.exe
*.out
*.app
*.pdb
*.ilk
*.exp
*.idb
*.ipdb
*.iobj
*.tlog
*.d

# Generated Visual Studio projects
*.sln
*.slnx
*.vcxproj
*.vcxproj.filters
*.vcxproj.user

# Test, profiling, and coverage output
*.log
*.profraw
*.profdata
*.gcda
*.gcno
coverage/
__pycache__/
*.py[cod]

# FetchContent caches. Match them at any depth because a CMake profile with a
# mis-scoped FETCHCONTENT_BASE_DIR can otherwise place one dependency's build
# tree below another dependency wrapper.
/third_party/**/*-build/
/third_party/**/*-src/
/third_party/**/*-subbuild/
/third_party/**/*-tmp/

# Operating-system metadata
.DS_Store
Thumbs.db
Desktop.ini



