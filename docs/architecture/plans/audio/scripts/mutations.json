      "find": "(accumulator_[i] * master + kHalf)",
      "replace": "(accumulator_[i] * master)",
      "target": "gyo_audio_tests",
      "cases": "*applies left and right gains with rounding*",
      "expect": "CHECK\\( Left\\(out, 0\\) == 501 \\) is NOT correct"
    },
    {
