{
  "version": 1,
  "description": "Memory-order mutants of the audio plan's SPSC rings. Killed only by a ThreadSanitizer build of gyo_audio_tests (configure with -fsanitize=thread) run with TSAN_OPTIONS=ignore_interceptors_accesses=0, which macOS needs to check the ring's memcpy writes; an ordinary build cannot see them. Run with run_mutations.py --catalog this file --build-dir <the TSan build>.",
  "mutants": [
    {
      "id": "au-sched-play-head-relaxed",
      "what": "The producer reads head without acquire",
      "file": "engine/audio/src/Mixer.cpp",
      "find": "    const std::uint64_t head = slot_->head.load(std::memory_order_acquire);",
      "replace": "    const std::uint64_t head = slot_->head.load(std::memory_order_relaxed);",
      "target": "gyo_audio_tests",
      "cases": "*concurrent producers*",
      "expect": "ThreadSanitizer: data race"
    },
    {
      "id": "au-sched-play-tail-relaxed",
      "what": "The producer publishes tail without release",
      "file": "engine/audio/src/Mixer.cpp",
      "find": "    slot_->tail.store(tail + 1, std::memory_order_release);",
      "replace": "    slot_->tail.store(tail + 1, std::memory_order_relaxed);",
      "target": "gyo_audio_tests",
      "cases": "*concurrent producers*",
      "expect": "ThreadSanitizer: data race"
    },
    {
      "id": "au-sched-render-tail-relaxed",
      "what": "The audio thread reads tail without acquire",
      "file": "engine/audio/src/Mixer.cpp",
      "find": "        const std::uint64_t tail = slot.tail.load(std::memory_order_acquire);",
      "replace": "        const std::uint64_t tail = slot.tail.load(std::memory_order_relaxed);",
      "target": "gyo_audio_tests",
      "cases": "*concurrent producers*",
      "expect": "ThreadSanitizer: data race"
    },
    {
      "id": "au-sched-render-head-relaxed",
      "what": "The audio thread publishes head without release",
      "file": "engine/audio/src/Mixer.cpp",
      "find": "        slot.head.store(head, std::memory_order_release);",
      "replace": "        slot.head.store(head, std::memory_order_relaxed);",
      "target": "gyo_audio_tests",
      "cases": "*concurrent producers*",
      "expect": "ThreadSanitizer: data race"
    }
  ]
}