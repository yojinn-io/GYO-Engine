{
  "version": 1,
  "description": "Declared mutants of the framework (docs/framework/architecture.md), owned by docs/architecture/plans/framework-rework (moved from docs/tools/plans/v8/scripts/framework_mutations.json in v8-framework-guard-ratchet). Run with docs/architecture/plans/time-threads-trace/scripts/run_mutations.py --catalog docs/architecture/plans/framework-rework/scripts/framework_mutations.json --build-dir <a tree with GYO_TOOLS=AUTO (ui_editor and audio_editor) and BUILD_TESTING=ON>. A mutant is killed only when its check fails with the expected message. Retired in v8-framework-invariants with the code or rule they mutated: fw-catalog-*, fw-path-dot-dot (the old CatalogRegistration; the JSON binding's tests C1–C7 and E1–E4 cover RegisterAsset, with the fw-cat-* and fw-extra-* mutants), fw-inbox-* (PathDialogInbox; Engine's pd-* cover the path dialogs), and the allowlist and SDL_GPU-rule mutants fw-guard-allowlisted-file-one-more, fw-guard-allowlist-stale, fw-guard-gpu-added, fw-guard-gpu-rule-dropped, fw-guard-input-native-allowlistable, fw-link-trade, fw-link-stale-*, fw-link-binding-line-allowed, fw-link-comment-counts, fw-link-duplicate-allowed.",
  "mutants": [
    {
      "id": "fw-guard-unlisted-engine-target",
      "what": "The framework's CMake names an Engine target outside its positive list (GYO::Input was the example until v8-framework-engine-access allowed it)",
      "file": "framework/CMakeLists.txt",
      "find": "# command line comes as UTF-8 through GYO::Os.",
      "replace": "# command line comes as UTF-8 through GYO::Os and GYO::RenderBackendSDLGPU.",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "names GYO::RenderBackendSDLGPU"
    },
    {
      "id": "fw-guard-tool-header",
      "what": "The framework includes a tool's header",
      "file": "framework/src/ReadOnlyAssetCatalog.cpp",
      "find": "#include \"gyo/framework/ReadOnlyAssetCatalog.hpp\"\n",
      "replace": "#include \"gyo/framework/ReadOnlyAssetCatalog.hpp\"\n#include \"gyo/some_tool/Thing.hpp\"\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "includes gyo/some_tool/Thing.hpp"
    },
    {
      "id": "fw-guard-tool-name",
      "what": "The framework's code names a registered tool",
      "file": "framework/src/ReadOnlyAssetCatalog.cpp",
      "find": "#include <algorithm>\n",
      "replace": "#include <algorithm>\n// Mounts what audio_editor wrote.\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "names audio_editor"
    },
    {
      "id": "fw-guard-executable",
      "what": "The framework adds an executable, as a tool would",
      "file": "framework/CMakeLists.txt",
      "find": "unset(_gyo_framework_targets)\n",
      "replace": "unset(_gyo_framework_targets)\nadd_executable(gyo_framework_main src/PathDialog.cpp)\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "calls add_executable"
    },
    {
      "id": "fw-guard-core-imgui-noslash",
      "what": "The core includes ImGui by its bare header name",
      "file": "framework/src/ReadOnlyAssetCatalog.cpp",
      "find": "#include <algorithm>\n",
      "replace": "#include <algorithm>\n#include <imgui.h>\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "framework/src/ReadOnlyAssetCatalog.cpp: includes imgui\\.h"
    },
    {
      "id": "fw-guard-core-sdl-forward",
      "what": "A core public header forward-declares an SDL type",
      "file": "framework/include/gyo/framework/ReadOnlyAssetCatalog.hpp",
      "find": "namespace Gyo::Tools::Framework {\n",
      "replace": "struct SDL_Window;\nnamespace Gyo::Tools::Framework {\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "ReadOnlyAssetCatalog\\.hpp: uses SDL_Window"
    },
    {
      "id": "fw-guard-core-native-include",
      "what": "The core includes an Engine *Native header",
      "file": "framework/src/ReadOnlyAssetCatalog.cpp",
      "find": "#include <algorithm>\n",
      "replace": "#include <algorithm>\n#include \"engine/platform/sdl/SdlPlatformNative.hpp\"\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "includes engine/platform/sdl/SdlPlatformNative\\.hpp"
    },
    {
      "id": "fw-guard-core-sdl-call",
      "what": "Core code calls an SDL function",
      "file": "framework/src/ReadOnlyAssetCatalog.cpp",
      "find": "#include <utility>\n",
      "replace": "#include <utility>\nstatic void Trace() { SDL_Log(\"mount\"); }\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "ReadOnlyAssetCatalog\\.cpp: uses SDL_Log"
    },
    {
      "id": "fw-guard-core-json-link",
      "what": "The core's own CMake links nlohmann (the core has no JSON link)",
      "file": "framework/CMakeLists.txt",
      "find": "    PUBLIC GYO::Engine\n",
      "replace": "    PUBLIC GYO::Engine nlohmann_json::nlohmann_json\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "framework/CMakeLists\\.txt: names nlohmann_json::nlohmann_json"
    },
    {
      "id": "fw-guard-binding-input-target",
      "what": "A binding names GYO::Input, which only the core's positive list holds",
      "file": "framework/bindings/json/CMakeLists.txt",
      "find": "    PUBLIC GYO::ToolFramework\n    PRIVATE nlohmann_json::nlohmann_json\n",
      "replace": "    PUBLIC GYO::ToolFramework GYO::Input\n    PRIVATE nlohmann_json::nlohmann_json\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "framework/bindings/json/CMakeLists\\.txt: names GYO::Input"
    },
    {
      "id": "fw-guard-binding-list-widened",
      "what": "A binding's positive list takes GYO::Input along with the core's",
      "file": "tests/framework/framework_dependency_guard.py",
      "find": "\"targets\": {\"GYO::ToolFramework\", \"GYO::ToolFrameworkJson\", \"GYO::Engine\", \"GYO::Os\",",
      "replace": "\"targets\": {\"GYO::ToolFramework\", \"GYO::ToolFrameworkJson\", \"GYO::Engine\", \"GYO::Os\", \"GYO::Input\",",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/framework",
        "-p",
        "test_framework_dependency_guard.py"
      ],
      "expect": "FAIL: test_input_target_in_a_binding_fails"
    },
    {
      "id": "fw-guard-allowlist-returns",
      "what": "The removed allowlist comes back unnoticed",
      "file": "tests/framework/framework_dependency_guard.py",
      "find": "    if (root / REMOVED_ALLOWLIST).exists():",
      "replace": "    if False:",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/framework",
        "-p",
        "test_framework_dependency_guard.py"
      ],
      "expect": "FAIL: test_the_removed_allowlist_coming_back_fails"
    },
    {
      "id": "fw-guard-core-sdl-gpu",
      "what": "Core code names an SDL_GPU type (no exception covers it since the allowlist went)",
      "file": "framework/src/ReadOnlyAssetCatalog.cpp",
      "find": "#include \"engine/asset/AssetCatalog.hpp\"\n",
      "replace": "#include \"engine/asset/AssetCatalog.hpp\"\nstruct SDL_GPUDevice* gyoMutantDevice = nullptr;\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "framework/src/ReadOnlyAssetCatalog\\.cpp: uses SDL_GPUDevice"
    },
    {
      "id": "fw-guard-core-input-native",
      "what": "The core includes Engine's SDL input native header",
      "file": "framework/src/ReadOnlyAssetCatalog.cpp",
      "find": "#include \"engine/asset/ContentManifest.hpp\"\n",
      "replace": "#include \"engine/asset/ContentManifest.hpp\"\n#include \"engine/input/backend/sdl/SdlInputNative.hpp\"\n",
      "command": [
        "{python}",
        "tests/framework/framework_dependency_guard.py"
      ],
      "expect": "includes engine/input/backend/sdl/SdlInputNative\\.hpp"
    },
    {
      "id": "fw-abs-not-normal",
      "what": "AbsolutePath keeps '.' and '..' segments of an absolute result (POSIX: on Windows Engine's MakeAbsolute already removes dot segments)",
      "file": "framework/src/AbsolutePath.cpp",
      "find": "    return (converted ? std::move(converted.value()) : path).lexically_normal();",
      "replace": "    return converted ? std::move(converted.value()) : path;",
      "target": "gyo_framework_tests",
      "expect": "is NOT correct",
      "cases": "A*",
      "platforms": [
        "darwin",
        "linux"
      ]
    },
    {
      "id": "fw-abs-relative",
      "what": "AbsolutePath leaves a relative path relative",
      "file": "framework/src/AbsolutePath.cpp",
      "find": "    auto absolute = OsFiles::MakeAbsolute(text.value());\n    if (!absolute) {",
      "replace": "    auto absolute = OsFiles::MakeAbsolute(text.value());\n    if (true) {",
      "target": "gyo_framework_tests",
      "expect": "CHECK\\( result.is_absolute\\(\\) \\) is NOT correct",
      "cases": "A*"
    },
    {
      "id": "fw-link-closure-sdl",
      "what": "The core links SDL3 through a spelling the source guard cannot read; the configure-time link check stops it",
      "file": "framework/CMakeLists.txt",
      "find": "set(_gyo_framework_targets gyo_tool_framework)\n",
      "replace": "set(_gyo_framework_targets gyo_tool_framework)\nset(_gyo_lib SDL3)\ntarget_link_libraries(gyo_tool_framework PRIVATE ${_gyo_lib}::${_gyo_lib})\n",
      "target": "gyo_framework_tests",
      "expect_build_failure": true,
      "expect": "gyo_tool_framework \\(core\\) links 1 forbidden targets \\[SDL3::SDL3\\]"
    },
    {
      "id": "fw-link-genex",
      "what": "The core links SDL3 inside a generator expression",
      "file": "framework/CMakeLists.txt",
      "find": "set(_gyo_framework_targets gyo_tool_framework)\n",
      "replace": "set(_gyo_framework_targets gyo_tool_framework)\nset(_gyo_lib SDL3)\ntarget_link_libraries(gyo_tool_framework PRIVATE \"$<$<CONFIG:Debug>:${_gyo_lib}::${_gyo_lib}>\")\n",
      "target": "gyo_framework_tests",
      "expect_build_failure": true,
      "expect": "links 1 forbidden targets \\[\\$<\\$<CONFIG:Debug>:SDL3::SDL3>\\]"
    }
  ]
}
