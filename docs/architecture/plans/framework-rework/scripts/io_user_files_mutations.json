      "expect": "is NOT correct"
    },
    {
      "id": "io-within-no-resolve",
      "what": "Paths are never resolved through the OS, so links and the disk spelling are ignored",
      "file": "engine/io/src/fs/NativeFileSystem.cpp",
      "find": "        std::filesystem::path Resolved(const std::filesystem::path& absolute) {\n",
      "replace": "        std::filesystem::path Resolved(const std::filesystem::path& absolute) {\n            return absolute.lexically_normal();\n",
      "target": "engine_tests",
