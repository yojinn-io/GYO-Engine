      "expect": "is NOT correct"
    },
    {
      "id": "io-within-root-last-unresolved",
      "what": "The root's last name is kept as written, so a root that is a link contains nothing",
      "file": "engine/io/src/fs/NativeFileSystem.cpp",
      "find": "            return WithoutTrailingSeparator(Resolved(WithoutTrailingSeparator(Absolute(given))));",
      "replace": "            return CandidatePath(given);",
