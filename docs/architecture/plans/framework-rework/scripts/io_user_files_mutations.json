      "file": "engine/io/src/fs/NativeFileSystem.cpp",
      "find": "            const std::filesystem::path absolute = WithoutTrailingSeparator(Absolute(given));",
      "replace": "            const std::filesystem::path absolute = WithoutTrailingSeparator(Absolute(given).lexically_normal());",
      "target": "engine_tests",
      "cases": "*ProbeFileStamp*,*WriteFileAtomically*,*IsNativePathWithin*",
