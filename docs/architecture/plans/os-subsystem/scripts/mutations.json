    },
    {
      "id": "io-n2-write-mode",
      "what": "The native backend opens a file for a write mode",
      "file": "engine/io/src/fs/NativeFileSystem.cpp",
      "find": "        if (!IsReadOnly(mode)) return Base::Err(Unsupported(\"opening for writing\"));\n",
      "replace": "",
      "target": "engine_tests",
