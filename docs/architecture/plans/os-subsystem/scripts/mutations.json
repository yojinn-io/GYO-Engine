{
  "version": 1,
  "description": "Declared mutants of the os-subsystem plan. A mutant is killed only when its check fails with the expected message. Run with docs/architecture/plans/time-threads-trace/scripts/run_mutations.py --catalog docs/architecture/plans/os-subsystem/scripts/mutations.json.",
  "mutants": [
    {
      "id": "os-g1-header",
      "what": "An Engine module outside engine/os includes a POSIX header (R1)",
      "file": "engine/trace/src/TraceSink.cpp",
      "find": "#include \"engine/trace/TraceSink.hpp\"\n",
      "replace": "#include \"engine/trace/TraceSink.hpp\"\n#include <unistd.h>\n",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "engine/trace/src/TraceSink\\.cpp:\\d+: R1 unistd\\.h"
    },
    {
      "id": "os-g2-macro",
      "what": "An Engine module outside engine/os branches on _WIN32 (R2)",
      "file": "engine/asset/src/AssetCatalog.cpp",
      "find": "namespace Engine::Asset {\n",
      "replace": "#if defined(_WIN32)\n#endif\nnamespace Engine::Asset {\n",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "engine/asset/src/AssetCatalog\\.cpp:\\d+: R2 _WIN32"
    },
    {
      "id": "os-g3-api",
      "what": "An Engine module outside engine/os calls localtime_r (R3)",
      "file": "engine/time/src/LateWakeStats.cpp",
      "find": "namespace Engine::Time {\n",
      "replace": "namespace Engine::Time {\nvoid LocalTimeProbe(const long* t, void* out) { localtime_r(t, out); }\n",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "engine/time/src/LateWakeStats\\.cpp:\\d+: R3 localtime_r"
    },
    {
      "id": "os-g4-io-opens",
      "what": "engine/io opens a file itself instead of calling engine/os (R4, D41)",
      "file": "engine/io/src/fs/Vfs.cpp",
      "find": "namespace Engine::IO::FS {\n",
      "replace": "namespace Engine::IO::FS {\nstatic std::ifstream probe;\n",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "engine/io/src/fs/Vfs\\.cpp:\\d+: R4 std::ifstream"
    },
    {
      "id": "os-g5-upward",
      "what": "engine/os includes a module above it (R5)",
      "file": "engine/os/src/common/OsError.cpp",
      "find": "#include \"engine/os/OsError.hpp\"\n",
      "replace": "#include \"engine/os/OsError.hpp\"\n#include \"engine/io/IoError.hpp\"\n",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "engine/os/src/common/OsError\\.cpp:\\d+: R5 engine/io/IoError\\.hpp"
    },
    {
      "id": "os-g6-stale",
      "what": "An allowlist entry stays larger after a site moved",
      "file": "tests/common/os/os_boundary_allowlist.txt",
      "find": "engine/trace/src/TraceSink.cpp R4 1 ",
      "replace": "engine/trace/src/TraceSink.cpp R4 2 ",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "TraceSink\\.cpp R4 has 1 findings, allowlisted 2; shrink the allowlist"
    },
    {
      "id": "os-g7-public-header",
      "what": "An engine/os public header includes windows.h (Invariant 4)",
      "file": "engine/os/include/engine/os/OsError.hpp",
      "find": "#include \"engine/base/Error.hpp\"\n",
      "replace": "#include \"engine/base/Error.hpp\"\n#include <windows.h>\n",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "engine/os/include/engine/os/OsError\\.hpp:\\d+: R1 windows\\.h"
    },
    {
      "id": "os-g8-link",
      "what": "gyo_os links a module above it (Invariant 3, configure-time check)",
      "file": "engine/os/CMakeLists.txt",
      "find": "target_link_libraries(gyo_os PUBLIC GYO::Base)",
      "replace": "target_link_libraries(gyo_os PUBLIC GYO::Base GYO::Time)",
      "target": "gyo_os_tests",
      "expect_build_failure": true,
      "expect": "gyo_os links .*expected exactly GYO::Base"
    },
    {
      "id": "os-g9-macro-list",
      "what": "The guard forgets __linux__ in its macro list",
      "file": "tests/common/os/os_boundary_guard.py",
      "find": "\"__linux__\", ",
      "replace": "",
      "command": [
        "{python}",
        "-m",
        "unittest",
        "discover",
        "-s",
        "tests/common/os",
        "-p",
        "test_*.py"
      ],
      "expect": "FAIL: test_linux_branch_is_reported"
    },
    {
      "id": "os-g10-filesystem-op",
      "what": "Runtime code asks the file system through std::filesystem (R4)",
      "file": "engine/asset/src/AssetCatalog.cpp",
      "find": "namespace Engine::Asset {\n",
      "replace": "namespace Engine::Asset {\nstatic const bool probe = std::filesystem::is_regular_file(\"x\");\n",
      "command": [
        "{python}",
        "tests/common/os/os_boundary_guard.py",
        "--root",
        "."
      ],
      "expect": "engine/asset/src/AssetCatalog\\.cpp:\\d+: R4 std::filesystem::is_regular_file"
    },
    {
      "id": "os-e1-detail",
      "what": "The native error detail drops its fixed domain prefix",
      "file": "engine/os/src/common/OsError.cpp",
      "find": "? \"win32=\" : \"errno=\"",
      "replace": "? \"\" : \"errno=\"",
      "target": "gyo_os_tests",
      "cases": "*fixed form*",
      "expect": "CHECK\\( NativeErrorDetail\\(\\{NativeErrorDomain::Win32, 3\\}\\) == \"win32=3\" \\) is NOT correct"
    },
    {
      "id": "io-m1-root",
      "what": "A file URI path loses its leading '/' (the pre-io-contracts behaviour)",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "        return NormalizeFilePath(native);\n",
      "replace": "        return NormalizeFilePath(native.substr(1));\n",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "ParseUri failed for file:///Users/x"
    },
    {
      "id": "io-m2-drive-case",
      "what": "Only an upper-case drive letter is recognized",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "return (c >= 'A' && c <= 'Z') || (c >= 'a' && c <= 'z');",
      "replace": "return (c >= 'A' && c <= 'Z');",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "CHECK\\( FilePath\\(\"file:///c:/game\"\\) == \"c:/game\" \\) is NOT correct"
    },
    {
      "id": "io-m3-to-string",
      "what": "ToString prints a drive path in the old file://C:/ form",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "            if (path.Empty() || path.Str().front() != '/') out += \"/\";\n",
      "replace": "",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "CHECK\\( uri.value\\(\\).ToString\\(\\) == text \\) is NOT correct"
    },
    {
      "id": "io-m4-localhost-case",
      "what": "The localhost authority is matched case-sensitively",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "authority.empty() || ToLower(authority) == \"localhost\"",
      "replace": "authority.empty() || authority == \"localhost\"",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "ParseUri failed for file://LOCALHOST/C:/x"
    },
    {
      "id": "io-m5-long-prefix",
      "what": "A long-path prefix is accepted into an engine/io path",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "        if (HasNamespacePrefix(path)) {\n",
      "replace": "        if (false) {\n",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "CHECK\\( NativeError\\(\"\\\\\\\\\\\\\\\\\\?\\\\\\\\C:\\\\\\\\x\"\\) == IoErrorCode::InvalidPath \\) is NOT correct"
    },
    {
      "id": "io-m6-loose-fallback",
      "what": "The loose parser keeps the file scheme for a file URI that ParseUri rejects",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "            // A file URI that ParseUri rejects is no file URI here either: it keeps no scheme, so it\n",
      "replace": "            u.scheme = UriScheme::File;\n",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "CHECK\\( uri.scheme != Path::UriScheme::File \\) is NOT correct"
    },
    {
      "id": "io-m7-mount-escape",
      "what": "A mount request with a '..' segment resolves outside the mount root",
      "file": "engine/io/include/engine/io/fs/MountTable.hpp",
      "find": "            if (Engine::IO::Path::ContainsTraversal(rel)) {",
      "replace": "            if (false) {",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "REQUIRE_FALSE\\( resolved \\) is NOT correct"
    },
    {
      "id": "io-m8-four-slash-unc",
      "what": "file:////server/share is taken for a local path",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "        // \"file:////server/share\" is the other spelling of a UNC URI.\n        if (path.starts_with(\"//\")) {",
      "replace": "        // \"file:////server/share\" is the other spelling of a UNC URI.\n        if (false) {",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "ParseUri accepted file:////server/share/x"
    },
    {
      "id": "io-m9-hand-made",
      "what": "NativePathFromFileUri accepts a path that does not normalize to itself",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "        if (normalized.value() != uri.path.Str()) {",
      "replace": "        if (false) {",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "NativePathFromFileUri accepted /a/\\.\\./b"
    },
    {
      "id": "io-m10-posix-drive",
      "what": "A POSIX path whose first segment looks like a drive gets a file URI",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "        if (root == \"/\" && StartsWithDrive(std::string_view(out).substr(1))) {",
      "replace": "        if (false) {",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "FileUriFromNativePath accepted /C:/x"
    },
    {
      "id": "io-m11-drive-relative",
      "what": "The drive-relative native forms C: and \\x are taken for absolute paths",
      "file": "engine/io/src/path/Uri.cpp",
      "find": "        if (utf8AbsolutePath.starts_with('\\\\') || (path.size() == 2 && IsDriveLetter(path))) {",
      "replace": "        if (false) {",
      "target": "engine_tests",
      "cases": "Uri:*",
      "expect": "FileUriFromNativePath accepted (C:|\\\\x)"
    },
    {
      "id": "os-f1-posix-notfound",
      "what": "A missing file (ENOENT) is no longer NotFound on POSIX",
      "platforms": [
        "darwin",
        "linux"
      ],
      "file": "engine/os/src/posix/Files.cpp",
      "find": "    case ENOENT:\n    case ENOTDIR:\n        return OsErrorCode::NotFound;",
      "replace": "    case ENOTDIR:\n        return OsErrorCode::NotFound;",
      "target": "gyo_os_tests",
      "cases": "*NotFound*",
      "expect": "CHECK\\( file.error\\(\\).code == OsErrorCode::NotFound \\) is NOT correct"
    },
    {
      "id": "os-f2-utf8",
      "what": "Invalid UTF-8 reaches the OS instead of being refused",
      "file": "engine/os/src/common/Paths.cpp",
      "find": "    if (!IsValidUtf8(utf8Path)) {",
      "replace": "    if (false) {",
      "target": "gyo_os_tests",
      "cases": "*invalid arguments*",
      "expect": "CHECK\\( OpenError\\(invalid\\) == OsErrorCode::InvalidEncoding \\) is NOT correct"
    },
    {
      "id": "os-f3-posix-directory",
      "what": "A directory opens as a file on POSIX",
      "platforms": [
        "darwin",
        "linux"
      ],
      "file": "engine/os/src/posix/Files.cpp",
      "find": "    if (S_ISDIR(status.st_mode)) return Base::Err(FromErrno(EISDIR, \"not a regular file\", utf8Path));\n",
      "replace": "",
      "target": "gyo_os_tests",
      "cases": "*directory*",
      "expect": "ReadFile::Open accepted"
    },
    {
      "id": "os-f4-windows-acp",
      "what": "Windows converts paths with the ANSI code page instead of UTF-8",
      "platforms": [
        "win32"
      ],
      "file": "engine/os/src/windows/Files.cpp",
      "find": "::MultiByteToWideChar(CP_UTF8, MB_ERR_INVALID_CHARS, utf8Path.data(), bytes, nullptr, 0)",
      "replace": "::MultiByteToWideChar(CP_ACP, 0, utf8Path.data(), bytes, nullptr, 0)",
      "target": "gyo_os_tests",
      "cases": "*ANSI code page*",
      "expect": "cannot open"
    },
    {
      "id": "os-f5-windows-notfound",
      "what": "ERROR_FILE_NOT_FOUND is no longer NotFound on Windows",
      "platforms": [
        "win32"
      ],
      "file": "engine/os/src/windows/Files.cpp",
      "find": "    case ERROR_FILE_NOT_FOUND:\n",
      "replace": "",
      "target": "gyo_os_tests",
      "cases": "*NotFound*",
      "expect": "CHECK\\( file.error\\(\\).code == OsErrorCode::NotFound \\) is NOT correct"
    },
    {
      "id": "io-n1-caps",
      "what": "The native backend keeps the default canOpenWrite = true",
      "file": "engine/io/src/fs/NativeFileSystem.cpp",
