    },
    {
      "id": "io-n3-cause",
      "what": "An engine/os failure loses its code name and native detail",
      "file": "engine/io/src/fs/NativeFileSystem.cpp",
      "find": "Base::CauseDetail(error, nativePath));",
      "replace": "std::string(nativePath));",
      "target": "engine_tests",
      "cases": "NativeFileSystem*",
      "expect": "CHECK\\( opened.error\\(\\).detail.starts_with\\(expectedStart\\) \\) is NOT correct"
    },
    {
      "id": "io-n4-notfound",
      "what": "An engine/os NotFound becomes OpenFailed, so a VFS overlay stops instead of trying the next mount",
      "file": "engine/io/src/fs/NativeFileSystem.cpp",
      "find": "            case Os::OsErrorCode::NotFound:        return IoErrorCode::NotFound;",
      "replace": "            case Os::OsErrorCode::NotFound:        return otherwise;",
      "target": "engine_tests",
      "cases": "NativeFileSystem*",
      "expect": "CHECK\\( opened.error\\(\\).code == IoErrorCode::NotFound \\) is NOT correct"
    }
  ]
}
