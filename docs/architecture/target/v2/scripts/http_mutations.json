{
 "version": 1,
 "description": "Declared mutants of engine/core/os StreamSocket and the http Module (the PvP Gateway port's declaration D8, games/object_fps_pvp/docs/gateway-declaration.zh-Hant.md, section 5). A mutant is killed only when the named test case fails with the expected message. Run: python3 tests/common/mutation/run_mutations.py --build-dir build/target/_build/test --catalog docs/architecture/target/v2/scripts/http_mutations.json",
 "mutants": [
  {
   "id": "os-stream-failure-unseen",
   "what": "a failed connect is reported as connected",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/core/os/src/sys/StreamSocket.cpp",
   "find": "    if (error != 0) {\n        impl_->failed = ConnectError(error);",
   "replace": "    if (false) {\n        impl_->failed = ConnectError(error);",
   "target": "gyo_os_tests",
   "cases": "stream socket:*",
   "expect": "closed port succeeded",
   "platforms": [
    "darwin",
    "linux"
   ]
  },
  {
   "id": "os-stream-close-unseen",
   "what": "the peer's close is not reported as 0 bytes",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/core/os/src/sys/StreamSocket.cpp",
   "find": "        if (received >= 0) return std::optional<std::size_t>(static_cast<std::size_t>(received));",
   "replace": "        if (received > 0) return std::optional<std::size_t>(static_cast<std::size_t>(received));",
   "target": "gyo_os_tests",
   "cases": "stream socket:*",
   "expect": "peer",
   "platforms": [
    "darwin",
    "linux"
   ]
  },
  {
   "id": "http-length-ignored",
   "what": "an answer with a length is read until the close",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/modules/http/src/Http.cpp",
   "find": "        stage_ = size == 0 ? Stage::Done : Stage::Sized;",
   "replace": "        stage_ = size == 0 ? Stage::Done : Stage::UntilClose;",
   "target": "gyo_http_tests",
   "cases": "http:*",
   "expect": "an answer with a length|a call sends"
  },
  {
   "id": "http-chunk-size-decimal",
   "what": "a chunk size is read as decimal",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/modules/http/src/Http.cpp",
   "find": "line.data() + line.size(), size, 16);",
   "replace": "line.data() + line.size(), size, 10);",
   "target": "gyo_http_tests",
   "cases": "http:*",
   "expect": "a chunked answer"
  },
  {
   "id": "http-truncation-unseen",
   "what": "a body cut short by the close is taken",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/modules/http/src/Http.cpp",
   "find": "    return Base::Err(Fail(HttpFailureCode::Truncated, \"the connection closed before the answer was complete\"));",
   "replace": "    return {};",
   "target": "gyo_http_tests",
   "cases": "http:*",
   "expect": "Truncated"
  },
  {
   "id": "http-body-limit-ignored",
   "what": "a body past the limit is taken",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/modules/http/src/Http.cpp",
   "find": "        if (size > limits_.body) return Base::Err(Fail(HttpFailureCode::TooLarge, \"the body is larger than the limit\"));\n        remaining_ = size;",
   "replace": "        remaining_ = size;",
   "target": "gyo_http_tests",
   "cases": "http:*",
   "expect": "past the limit"
  },
  {
   "id": "http-interim-taken",
   "what": "an interim answer is taken as the answer",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/modules/http/src/Http.cpp",
   "find": "    if (status < 200) {",
   "replace": "    if (false) {",
   "target": "gyo_http_tests",
   "cases": "http:*",
   "expect": "interim"
  },
  {
   "id": "http-empty-post-unsized",
   "what": "an empty POST is sent without Content-Length",
   "guards": [
    "gateway-declaration 5 (segment 3)"
   ],
   "file": "engine/modules/http/src/Http.cpp",
   "find": "    if (sendsBody) out +=",
   "replace": "    if (!request.body.empty()) out +=",
   "target": "gyo_http_tests",
   "cases": "http:*",
   "expect": "an empty POST says 0"
  }
 ]
}
