   "guards": [
    "render RD-1",
    "render section 2"
   ],
   "file": "engine/modules/render/src/Render.cpp",
   "find": "    const float sy = -2.0F / view.height;",
   "replace": "    const float sy = 2.0F / view.height;",
   "target": "gyo_render_tests",
   "cases": "render: the view*",
   "expect": "\\[rd\\-clip\\-bottom\\-right\\]"
  },
  {
   "id": "rd-clip-origin-ignored",
