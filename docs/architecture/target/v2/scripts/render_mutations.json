{
 "version": 1,
 "description": "Declared mutants of the render Module, render_world and sdl_gpu (batch R2a, v8-arch-gyo2-sdl-r2a; Design Invariants RD-1 to RD-4 in docs/architecture/target/v2/render.zh-Hant.md, SDL-4, SDL-5 and section 7 in sdl.zh-Hant.md; ids rd-, rw-, sg-, gp-). The gp- mutants need a GPU (label gpu: a machine with one, or Lavapipe). A mutant is killed only when the named test case fails with the expected message.",
 "mutants": [
  {
   "id": "rd-clip-y-not-turned",
   "what": "ViewToClip keeps y down (no turn)",
   "guards": [
    "render RD-1",
    "render section 2"
   ],
   "file": "engine/modules/render/src/Render.cpp",
   "find": "    const float sy = -2.0F / view.height;",
   "replace": "    const float sy = 2.0F / view.height;",
   "target": "gyo_render_tests",
   "cases": "render: the view*",
   "expect": "\\[rd\\-clip\\-bottom\\-right\\]"
  },
  {
   "id": "rd-clip-origin-ignored",
   "what": "ViewToClip forgets the view origin",
   "guards": [
    "render section 2"
   ],
   "file": "engine/modules/render/src/Render.cpp",
   "find": "return ViewTransform{{sx, sy}, {-1.0F - view.x * sx, 1.0F - view.y * sy}};",
   "replace": "return ViewTransform{{sx, sy}, {-1.0F, 1.0F}};",
   "target": "gyo_render_tests",
   "cases": "render: the view*",
   "expect": "\\[rd\\-clip\\-origin\\]"
  },
  {
