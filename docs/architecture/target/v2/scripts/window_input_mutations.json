   "find": "        if (found == pressed_.end()) return;",
   "replace": "        if (found == pressed_.end()) {\n            justReleased_.push_back(button);\n            return;\n        }",
   "target": "gyo_input_tests",
   "cases": "input: a repeat*",
   "expect": "\\[in\\-unheld\\-release\\]"
  },
  {
