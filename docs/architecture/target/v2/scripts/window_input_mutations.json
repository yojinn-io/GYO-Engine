{
 "version": 1,
 "description": "Declared mutants of the input and window Modules, window_camera, the sdl library's clock pairing and sdl_window (batch W, v8-arch-gyo2-sdl-w; Design Invariants IN-1 to IN-5 in docs/architecture/target/v2/input.zh-Hant.md, WN-1 to WN-4 in window.zh-Hant.md, SDL-3 and SDL-7 in sdl.zh-Hant.md; ids in-, wn-, wc-, sc-, sw-). A mutant is killed only when the named test case fails with the expected message.",
 "mutants": [
  {
   "id": "in-repeat-press",
   "what": "a press of a held key (a repeat) is a new press",
   "guards": [
    "input IN-3"
   ],
   "file": "engine/modules/input/include/engine/input/Input.hpp",
   "find": "        if (Contains(pressed_, button)) return;\n        pressed_.push_back(button);",
   "replace": "        pressed_.push_back(button);",
   "target": "gyo_input_tests",
   "cases": "input: a repeat*",
   "expect": "\\[in\\-repeat\\-not\\-press\\]"
  },
  {
   "id": "in-unheld-release",
   "what": "the release of a key not held counts as a release",
   "guards": [
