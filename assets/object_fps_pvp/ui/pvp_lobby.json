{
  "schema": "gyo.ui", "version": 2,
  "design_canvas": {"size": [1280, 720], "scale_mode": "fit"},
  "fonts": {"ui": "object_fps_pvp.font.ui"}, "default_font": "ui",
  "colors": {
    "backdrop": "#101724FF", "panel": "#1D2A3AFF", "accent": "#66D9EFFF",
    "text": "#EAF1FAFF", "muted": "#A3B7CBFF", "button": "#2B4159FF",
    "focused": "#285F84FF", "pressed": "#307EA2FF"
  },
  "actions": [
    {"id": "pvp.submit_address", "payload": "string"},
    {"id": "pvp.quit", "payload": "none"}
  ],
  "bindings": [
    {"id": "address", "type": "string", "preview": "127.0.0.1:40000"},
    {"id": "status", "type": "string", "preview": "Match のアドレスを入力してください"},
    {"id": "hint", "type": "string", "preview": "クリックして入力、Enter で接続"}
  ],
  "canvases": [{
    "id": "lobby", "backdrop_color": "backdrop", "default_focus": "address",
    "focus_order": ["address", "quit"],
    "children": [
      {"type": "panel", "id": "panel", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [180, 64], "size_delta": [920, 592]}, "color": {"color": "panel"}},
      {"type": "text", "id": "title", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [220, 88], "size_delta": [840, 56]}, "text": {"literal": "OBJECT FPS / PVP"}, "point_size": 36, "text_color": {"color": "accent"}, "vertical_align": "center"},
      {"type": "text", "id": "subtitle", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [220, 148], "size_delta": [840, 36]}, "text": {"literal": "LAN 対戦  /  最大 4 人"}, "point_size": 20, "text_color": {"color": "muted"}, "vertical_align": "center"},
      {"type": "text", "id": "address_label", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [220, 204], "size_delta": [840, 26]}, "text": {"literal": "MATCH のアドレス（A.B.C.D:ポート）"}, "point_size": 16, "text_color": {"color": "muted"}},
      {"type": "text_field", "id": "address", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [220, 238], "size_delta": [840, 48]}, "binding": "address", "max_length": 64, "placeholder": "A.B.C.D:40000", "placeholder_color": "muted", "point_size": 23, "text_color": {"color": "text"}, "horizontal_align": "center", "vertical_align": "center", "action": "pvp.submit_address", "background": {"normal": "button", "focused": "focused", "pressed": "pressed"}},
      {"type": "text", "id": "hint", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [220, 294], "size_delta": [840, 30]}, "text": {"binding": "hint"}, "point_size": 15, "text_color": {"color": "muted"}},
      {"type": "text", "id": "status", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [220, 360], "size_delta": [840, 60]}, "text": {"binding": "status"}, "point_size": 18, "text_color": {"color": "accent"}},
      {"type": "button", "id": "quit", "rect": {"anchor_min": [0, 0], "anchor_max": [0, 0], "pivot": [0, 0], "position": [800, 562], "size_delta": [260, 48]}, "text": {"literal": "戻る"}, "point_size": 20, "text_color": {"color": "text"}, "horizontal_align": "center", "vertical_align": "center", "action": "pvp.quit", "background": {"normal": "button", "focused": "focused", "pressed": "pressed"}}
    ]
  }]
}
